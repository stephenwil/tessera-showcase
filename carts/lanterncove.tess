__lua__
-- Lantern Cove (v2 Polished)
-- A cozy 3D voxel twilight harbor game built via @stephenwil/tessera-mcp.
-- Pilot your lantern-lit tugboat, tether drifting paper lanterns, and guide
-- glowing convoys back to the Harbor Beacon Pier before the festival ends.

local WATER_Z = 6
local GAME_DURATION = 90
local MAX_CHAIN = 6
local CAM_YAW = 0.68
local PIER_X, PIER_Y = 129, 126
local PIER_R = 19
local LH_X, LH_Y, LH_BASE_Z = 82, 162, 17
local LH_LIGHT_Z = LH_BASE_Z + 22

-- Game state
local mode = "title" -- "title" | "play" | "gameover"
local time_left = GAME_DURATION
local score = 0
local best_score = 0
local delivered_total = 0
local best_chain = 0
local deliver_flash = 0
local screen_shake = 0
local cam_mode = 0 -- 0 = scenic cove follow, 1 = wide harbor overview

-- Tugboat state
local boat = {
  x = 126,
  y = 104,
  vx = 0,
  vy = 0,
  ang = math.pi * 0.5,
  rot = 0,
  boost = 0,
  boost_cd = 0,
  bump_cd = 0,
  trail = {},
  steam_t = 0
}

-- Entities
local lanterns = {}
local popups = {}
local sparks = {}
local buoys = {}
local fireflies = {}
local rocks = {
  { x = 94,  y = 98,  r = 9.0,  h = 12, pine = true },
  { x = 175, y = 122, r = 10.0, h = 13, pine = false },
  { x = 158, y = 82,  r = 7.2,  h = 10, pine = false }
}

local LANTERN_TYPES = {
  { name = "GOLD",  pts = 100, c1 = 33, c2 = 34, c3 = 35, c4 = 36, swap = false },
  { name = "LOTUS", pts = 150, c1 = 37, c2 = 37, c3 = 38, c4 = 36, swap = true },
  { name = "CYAN",  pts = 250, c1 = 39, c2 = 39, c3 = 40, c4 = 36, swap = true }
}

local CHAIN_MULT = { 1.0, 1.5, 2.0, 2.5, 3.0, 4.0 }

-- Utility helpers
local function dist2(x1, y1, x2, y2)
  local dx, dy = x2 - x1, y2 - y1
  return dx * dx + dy * dy
end

local function add_popup(x, y, z, text, col)
  popups[#popups + 1] = {
    x = x, y = y, z = z,
    text = text,
    col = col or 35,
    life = 1.6,
    max_life = 1.6
  }
end

local function emit_sparks(x, y, z, count, col1, col2)
  for i = 1, count do
    local a = rnd(math.pi * 2)
    local spd = 8 + rnd(18)
    sparks[#sparks + 1] = {
      x = x, y = y, z = z,
      vx = math.cos(a) * spd,
      vy = math.sin(a) * spd,
      vz = 10 + rnd(18),
      col = (i % 2 == 0) and col1 or (col2 or col1),
      life = 0.45 + rnd(0.45)
    }
  end
end

-- Check if a (x, y) point is navigable cove water
local function is_open_water(x, y, margin)
  margin = margin or 5
  if x < 54 or x > 202 or y < 56 or y > 192 then return false end
  local ex = (x - 132) / 74
  local ey = (y - 116) / 62
  if ex * ex + ey * ey > 1.0 then return false end
  if y > 142 and x < 108 then return false end
  if y > 149 then return false end
  -- Keep clear of pier pilings & T-head
  if x >= 112 - margin and x <= 146 + margin and y >= 136 - margin and y <= 176 then
    return false
  end
  -- Keep clear of rocky sea-stacks
  for i = 1, #rocks do
    local rk = rocks[i]
    local rr = rk.r + margin
    if dist2(x, y, rk.x, rk.y) < rr * rr then
      return false
    end
  end
  return true
end

local function spawn_lantern(avoid_boat)
  local sx, sy = 128, 92
  for tries = 1, 50 do
    local cx = 68 + rnd(124)
    local cy = 66 + rnd(74)
    if is_open_water(cx, cy, 7) then
      local ok = dist2(cx, cy, PIER_X, PIER_Y) > 24 * 24
      if ok and avoid_boat then
        ok = dist2(cx, cy, boat.x, boat.y) > 24 * 24
      end
      if ok then
        for j = 1, #lanterns do
          local o = lanterns[j]
          if o.state == "free" and dist2(cx, cy, o.x, o.y) < 15 * 15 then
            ok = false
            break
          end
        end
      end
      if ok then
        sx, sy = cx, cy
        break
      end
    end
  end

  local roll = rnd()
  local kind = 1
  if roll > 0.85 then
    kind = 3
  elseif roll > 0.60 then
    kind = 2
  end

  lanterns[#lanterns + 1] = {
    x = sx,
    y = sy,
    vx = (rnd() - 0.5) * 3.0,
    vy = (rnd() - 0.5) * 3.0,
    phase = rnd(6.28),
    kind = kind,
    state = "free", -- "free" | "tethered" | "delivering"
    chain_idx = 0,
    deliver_t = 0,
    start_x = sx,
    start_y = sy
  }
end

local function count_tethered()
  local n = 0
  for i = 1, #lanterns do
    if lanterns[i].state == "tethered" then n = n + 1 end
  end
  return n
end

-- Build the persistent 3D voxel twilight harbor (edge-to-edge water & sculpted headland)
local function build_harbor()
  mclear()

  -- 1. Full-bleed twilight ocean volume (0..255) so no empty cutaway slab is ever visible!
  mbox(0, 0, 0, 255, 255, WATER_Z - 1, 5)
  mbox(0, 0, WATER_Z, 255, 255, WATER_Z, 5)

  -- Rich cove water bathymetry contours (indigo -> mid teal -> shallow turquoise)
  for x = 16, 240, 2 do
    for y = 16, 240, 2 do
      local d_center = math.sqrt(((x - 130) / 76)^2 + ((y - 114) / 64)^2)
      local n = noise3(x * 0.04, y * 0.04, 1.2)
      if d_center > 0.78 + n * 0.08 and d_center < 1.22 then
        mbox(x, y, WATER_Z, x + 1, y + 1, WATER_Z, 7)
      elseif d_center > 0.45 + n * 0.08 and d_center < 1.38 then
        mbox(x, y, WATER_Z, x + 1, y + 1, WATER_Z, 6)
      end
    end
  end

  -- 2. Horseshoe Rocky Cliffs extending smoothly past the viewport edges
  for x = 10, 246, 2 do
    for y = 26, 246, 2 do
      local n1 = noise3(x * 0.032, y * 0.032, 0.5)
      local n2 = noise3(x * 0.08, y * 0.08, 3.7)

      local ex = (x - 132) / 78
      local ey = (y - 112) / 60
      local cove_d = math.sqrt(ex * ex + ey * ey) + n1 * 0.14

      -- Open southern ocean mouth
      local is_south_mouth = (y < 82 and x > 68 and x < 200)
      local is_outer_sea = (y < 48)

      -- Lighthouse rocky promontory around (LH_X, LH_Y)
      local lh_d = math.sqrt((x - LH_X)^2 + (y - LH_Y)^2)
      local is_lh_headland = lh_d < 22 + n2 * 3.2

      local is_north_shore = (y > 152 + n1 * 7)

      local height = 0
      if is_lh_headland then
        local t_lh = mid(0, 1 - lh_d / 23, 1)
        height = WATER_Z + flr(4 + t_lh * 9 + n2 * 1.5)
        if lh_d < 9.5 then height = LH_BASE_Z - 1 end
      elseif not is_outer_sea and ((cove_d > 1.0 and not is_south_mouth) or is_north_shore) then
        local rim = math.max(cove_d - 1.0, (y - 150) / 38)
        if rim > 0 then
          height = WATER_Z + flr(3 + rim * 22 + n2 * 4.5)
          height = mid(WATER_Z + 2, height, 28)
          -- Cottage garden plateau
          if x >= 145 and x <= 184 and y >= 162 and y <= 194 then
            height = 13
          end
          -- Cobblestone harbor quay apron behind pier
          if x >= 110 and x <= 146 and y >= 149 and y <= 174 then
            height = 10
          end
        end
      end

      if height > WATER_Z then
        -- Shallow turquoise & seafoam waterline collar
        mbox(x - 1, y - 1, WATER_Z, x + 2, y + 2, WATER_Z, 7)
        if cove_d < 1.12 or (y <= 156 and y >= 146) then
          if (x + y) % 4 == 0 then
            mset(x, y - 1, WATER_Z, 9)
          end
        end
        -- Layered basalt & granite cliff column
        mbox(x, y, WATER_Z + 1, x + 1, y + 1, math.min(height, WATER_Z + 3), 11)
        if height > WATER_Z + 3 then
          mbox(x, y, WATER_Z + 4, x + 1, y + 1, height - 1, (n2 > 0.08) and 13 or 12)
        end
        -- Mossy grassy cliff cap (or warm cobblestone on quay!)
        local cap = 15
        if x >= 110 and x <= 146 and y >= 149 and y <= 174 and height == 10 then
          -- Warm textured cobblestone harborfront promenade!
          local chk = (flr(x / 2) + flr(y / 2)) % 3
          cap = (chk == 0) and 47 or ((chk == 1) and 13 or 48)
        elseif height >= 16 then
          cap = (n2 > 0.14) and 18 or 17
        elseif height >= 11 then
          cap = (n2 > -0.05) and 16 or 15
        else
          cap = 13
        end
        mbox(x, y, height, x + 1, y + 1, height, cap)
      end
    end
  end

  -- 3. Harborfront Stone Seawall, Cedar Steps & Boathouse Stall (eliminating bare gray pad!)
  -- Low stone parapet along quay edge
  mbox(110, 149, 10, 121, 150, 11, 14)
  mbox(137, 149, 10, 146, 150, 11, 14)
  -- Warm cedar walkway runner across cobblestones from pier to cottage steps
  for x = 124, 146 do
    local c = (x % 2 == 0) and 21 or 20
    mbox(x, 156, 10, x, 161, 10, c)
  end
  -- Cedar staircase climbing from quay (z=10) to cottage garden (z=13)
  mbox(144, 158, 11, 146, 163, 11, 21)
  mbox(146, 159, 12, 148, 164, 12, 22)
  mbox(148, 160, 13, 150, 165, 13, 21)

  -- Cozy Lantern-Maker's Boathouse / Stall on West Quay (x=111..120, y=157..167, z=11..18)
  mbox(111, 157, 11, 120, 167, 15, 20)
  mbox(112, 158, 11, 119, 166, 15, 21)
  -- Open warm glowing market counter facing the pier (x=120)
  mbox(120, 159, 12, 120, 165, 14, 34)
  mbox(120, 160, 13, 120, 164, 13, 36)
  -- Red & cream striped awning roof!
  for ax = 0, 9 do
    local col = (ax % 2 == 0) and 25 or 28
    mbox(111 + ax, 156, 16 + flr((9 - ax) / 4), 111 + ax, 168, 16 + flr((9 - ax) / 4), col)
  end
  -- Tiny glowing stone lantern & wooden benches along the quay
  mbox(139, 153, 11, 143, 154, 11, 22) -- harbor bench
  mbox(140, 167, 11, 142, 169, 13, 20) -- stacked barrels
  mset(141, 168, 14, 34) -- resting lantern on barrel!

  -- 4. Rocky Sea-Stacks inside the cove (with subtle seafoam skirts)
  for i = 1, #rocks do
    local rk = rocks[i]
    local rmax = flr(rk.r + 3)
    for dx = -rmax, rmax do
      for dy = -rmax, rmax do
        local d = math.sqrt(dx * dx + dy * dy)
        local n = noise3((rk.x + dx) * 0.14, (rk.y + dy) * 0.14, i * 2.1)
        local eff_r = rk.r + n * 2.0
        if d <= eff_r + 2.5 then
          local wc = (d <= eff_r + 1.1 and (dx + dy) % 2 == 0) and 9 or 7
          mset(flr(rk.x + dx), flr(rk.y + dy), WATER_Z, wc)
        end
        if d <= eff_r then
          local h = WATER_Z + flr(1 + (1 - d / eff_r) * rk.h + n * 1.5)
          for z = WATER_Z + 1, h do
            local col = 11
            if z == h and h > WATER_Z + 4 then
              col = (z > WATER_Z + 8) and 17 or 16
            elseif z > WATER_Z + 2 then
              col = ((dx + dy + z) % 3 == 0) and 13 or 12
            end
            mset(flr(rk.x + dx), flr(rk.y + dy), z, col)
          end
        end
      end
    end
    if rk.pine then
      mmodel("pine", flr(rk.x), flr(rk.y), WATER_Z + rk.h - 2, 0)
    end
  end

  -- 5. Lighthouse on the Headland
  for dx = -7, 7 do
    for dy = -7, 7 do
      if dx * dx + dy * dy <= 52 then
        mbox(LH_X + dx, LH_Y + dy, WATER_Z + 1, LH_X + dx, LH_Y + dy, LH_BASE_Z - 1, ((dx + dy) % 2 == 0) and 13 or 12)
      end
    end
  end
  mmodel("lighthouse", LH_X, LH_Y, LH_BASE_Z, 0)

  -- 6. Coastal Pine Groves framing the headland and cliff ridges
  local pines = {
    { 58, 148 }, { 52, 126 }, { 56, 100 }, { 64, 184 },
    { 98, 180 }, { 114, 186 }, { 184, 174 }, { 196, 156 },
    { 204, 136 }, { 202, 112 }, { 192, 188 }, { 74, 196 },
    { 132, 188 }, { 42, 162 }, { 186, 144 }, { 66, 134 },
    { 28, 152 }, { 36, 132 }, { 24, 174 }, { 48, 186 }, { 18, 138 }
  }
  for i = 1, #pines do
    local px, py = pines[i][1], pines[i][2]
    local hz = mheight(px, py)
    if hz > WATER_Z + 2 then
      mmodel("pine", px, py, hz, i % 4)
    end
  end

  -- 7. Cozy Harbormaster Cottage on the northern terrace
  local cx, cy, cz = 152, 168, 14
  mbox(cx, cy, cz - 2, cx + 18, cy + 12, cz, 12)
  mbox(cx + 1, cy + 1, cz + 1, cx + 17, cy + 11, cz + 8, 27)
  -- Timber corner posts
  mbox(cx + 1, cy + 1, cz + 1, cx + 2, cy + 2, cz + 8, 20)
  mbox(cx + 16, cy + 1, cz + 1, cx + 17, cy + 2, cz + 8, 20)
  mbox(cx + 1, cy + 10, cz + 1, cx + 2, cy + 11, cz + 8, 20)
  mbox(cx + 16, cy + 10, cz + 1, cx + 17, cy + 11, cz + 8, 20)
  -- Warm glowing windows facing the cove (south & west walls!)
  mbox(cx + 4, cy + 1, cz + 3, cx + 6, cy + 1, cz + 5, 35)
  mbox(cx + 5, cy + 1, cz + 4, cx + 5, cy + 1, cz + 4, 36)
  mbox(cx + 12, cy + 1, cz + 3, cx + 14, cy + 1, cz + 5, 35)
  mbox(cx + 13, cy + 1, cz + 4, cx + 13, cy + 1, cz + 4, 36)
  mbox(cx + 1, cy + 5, cz + 3, cx + 1, cy + 7, cz + 5, 35)
  -- Cedar door & warm porch lamp
  mbox(cx + 8, cy + 1, cz + 1, cx + 10, cy + 1, cz + 5, 20)
  mset(cx + 9, cy, cz + 6, 36)
  -- Sloped crimson gable roof
  for step = 0, 6 do
    mbox(cx, cy + step, cz + 9 + step, cx + 18, cy + 12 - step, cz + 9 + step, (step % 2 == 0) and 25 or 24)
  end
  -- Stone chimney
  mbox(cx + 13, cy + 7, cz + 10, cx + 15, cy + 9, cz + 18, 13)
  mbox(cx + 13, cy + 7, cz + 19, cx + 15, cy + 9, cz + 19, 14)

  -- 8. Harbor Beacon Pier (T-shaped cedar dock)
  local pilings = {
    { 122, 152 }, { 136, 152 }, { 122, 147 }, { 136, 147 },
    { 114, 145 }, { 124, 145 }, { 134, 145 }, { 144, 145 },
    { 114, 138 }, { 124, 138 }, { 134, 138 }, { 144, 138 }
  }
  for i = 1, #pilings do
    local px, py = pilings[i][1], pilings[i][2]
    mbox(px, py, WATER_Z - 2, px + 1, py + 1, WATER_Z + 4, 19)
    mset(px, py, WATER_Z + 5, 23)
  end

  for y = 146, 156 do
    local col = (y % 2 == 0) and 21 or 20
    mbox(122, y, WATER_Z + 2, 136, y, WATER_Z + 3, col)
  end
  for y = 137, 146 do
    local col = (y % 2 == 0) and 22 or 21
    mbox(113, y, WATER_Z + 2, 145, y, WATER_Z + 3, col)
  end
  -- Golden beacon brazier hearth at front center of T-pier
  mbox(124, 137, WATER_Z + 4, 134, 138, WATER_Z + 4, 23)
  mbox(126, 137, WATER_Z + 5, 132, 138, WATER_Z + 5, 34)
  mbox(128, 137, WATER_Z + 6, 130, 138, WATER_Z + 6, 36)

  -- Wooden crates & barrels on pier
  mbox(116, 142, WATER_Z + 4, 118, 144, WATER_Z + 6, 20)
  mbox(116, 142, WATER_Z + 6, 118, 144, WATER_Z + 6, 22)
  mbox(140, 142, WATER_Z + 4, 142, 144, WATER_Z + 6, 21)

  -- Glowing Beacon Lantern Posts along the pier & quay
  mmodel("beacon_post", 114, 138, WATER_Z + 4, 2)
  mmodel("beacon_post", 144, 138, WATER_Z + 4, 2)
  mmodel("beacon_post", 122, 149, WATER_Z + 4, 1)
  mmodel("beacon_post", 136, 149, WATER_Z + 4, 3)

  -- Draped golden festoon string lights between pier posts & quay!
  local function string_lights(x0, y0, z0, x1, y1, z1, sag, steps)
    for s = 1, steps - 1 do
      local u = s / steps
      local lx = flr(x0 + (x1 - x0) * u + 0.5)
      local ly = flr(y0 + (y1 - y0) * u + 0.5)
      local lz = flr(z0 + (z1 - z0) * u - math.sin(u * math.pi) * sag + 0.5)
      mset(lx, ly, lz, (s % 2 == 0) and 35 or 34)
    end
  end
  string_lights(114, 138, WATER_Z + 12, 144, 138, WATER_Z + 12, 2.5, 9)
  string_lights(122, 149, WATER_Z + 12, 120, 161, 18, 1.8, 7)
  string_lights(136, 149, WATER_Z + 12, 152, 169, 20, 2.2, 8)

  -- Warning lantern on East Sea-Stack
  mmodel("beacon_post", 175, 122, WATER_Z + 12, 0)

  -- 9. Outer Cove Channel Buoys
  buoys = {
    { x = 72,  y = 74 },
    { x = 104, y = 62 },
    { x = 136, y = 60 },
    { x = 168, y = 66 },
    { x = 194, y = 86 }
  }

  -- 10. Ambient twilight fireflies near the cliffs & pines
  fireflies = {}
  local ff_spots = {
    { 64, 152, 22 }, { 96, 174, 24 }, { 146, 166, 19 },
    { 176, 166, 22 }, { 190, 142, 20 }, { 94, 98, 22 },
    { 118, 160, 20 }, { 164, 176, 24 }
  }
  for i = 1, #ff_spots do
    fireflies[i] = {
      x = ff_spots[i][1], y = ff_spots[i][2], z = ff_spots[i][3],
      phase = i * 1.37
    }
  end
end

local function reset_game(start_mode)
  mode = start_mode or "play"
  time_left = GAME_DURATION
  score = 0
  delivered_total = 0
  best_chain = 0
  deliver_flash = 0
  screen_shake = 0

  boat.x = 126
  boat.y = 104
  boat.vx = 0
  boat.vy = 0
  boat.ang = math.pi * 0.5
  boat.rot = 0
  boat.boost = 0
  boat.boost_cd = 0
  boat.bump_cd = 0
  boat.trail = {}
  for i = 1, 70 do
    boat.trail[i] = { x = boat.x, y = boat.y - i * 0.35 }
  end

  lanterns = {}
  popups = {}
  sparks = {}

  -- Picturesque constellation of golden, lotus-pink, and sea-glass cyan lanterns
  local preset = {
    { 112, 118, 1 },
    { 144, 100, 1 }, -- right along the starboard sailing lane!
    { 156, 112, 2 }, -- lotus pink near east cove
    { 122, 82,  1 },
    { 84,  122, 3 }, -- rare cyan near lighthouse cove
    { 166, 102, 1 },
    { 106, 78,  2 },
    { 140, 74,  1 },
    { 182, 106, 3 }
  }
  for i = 1, #preset do
    local p = preset[i]
    lanterns[#lanterns + 1] = {
      x = p[1],
      y = p[2],
      vx = (rnd() - 0.5) * 2.2,
      vy = (rnd() - 0.5) * 2.2,
      phase = i * 0.85,
      kind = p[3],
      state = "free",
      chain_idx = 0,
      deliver_t = 0,
      start_x = p[1],
      start_y = p[2]
    }
  end

  if mode == "play" then
    sfx(4)
  end
end

function _init()
  quality("hq")
  best_score = dget(0)
  build_harbor()
  sky(1, 3)
  fog(2, 0.0012)
  -- Raking golden-twilight side sun for sculptural voxel shadow depth
  sun(-0.74, -0.34, 0.72, 0.86)
  camera(128, 124, 14, 1.34, CAM_YAW)
  music_vol(0.38)
  music(0, 600)
  reset_game("title")
end

-- Convert continuous world heading angle (atan(vy, vx)) to 4-way model rotation (0..3)
-- Note: tugboat.txt bow points +y (ang = +pi/2 -> rot = 0).
local function angle_to_rot(a)
  local rel = a - math.pi * 0.5
  local q = flr((rel / (math.pi * 0.5)) + 0.5) % 4
  return (4 - q) % 4
end

local function update_sparks_and_popups(dt)
  for i = #sparks, 1, -1 do
    local s = sparks[i]
    s.x = s.x + s.vx * dt
    s.y = s.y + s.vy * dt
    s.z = s.z + s.vz * dt
    s.vz = s.vz - 28 * dt
    s.life = s.life - dt
    if s.life <= 0 or s.z < WATER_Z then
      table.remove(sparks, i)
    end
  end
  for i = #popups, 1, -1 do
    local p = popups[i]
    p.z = p.z + 10 * dt
    p.life = p.life - dt
    if p.life <= 0 then
      table.remove(popups, i)
    end
  end
end

function _update()
  local dt = 1 / 30
  local now = t()

  deliver_flash = math.max(0, deliver_flash - dt * 1.4)
  screen_shake = math.max(0, screen_shake - dt * 2.5)
  update_sparks_and_popups(dt)

  -- Chimney smoke puff from harbormaster cottage!
  if flr(now * 30) % 14 == 0 then
    particle(166, 176, 35, 14, 1.1)
  end

  -- Camera view toggle (B / X / E)
  if btnp(5) and mode == "play" then
    cam_mode = 1 - cam_mode
    tone("triangle", 520, 680, 0.08, 0.12, 3)
  end

  if mode == "title" then
    boat.x = 126 + math.sin(now * 0.6) * 2.5
    boat.y = 104 + math.cos(now * 0.45) * 1.8
    boat.ang = math.pi * 0.5 + math.sin(now * 0.5) * 0.2
    boat.rot = 0

    for i = 1, #lanterns do
      local l = lanterns[i]
      l.x = l.x + math.cos(now * 0.35 + l.phase) * 1.2 * dt
      l.y = l.y + math.sin(now * 0.28 + l.phase) * 0.9 * dt
    end

    if btnp(4) or btn(0) or btn(1) or btn(2) or btn(3) or math.abs(axis(0)) > 0.25 or math.abs(axis(1)) > 0.25 then
      reset_game("play")
    end
    return
  end

  if mode == "gameover" then
    if btnp(4) then
      reset_game("play")
    elseif btnp(5) then
      reset_game("title")
    end
    return
  end

  -- Active Play Mode
  time_left = time_left - dt
  if time_left <= 0 then
    time_left = 0
    mode = "gameover"
    sfx(5)
    if score > best_score then
      best_score = score
      dset(0, best_score)
    end
    return
  end

  -- Exact screen-aligned steering calibrated to CAM_YAW = 0.68:
  -- Screen Right (+ix) => (+cos, -sin), Screen Up (+iy) => (+sin, +cos)
  local ix, iy = 0, 0
  if btn(0) then ix = ix - 1 end
  if btn(1) then ix = ix + 1 end
  if btn(2) then iy = iy + 1 end
  if btn(3) then iy = iy - 1 end

  local ax, ay = axis(0), axis(1)
  if math.abs(ax) > 0.15 then ix = ax end
  if math.abs(ay) > 0.15 then iy = ay end

  local wx, wy = 0, 0
  if ix ~= 0 or iy ~= 0 then
    local len = math.sqrt(ix * ix + iy * iy)
    ix, iy = ix / len, iy / len
    local c, s = math.cos(CAM_YAW), math.sin(CAM_YAW)
    wx = ix * c + iy * s
    wy = -ix * s + iy * c
  end

  -- Steam Boost (Space / Z / A)
  boat.boost_cd = math.max(0, boat.boost_cd - dt)
  boat.boost = math.max(0, boat.boost - dt)
  boat.bump_cd = math.max(0, boat.bump_cd - dt)

  if btnp(4) and boat.boost_cd <= 0 then
    boat.boost = 0.60
    boat.boost_cd = 2.4
    sfx(2)
    emit_sparks(boat.x, boat.y, WATER_Z + 10, 9, 28, 10)
  end

  local accel = (boat.boost > 0) and 130 or 80
  local max_spd = (boat.boost > 0) and 54 or 36

  boat.vx = boat.vx + wx * accel * dt
  boat.vy = boat.vy + wy * accel * dt

  local drag = math.exp(-2.4 * dt)
  boat.vx = boat.vx * drag
  boat.vy = boat.vy * drag

  local spd = math.sqrt(boat.vx * boat.vx + boat.vy * boat.vy)
  if spd > max_spd then
    boat.vx = boat.vx * (max_spd / spd)
    boat.vy = boat.vy * (max_spd / spd)
    spd = max_spd
  end

  -- Move & resolve cozy shoreline/rock collision
  local nx = boat.x + boat.vx * dt
  local ny = boat.y + boat.vy * dt
  if is_open_water(nx, ny, 4.5) then
    boat.x, boat.y = nx, ny
  else
    local moved = false
    if is_open_water(nx, boat.y, 4.5) then
      boat.x = nx
      boat.vy = -boat.vy * 0.45
      moved = true
    elseif is_open_water(boat.x, ny, 4.5) then
      boat.y = ny
      boat.vx = -boat.vx * 0.45
      moved = true
    else
      boat.vx = -boat.vx * 0.5
      boat.vy = -boat.vy * 0.5
    end

    if spd > 16 and boat.bump_cd <= 0 then
      boat.bump_cd = 0.65
      screen_shake = 0.35
      sfx(3)
      emit_sparks(boat.x, boat.y, WATER_Z + 2, 6, 10, 9)
      local tail_idx = 0
      local tail_l = nil
      for i = 1, #lanterns do
        local l = lanterns[i]
        if l.state == "tethered" and l.chain_idx > tail_idx then
          tail_idx = l.chain_idx
          tail_l = l
        end
      end
      if tail_l and not moved and spd > 28 then
        tail_l.state = "free"
        tail_l.chain_idx = 0
        tail_l.vx = (rnd() - 0.5) * 14
        tail_l.vy = (rnd() - 0.5) * 14
        add_popup(tail_l.x, tail_l.y, WATER_Z + 10, "SLIPPED!", 26)
      end
    end
  end

  if spd > 2.0 then
    boat.ang = math.atan(boat.vy, boat.vx)
    boat.rot = angle_to_rot(boat.ang)
  end

  -- Breadcrumb trail for smooth convoy trailing
  local head = boat.trail[1]
  if not head or dist2(boat.x, boat.y, head.x, head.y) > 1.1 * 1.1 then
    table.insert(boat.trail, 1, { x = boat.x, y = boat.y })
    if #boat.trail > 90 then
      table.remove(boat.trail)
    end
  end

  -- Smokestack steam & foam wake particles
  boat.steam_t = boat.steam_t + dt * (boat.boost > 0 and 3.5 or 1.2)
  if boat.steam_t > 0.18 then
    boat.steam_t = 0
    particle(boat.x, boat.y, WATER_Z + 11, 28, 0.75)
    if spd > 4 then
      local bx = boat.x - math.cos(boat.ang) * 6
      local by = boat.y - math.sin(boat.ang) * 6
      particle(bx + (rnd() - 0.5) * 3, by + (rnd() - 0.5) * 3, WATER_Z + 1, 10, 0.6)
    end
  end

  -- Update lanterns
  local tethered_count = count_tethered()

  for i = #lanterns, 1, -1 do
    local l = lanterns[i]
    if l.state == "free" then
      local cur_x = math.sin(now * 0.4 + l.y * 0.03) * 2.0
      local cur_y = math.cos(now * 0.35 + l.x * 0.03) * 1.6
      l.vx = l.vx * 0.96 + cur_x * 0.04
      l.vy = l.vy * 0.96 + cur_y * 0.04
      local lx = l.x + l.vx * dt
      local ly = l.y + l.vy * dt
      if is_open_water(lx, ly, 4) then
        l.x, l.y = lx, ly
      else
        l.vx = -l.vx
        l.vy = -l.vy
      end

      -- Tether pickup check
      if tethered_count < MAX_CHAIN and dist2(boat.x, boat.y, l.x, l.y) < 13.5 * 13.5 then
        tethered_count = tethered_count + 1
        l.state = "tethered"
        l.chain_idx = tethered_count
        local pitch = 520 + tethered_count * 95
        tone("triangle", pitch, pitch * 1.25, 0.14, 0.22, 1)
        local lt = LANTERN_TYPES[l.kind]
        emit_sparks(l.x, l.y, WATER_Z + 5, 8, lt.c2, lt.c4)
        add_popup(l.x, l.y, WATER_Z + 11, "TETHER " .. tethered_count .. "/" .. MAX_CHAIN, lt.c3)
      end

    elseif l.state == "tethered" then
      local sample_i = math.min(#boat.trail, 5 + l.chain_idx * 7)
      local tgt = boat.trail[sample_i]
      if tgt then
        l.x = l.x + (tgt.x - l.x) * math.min(1, dt * 8.0)
        l.y = l.y + (tgt.y - l.y) * math.min(1, dt * 8.0)
      end

    elseif l.state == "delivering" then
      l.deliver_t = l.deliver_t + dt * 2.4
      local u = math.min(1, l.deliver_t)
      l.x = l.start_x + (PIER_X - l.start_x) * u
      l.y = l.start_y + (137 - l.start_y) * u
      if u >= 1 then
        local lt = LANTERN_TYPES[l.kind]
        emit_sparks(PIER_X, 137, WATER_Z + 8, 8, lt.c2, 36)
        table.remove(lanterns, i)
      end
    end
  end

  -- Check delivery at Harbor Beacon Pier!
  if tethered_count > 0 and dist2(boat.x, boat.y, PIER_X, PIER_Y) < PIER_R * PIER_R then
    local base_pts = 0
    local batch = 0
    for i = 1, #lanterns do
      local l = lanterns[i]
      if l.state == "tethered" then
        l.state = "delivering"
        l.deliver_t = 0
        l.start_x = l.x
        l.start_y = l.y
        base_pts = base_pts + LANTERN_TYPES[l.kind].pts
        batch = batch + 1
      end
    end

    local mult = CHAIN_MULT[math.min(#CHAIN_MULT, batch)]
    local gained = flr(base_pts * mult)
    score = score + gained
    delivered_total = delivered_total + batch
    if batch > best_chain then best_chain = batch end
    deliver_flash = 1.0

    sfx(1)
    if batch >= 3 then
      local bonus_s = batch
      time_left = math.min(GAME_DURATION, time_left + bonus_s)
      add_popup(PIER_X, PIER_Y + 6, WATER_Z + 18, "+" .. gained .. " (x" .. mult .. ") +" .. bonus_s .. "s!", 36)
      tone("triangle", 880, 1320, 0.28, 0.24, 2)
    else
      add_popup(PIER_X, PIER_Y + 6, WATER_Z + 16, "+" .. gained .. (batch > 1 and (" x" .. mult) or ""), 35)
    end
    emit_sparks(PIER_X, 136, WATER_Z + 8, 14 + batch * 3, 34, 36)
  end

  local active_free = 0
  for i = 1, #lanterns do
    if lanterns[i].state == "free" then active_free = active_free + 1 end
  end
  if active_free < 8 and #lanterns < 14 then
    spawn_lantern(true)
  end
end

-- Draw shimmering twilight water glints, warm reflections & beacon ring
local function draw_water_shimmer(now)
  -- Moonlight ripples drifting across the cove
  for i = 0, 34 do
    local wx = 60 + ((i * 29 + flr(now * 3)) % 136)
    local wy = 58 + ((i * 19 + flr(now * 2 + i)) % 82)
    if is_open_water(wx, wy, 2) then
      local phase = math.sin(now * 2.4 + i * 1.7)
      if phase > 0.2 then
        local c = (phase > 0.72) and 9 or 8
        vset(wx, wy, WATER_Z, c)
        vset(wx + 1, wy, WATER_Z, c)
      end
    end
  end

  -- Warm pier lantern reflections rippling on the dark cove water
  local pier_lights = { { 114, 135 }, { 129, 135 }, { 144, 135 } }
  for i = 1, #pier_lights do
    local lx, ly = pier_lights[i][1], pier_lights[i][2]
    for r = 0, 5 do
      local wob = flr(math.sin(now * 3.5 + i * 2 + r) * 1.4)
      local c = (r <= 1) and 35 or ((r <= 3) and 33 or 32)
      vset(lx + wob, ly - r * 2, WATER_Z, c)
      if r <= 2 then
        vset(lx + wob + 1, ly - r * 2, WATER_Z, 33)
      end
    end
  end

  -- Pulsing golden Beacon Pier drop-off sanctuary ring
  local ring_r = PIER_R - 2 + math.sin(now * 3.0) * 1.0
  local segs = 32
  local has_tow = count_tethered() > 0
  local ring_col = (deliver_flash > 0.1 or has_tow) and 36 or 34
  for s = 0, segs - 1 do
    local a = (s / segs) * math.pi * 2 + now * 0.32
    local rx = flr(PIER_X + math.cos(a) * ring_r)
    local ry = flr(PIER_Y + math.sin(a) * ring_r)
    if ry < 136 then
      local col = (s % 2 == 0) and ring_col or ((deliver_flash > 0.1 or has_tow) and 34 or 32)
      vset(rx, ry, WATER_Z, col)
      if s % 4 == 0 then
        vset(rx, ry, WATER_Z + 1, ring_col)
      end
    end
  end

  -- Outer cove harbor channel buoys with gentle water shimmer
  for i = 1, #buoys do
    local b = buoys[i]
    local bob = flr(math.sin(now * 2.5 + i) * 0.6)
    box(b.x - 1, b.y - 1, WATER_Z + 1 + bob, b.x + 1, b.y + 1, WATER_Z + 2 + bob, 25)
    vset(b.x, b.y, WATER_Z + 3 + bob, (flr(now * 2 + i) % 2 == 0) and 36 or 34)
    vset(b.x, b.y - 2, WATER_Z, 33)
    vset(b.x + 1, b.y - 2, WATER_Z, 32)
  end

  -- Ambient twilight fireflies drifting near pines & cottage
  for i = 1, #fireflies do
    local f = fireflies[i]
    local fx = flr(f.x + math.sin(now * 0.9 + f.phase) * 3.5)
    local fy = flr(f.y + math.cos(now * 0.75 + f.phase) * 3.5)
    local fz = flr(f.z + math.sin(now * 1.8 + f.phase) * 1.5)
    local blink = math.sin(now * 3.2 + f.phase)
    if blink > -0.2 then
      vset(fx, fy, fz, (blink > 0.5) and 36 or 34)
    end
  end
end

-- Draw diagonal sweeping volumetric lighthouse beam & water spotlight
local function draw_lighthouse_beam(now)
  -- Phase offset so beam sweeps diagonally across the cove water on frame 1!
  local a = now * 0.42 - 0.96
  local dx, dy = math.cos(a), math.sin(a)
  local px, py = -dy, dx

  -- Warm lantern-room glow halo
  for gx = -3, 3, 6 do
    vset(LH_X + gx, LH_Y, LH_LIGHT_Z, 35)
    vset(LH_X, LH_Y + gx, LH_LIGHT_Z, 35)
  end

  -- Primary sweeping light fan aimed over the cove water
  for d = 4, 54, 2 do
    local spread = d * 0.09
    local bx = LH_X + dx * d
    local by = LH_Y + dy * d
    local bz = LH_LIGHT_Z - d * 0.42
    if bx > 10 and bx < 245 and by > 10 and by < 245 and bz > WATER_Z + 1 then
      local c = (d < 14) and 36 or ((d < 28) and 35 or ((d < 42) and 34 or 33))
      -- Tapered dappled volumetric beam voxels (not a solid stick!)
      if d < 18 or (d % 4 == 0) then
        vset(flr(bx), flr(by), flr(bz), c)
      end
      if d >= 10 and d % 4 == 2 then
        vset(flr(bx + px * spread), flr(by + py * spread), flr(bz), (d < 28) and 34 or 33)
        vset(flr(bx - px * spread), flr(by - py * spread), flr(bz), (d < 28) and 34 or 33)
      end
    end
  end

  -- Luminous golden spotlight shimmer gliding across the dark cove water!
  local spot_x = flr(LH_X + dx * 66)
  local spot_y = flr(LH_Y + dy * 66)
  for ox = -4, 4, 2 do
    for oy = -4, 4, 2 do
      local dd = ox * ox + oy * oy
      if dd <= 18 and is_open_water(spot_x + ox, spot_y + oy, 0) then
        local c = (dd <= 4) and 35 or ((dd <= 10) and 34 or 32)
        vset(spot_x + ox, spot_y + oy, WATER_Z, c)
      end
    end
  end
end

-- Draw tugboat, wake, and tethered glowing lantern chain
local function draw_boat_and_lanterns(now)
  local bx = flr(boat.x + 0.5)
  local by = flr(boat.y + 0.5)
  local bob = (math.sin(now * 3.8) > 0.35) and 1 or 0
  local boat_frame = flr(now * 4) % 2

  model("tugboat", bx, by, WATER_Z + bob, boat.rot, false, boat_frame)

  -- Warm bow lantern glow reflection on water
  local hx = flr(boat.x + math.cos(boat.ang) * 9)
  local hy = flr(boat.y + math.sin(boat.ang) * 9)
  if is_open_water(hx, hy, 1) then
    vset(hx, hy, WATER_Z, 35)
    vset(hx + 1, hy, WATER_Z, 34)
    vset(hx, hy - 1, WATER_Z, 33)
  end

  -- Crisp V-shaped foam wake behind tugboat when moving
  local spd = math.sqrt(boat.vx * boat.vx + boat.vy * boat.vy)
  if spd > 3.5 then
    local fx, fy = math.cos(boat.ang), math.sin(boat.ang)
    local rx, ry = -fy, fx
    local wake_len = (boat.boost > 0) and 6 or 4
    for w = 1, wake_len do
      local back = 5.5 + w * 2.3
      local spread = 1.8 + w * 1.15
      local c = (w <= 2) and 10 or ((w <= 4) and 9 or 8)
      local lx1, ly1 = flr(boat.x - fx * back + rx * spread), flr(boat.y - fy * back + ry * spread)
      local lx2, ly2 = flr(boat.x - fx * back - rx * spread), flr(boat.y - fy * back - ry * spread)
      vset(lx1, ly1, WATER_Z, c)
      vset(lx2, ly2, WATER_Z, c)
      if w <= 2 then
        vset(flr(boat.x - fx * back), flr(boat.y - fy * back), WATER_Z, 10)
      end
    end
  end

  -- Glowing golden tether cord connecting boat to towed lanterns
  local chain = {}
  for i = 1, #lanterns do
    local l = lanterns[i]
    if l.state == "tethered" then
      chain[l.chain_idx] = l
    end
  end

  local prev_x, prev_y = bx, by
  for idx = 1, MAX_CHAIN do
    local l = chain[idx]
    if l then
      local lx, ly = flr(l.x + 0.5), flr(l.y + 0.5)
      for s = 1, 4 do
        local u = s / 5
        local tx = flr(prev_x + (lx - prev_x) * u)
        local ty = flr(prev_y + (ly - prev_y) * u)
        vset(tx, ty, WATER_Z + 2, (s % 2 == 0) and 36 or 34)
      end
      prev_x, prev_y = lx, ly
    end
  end

  -- Draw floating paper lanterns with luminous water reflection pools!
  for i = 1, #lanterns do
    local l = lanterns[i]
    local lx = flr(l.x + 0.5)
    local ly = flr(l.y + 0.5)
    local lbob = (math.sin(now * 3.1 + l.phase) > 0.3) and 1 or 0
    local lz = WATER_Z + 1 + lbob
    if l.state == "delivering" then
      lz = WATER_Z + 1 + flr(math.sin(l.deliver_t * math.pi) * 11)
    end
    local lframe = flr(now * 3 + l.phase) % 2
    local lt = LANTERN_TYPES[l.kind]

    if lt.swap then
      pswap(32, lt.c1)
      pswap(33, lt.c1)
      pswap(34, lt.c2)
      pswap(35, lt.c3)
    end
    model("lantern", lx, ly, lz, 0, false, lframe)
    if lt.swap then pswap() end

    -- Rippling luminous glow pool on the water surface beneath every lantern
    if l.state ~= "delivering" then
      local wob = flr(math.sin(now * 4.2 + l.phase) * 1.1)
      vset(lx - 2, ly - 1, WATER_Z, lt.c1)
      vset(lx + 2, ly - 1, WATER_Z, lt.c1)
      vset(lx, ly - 3, WATER_Z, lt.c2)
      vset(lx + wob, ly - 4, WATER_Z, lt.c1)
      vset(lx - wob, ly + 3, WATER_Z, lt.c1)
      vset(lx + 3, ly, WATER_Z, lt.c2)
      vset(lx - 3, ly, WATER_Z, lt.c2)
    end
  end

  -- Draw floating sparks
  for i = 1, #sparks do
    local s = sparks[i]
    vset(flr(s.x), flr(s.y), flr(s.z), s.col)
  end
end

-- Draw clean, crisp 2D HUD overlay (768x432)
local function draw_hud(now)
  for i = 1, #popups do
    local p = popups[i]
    local sx, sy, vis = project(p.x, p.y, p.z)
    if vis then
      local tw = textw(p.text)
      print(p.text, flr(sx - tw * 0.5), flr(sy), p.col, true, 1)
    end
  end

  if mode == "title" then
    -- Sleek, compact twilight crest at top leaving the full harbor scene unobstructed!
    local bx0, by0, bx1, by1 = 216, 10, 552, 68
    rectfill(bx0, by0, bx1, by1, 44)
    rect(bx0, by0, bx1, by1, 34)
    rect(bx0 + 2, by0 + 2, bx1 - 2, by1 - 2, 45)
    -- Little glowing lantern corner ornaments
    circfill(bx0 + 14, by0 + 18, 4, 34)
    circfill(bx0 + 14, by0 + 18, 2, 36)
    circfill(bx1 - 14, by0 + 18, 4, 34)
    circfill(bx1 - 14, by0 + 18, 2, 36)

    local title = "LANTERN COVE"
    print(title, flr(384 - textw(title)), 17, 35, true, 2)

    local sub = "TOW DRIFTING LANTERNS TO THE BEACON PIER"
    print(sub, flr(384 - textw(sub) * 0.5), 39, 28, true, 1)

    local prompt = "PRESS SPACE OR ARROWS TO SAIL"
    local pcol = (flr(now * 2.5) % 2 == 0) and 36 or 34
    print(prompt, flr(384 - textw(prompt) * 0.5), 54, pcol, true, 1)

    -- Subtle bottom controls bar
    local leg = "ARROWS/WASD: STEER   SPACE: STEAM BOOST   X: CAMERA"
    rectfill(204, 400, 564, 420, 44)
    rect(204, 400, 564, 420, 45)
    print(leg, flr(384 - textw(leg) * 0.5), 407, 14, true, 1)
    return
  end

  -- Active Play & Game Over HUD
  rectfill(14, 12, 208, 62, 44)
  rect(14, 12, 208, 62, 45)
  print("SCORE", 24, 20, 14, true, 1)
  print(tostring(score), 68, 17, 35, true, 2)

  local towed = count_tethered()
  print("TOW " .. towed .. "/" .. MAX_CHAIN, 24, 45, 28, true, 1)
  for i = 1, MAX_CHAIN do
    local px = 84 + (i - 1) * 14
    local col = (i <= towed) and 34 or 12
    circfill(px, 48, 4, col)
    if i <= towed then circfill(px, 48, 2, 36) end
  end
  if towed >= 2 then
    local mult = CHAIN_MULT[math.min(#CHAIN_MULT, towed)]
    print("x" .. mult, 176, 45, 36, true, 1)
  end

  -- Top-right: Festival Timer & Delivered count
  rectfill(568, 12, 754, 62, 44)
  rect(568, 12, 754, 62, (time_left < 15 and flr(now * 4) % 2 == 0) and 26 or 45)
  local secs = math.ceil(time_left)
  local tcol = (time_left < 15) and 26 or 35
  print("FESTIVAL", 578, 20, 14, true, 1)
  print(secs .. "s", 696, 17, tcol, true, 2)

  local bar_w = flr((time_left / GAME_DURATION) * 166)
  rectfill(578, 38, 744, 44, 11)
  if bar_w > 0 then
    rectfill(578, 38, 578 + bar_w, 44, (time_left < 15) and 26 or 34)
  end
  print("DELIVERED: " .. delivered_total, 578, 49, 28, true, 1)

  -- Bottom-left: Steam Boost readiness indicator
  rectfill(14, 394, 184, 420, 44)
  rect(14, 394, 184, 420, 45)
  local boost_ready = 1 - mid(0, boat.boost_cd / 2.4, 1)
  print("STEAM", 22, 404, 14, true, 1)
  rectfill(62, 403, 174, 411, 11)
  local bw = flr(boost_ready * 112)
  if bw > 0 then
    rectfill(62, 403, 62 + bw, 411, (boost_ready >= 1) and 10 or 8)
  end

  -- Contextual Beacon Pier callout when towing lanterns
  if mode == "play" and towed > 0 then
    local sx, sy, vis = project(PIER_X, 138, WATER_Z + 15)
    if vis then
      local msg = (towed >= MAX_CHAIN) and "FULL! RETURN TO PIER" or "RETURN TO PIER"
      local tw = textw(msg)
      local px = mid(12, flr(sx - tw * 0.5), 756 - tw)
      local py = mid(70, flr(sy), 380)
      rectfill(px - 5, py - 3, px + tw + 4, py + 10, 44)
      rect(px - 5, py - 3, px + tw + 4, py + 10, 34)
      print(msg, px, py, 35, true, 1)
    end
  end

  -- Game Over Festival Summary Card
  if mode == "gameover" then
    local x0, y0, x1, y1 = 224, 114, 544, 316
    rectfill(x0, y0, x1, y1, 44)
    rect(x0, y0, x1, y1, 34)
    rect(x0 + 3, y0 + 3, x1 - 3, y1 - 3, 45)

    local hdr = "FESTIVAL COMPLETE"
    print(hdr, flr(384 - textw(hdr)), 132, 35, true, 2)

    local rank = "HARBOR APPRENTICE"
    if score >= 3500 then rank = "MASTER OF THE TIDE"
    elseif score >= 2000 then rank = "COVE CAPTAIN"
    elseif score >= 900 then rank = "LANTERN KEEPER"
    end
    print(rank, flr(384 - textw(rank) * 0.5), 160, 39, true, 1)

    print("FINAL SCORE", 258, 186, 14, true, 1)
    print(tostring(score), 446, 184, 36, true, 2)

    print("BEST SCORE", 258, 212, 14, true, 1)
    print(tostring(best_score), 446, 212, 34, true, 1)

    print("LANTERNS DELIVERED", 258, 232, 14, true, 1)
    print(tostring(delivered_total), 446, 232, 28, true, 1)

    print("LONGEST CONVOY", 258, 252, 14, true, 1)
    print(best_chain .. " LANTERNS", 446, 252, 28, true, 1)

    local cta = "PRESS SPACE TO SAIL AGAIN"
    print(cta, flr(384 - textw(cta) * 0.5), 286, (flr(now * 2.5) % 2 == 0) and 35 or 34, true, 1)
  end
end

function _draw()
  cls()
  local now = t()

  local shake_x = (screen_shake > 0) and (rnd() - 0.5) * 3.5 * screen_shake or 0
  local shake_y = (screen_shake > 0) and (rnd() - 0.5) * 3.5 * screen_shake or 0

  if mode == "title" then
    -- Lush zoomed-in harbor framing showcasing lighthouse, cottage, pier, tugboat & lanterns!
    camera(126 + math.sin(now * 0.25) * 3, 124 + math.cos(now * 0.2) * 2, 14, 1.36, CAM_YAW + math.sin(now * 0.14) * 0.03)
  elseif cam_mode == 1 then
    camera(126 + shake_x, 124 + shake_y, 14, 1.18, CAM_YAW)
  else
    local tx = 126 + (boat.x - 126) * 0.35 + shake_x
    local ty = 124 + (boat.y - 118) * 0.35 + shake_y
    local zoom = 1.40 + deliver_flash * 0.035
    camera(tx, ty, 14, zoom, CAM_YAW)
  end

  draw_water_shimmer(now)
  draw_lighthouse_beam(now)
  draw_boat_and_lanterns(now)
  draw_hud(now)
end

