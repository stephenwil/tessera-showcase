__lua__
-- =========================================================================
-- CRYPT OF THE VOXEL
-- An action-RPG dungeon crawl for the Tessera voxel fantasy console.
--
-- Fight through the crypt, take the Golden Key from the Spike Gallery,
-- unseal the Vault and claim the Ancient Relic (or topple the Crypt Golem).
--
--   Arrows ........ move          Z / Space (A) ... sword swing
--   X / E (B) ..... evasive roll  (invulnerable while rolling)
-- =========================================================================

local floor, sqrt, sin, cos, abs, atan = math.floor, math.sqrt, math.sin, math.cos, math.abs, math.atan
local PI = math.pi

-- ---- world constants ----------------------------------------------------
local TS, GW, GH = 8, 30, 30       -- tile size (voxels) and grid size (tiles)
local OX, OY = 8, 8                -- voxel origin of tile (0,0)
local FZ = 2                       -- feet height: first free voxel above the flagstones
local ZOOM = 2.0                   -- gameplay camera zoom (title screen shows the whole crypt at 1.1)

-- ---- palette indices (see __pal__) ----------------------------------------
local C_FOG, C_MORTAR, C_STONE, C_STONE2, C_STONEHI = 200, 201, 202, 203, 204
local C_MOSSD, C_MOSS, C_MOSSL = 205, 206, 207
local C_WOODD, C_WOOD, C_WOODL = 208, 209, 210
local C_GOLD, C_GOLDL, C_GOLDD = 211, 212, 213
local C_STEEL, C_STEELB, C_STEELD = 214, 215, 216
local C_RED, C_REDD, C_PINK = 217, 218, 233
local C_BONE, C_BONED = 222, 223
local C_SLIME, C_SLIMED, C_SLIMEL = 224, 225, 226
local C_BAT, C_BATD = 227, 228
local C_FLAMEL, C_FLAME, C_FLAMER = 229, 230, 231
local C_SHADOW, C_RUNE, C_WHITE, C_BLACK = 232, 239, 240, 241
local C_CLAY, C_CLAYD = 242, 243
local C_PANEL, C_PANELB = 252, 253

-- ---- small helpers ------------------------------------------------------
local function clamp(v, a, b) if v < a then return a elseif v > b then return b end return v end
local function dist(ax, ay, bx, by) local dx, dy = ax - bx, ay - by return sqrt(dx * dx + dy * dy) end
local function hsh(a, b, c)
  local h = (floor(a) * 374761 + floor(b) * 668265 + floor(c or 0) * 127417) % 99991
  h = (h * 7919 + 13) % 100003
  return (h % 1000) / 1000
end
local function tcenter(tx, ty) return OX + tx * TS + TS / 2, OY + ty * TS + TS / 2 end
local function vtile(x, y) return floor((x - OX) / TS), floor((y - OY) / TS) end
local function rr(a, b) return a + rnd(b - a) end
local function pick(list) return list[floor(rnd(#list)) + 1] end
local function snd(w, f0, f1, d, v) tone(w, f0, f1, d, v or 0.25, 9) end

-- 8-way directions, k = 0..7 counter-clockwise starting at +x
local DX = { [0] = 1, 1, 0, -1, -1, -1, 0, 1 }
local DY = { [0] = 0, 1, 1, 1, 0, -1, -1, -1 }
local function dirk(dx, dy) return floor(atan(dy, dx) / (PI / 4) + 0.5) % 8 end

-- =========================================================================
-- DUNGEON LAYOUT  (tile coordinates, y grows north / up the screen)
-- =========================================================================
local g = {}                 -- g[ty][tx]: '#' wall  '.' floor  'S' spikes  'P' pillar  'A' altar  'V' vault door
areas = {}             -- named rooms and passages
local torches = {}           -- wall sconces
local spawns = {}            -- enemy spawn list
local chest_defs, pot_defs = {}, {}
local tilebl = {}            -- dynamic blockers: chests, pots (tile index -> true)

local function newgrid()
  g = {}
  for ty = 0, GH - 1 do g[ty] = {} for tx = 0, GW - 1 do g[ty][tx] = '#' end end
  areas, torches, spawns, chest_defs, pot_defs, tilebl = {}, {}, {}, {}, {}, {}
end
local function fill(x0, y0, x1, y1, ch) for ty = y0, y1 do for tx = x0, x1 do g[ty][tx] = ch end end end
local function area(name, x0, y0, x1, y1) fill(x0, y0, x1, y1, '.'); areas[#areas + 1] = { name = name, x0 = x0, y0 = y0, x1 = x1, y1 = y1, seen = false } end
local function sp(kind, tx, ty) spawns[#spawns + 1] = { kind = kind, tx = tx, ty = ty } end
local function chest(tx, ty, loot) chest_defs[#chest_defs + 1] = { tx = tx, ty = ty, loot = loot } end
local function pot(tx, ty) pot_defs[#pot_defs + 1] = { tx = tx, ty = ty } end
local function torch(tx, ty) torches[#torches + 1] = { tx = tx, ty = ty } end

local function layout()
  newgrid()
  area("THE ENTRANCE CRYPT", 2, 2, 10, 9)
  area("WEST PASSAGE", 11, 5, 14, 5)
  area("THE SPIKE GALLERY", 15, 2, 27, 8)
  area("STAIR PASSAGE", 6, 10, 6, 11)
  area("THE BONE HALL", 2, 12, 12, 19)
  area("THE ARCH", 13, 15, 13, 15)
  area("THE GREAT HALL", 14, 12, 27, 19)
  area("GALLERY PASSAGE", 21, 9, 21, 11)
  area("THE OSSUARY", 2, 21, 9, 28)
  area("OSSUARY PASSAGE", 5, 20, 5, 20)
  area("THE GOLEM'S VAULT", 12, 21, 27, 28)
  area("VAULT GATE", 20, 20, 21, 20)
  fill(20, 20, 21, 20, 'V')

  -- Entrance crypt (hero starts at 4,4)
  fill(4, 7, 4, 7, 'P'); fill(8, 7, 8, 7, 'P')
  sp('slime', 8, 3); sp('slime', 9, 8)
  for _, p in ipairs({ { 2, 2 }, { 3, 2 }, { 10, 2 }, { 2, 9 }, { 10, 9 }, { 10, 3 } }) do pot(p[1], p[2]) end
  chest(10, 6, 'gold')
  torch(3, 10); torch(9, 10); torch(12, 6)

  -- Spike gallery: three columns of pressure-plate spikes guard the key
  for ty = 2, 8 do fill(22, ty, 24, ty, 'S') end
  fill(19, 3, 19, 3, 'P'); fill(19, 7, 19, 7, 'P')
  sp('slime', 17, 3); sp('slime', 17, 7); sp('bat', 20, 5); sp('bat', 25, 3)
  pot(16, 2); pot(16, 8); pot(21, 2)
  chest(27, 5, 'key'); chest(27, 2, 'gold'); chest(27, 8, 'potion')
  torch(17, 9); torch(25, 9); torch(28, 5)

  -- Bone hall
  fill(5, 14, 5, 14, 'P'); fill(9, 14, 9, 14, 'P'); fill(5, 17, 5, 17, 'P'); fill(9, 17, 9, 17, 'P')
  sp('skel', 4, 16); sp('skel', 8, 17); sp('skel', 11, 13)
  chest(2, 19, 'potion'); pot(12, 19); pot(12, 12); pot(2, 12)
  torch(3, 20); torch(8, 20); torch(11, 20)

  -- Great hall
  fill(17, 14, 17, 14, 'P'); fill(17, 17, 17, 17, 'P'); fill(24, 14, 24, 14, 'P'); fill(24, 17, 24, 17, 'P')
  sp('skel', 19, 16); sp('skel', 22, 17); sp('skel', 26, 15); sp('bat', 16, 18); sp('bat', 25, 13)
  chest(27, 19, 'gold'); chest(14, 19, 'potion'); pot(27, 12); pot(14, 12); pot(20, 12)
  torch(15, 20); torch(19, 20); torch(22, 20); torch(26, 20)

  -- Ossuary treasure room
  fill(4, 24, 4, 24, 'P'); fill(7, 24, 7, 24, 'P')
  sp('bat', 3, 26); sp('bat', 8, 26); sp('skel', 6, 26)
  chest(2, 28, 'gold'); chest(9, 28, 'gold'); chest(5, 28, 'potion'); pot(2, 21); pot(9, 21); pot(3, 22)
  torch(3, 29); torch(8, 29)

  -- Golem's vault
  fill(14, 23, 14, 23, 'P'); fill(14, 26, 14, 26, 'P'); fill(25, 23, 25, 23, 'P'); fill(25, 26, 25, 26, 'P')
  fill(19, 28, 20, 28, 'A')
  sp('golem', 20, 25)
  chest(12, 28, 'gold'); chest(27, 28, 'gold')
  torch(14, 29); torch(17, 29); torch(22, 29); torch(25, 29)
end

local function solid(tx, ty)
  if tx < 0 or ty < 0 or tx >= GW or ty >= GH then return true end
  local c = g[ty][tx]
  if c == '#' or c == 'P' or c == 'A' or c == 'V' then return true end
  return tilebl[ty * GW + tx] == true
end
local function wall_at(x, y)
  local tx, ty = vtile(x, y)
  if tx < 0 or ty < 0 or tx >= GW or ty >= GH then return true end
  local c = g[ty][tx]
  return c == '#' or c == 'P' or c == 'A' or c == 'V'
end
local function solid_at(x, y) local tx, ty = vtile(x, y) return solid(tx, ty) end
local function blocked_box(x, y, r)
  return solid_at(x - r, y - r) or solid_at(x + r, y - r) or solid_at(x - r, y + r) or solid_at(x + r, y + r)
end
local function walkable(tx, ty) local c = g[ty] and g[ty][tx] return c == '.' or c == 'S' end
local function los(x0, y0, x1, y1)
  local d = dist(x0, y0, x1, y1)
  local n = floor(d / 3) + 1
  for i = 1, n - 1 do
    local f = i / n
    if wall_at(x0 + (x1 - x0) * f, y0 + (y1 - y0) * f) then return false end
  end
  return true
end
local function area_at(tx, ty)
  for i = 1, #areas do
    local a = areas[i]
    if tx >= a.x0 and tx <= a.x1 and ty >= a.y0 and ty <= a.y1 then return i end
  end
  return 0
end

-- =========================================================================
-- WORLD RENDERING (map layer, built once)
-- =========================================================================
local function torch_glow(x, y)
  local best = 999
  for i = 1, #torches do
    local t = torches[i]
    local d = dist(x, y, OX + t.tx * TS + 4, OY + t.ty * TS - 2)
    if d < best then best = d end
  end
  if best < 13 then return 2 elseif best < 24 then return 1 end
  return 0
end

local function draw_floor(tx, ty)
  local x0, y0 = OX + tx * TS, OY + ty * TS
  local glow = torch_glow(x0 + 4, y0 + 4)
  local mortar = glow == 2 and 247 or (glow == 1 and 247 or C_MORTAR)
  mbox(x0, y0, 0, x0 + 7, y0 + 7, 1, mortar)
  for sy = 0, 1 do for sx = 0, 1 do
    local h = hsh(tx * 2 + sx, ty * 2 + sy, 3)
    local c
    if glow == 2 then c = h < 0.5 and 248 or 249
    elseif glow == 1 then c = h < 0.35 and 244 or (h < 0.75 and 245 or 246)
    elseif h > 0.86 then c = h > 0.94 and C_MOSSL or C_MOSS
    elseif h > 0.8 then c = C_MOSSD
    else c = h < 0.4 and C_STONE or (h < 0.8 and C_STONE2 or C_STONEHI) end
    mbox(x0 + sx * 4, y0 + sy * 4, 1, x0 + sx * 4 + 2, y0 + sy * 4 + 2, 1, c)
  end end
  -- rubble and bone scraps hugging the walls
  local h2 = hsh(tx, ty, 9)
  if h2 > 0.88 then
    local rx, ry = x0 + 1 + floor(h2 * 100) % 5, y0 + 1 + floor(h2 * 1000) % 5
    mset(rx, ry, 2, h2 > 0.95 and C_BONE or C_STONEHI); mset(rx + 1, ry, 2, C_STONE2)
  end
end

local function draw_spike_plate(tx, ty)
  local x0, y0 = OX + tx * TS, OY + ty * TS
  mbox(x0, y0, 0, x0 + 7, y0 + 7, 1, C_SHADOW)
  mbox(x0, y0, 1, x0 + 7, y0, 1, C_MORTAR); mbox(x0, y0 + 7, 1, x0 + 7, y0 + 7, 1, C_MORTAR)
  for _, p in ipairs({ { 1, 1 }, { 5, 1 }, { 1, 5 }, { 5, 5 } }) do mbox(x0 + p[1], y0 + p[2], 1, x0 + p[1] + 1, y0 + p[2] + 1, 1, C_MORTAR) end
end

local WALLC = { C_STONE, C_STONE2, C_MORTAR, C_STONE }
local function draw_wall(tx, ty)
  local x0, y0 = OX + tx * TS, OY + ty * TS
  local near = false
  for dy = -1, 1 do for dx = -1, 1 do
    local nx, ny = tx + dx, ty + dy
    if nx >= 0 and ny >= 0 and nx < GW and ny < GH and g[ny][nx] ~= '#' then near = true end
  end end
  if not near then
    mbox(x0, y0, 0, x0 + 7, y0 + 7, 11, hsh(tx, ty, 1) > 0.5 and C_MORTAR or 200)
    mbox(x0, y0, 12, x0 + 7, y0 + 7, 12, 200)
    return
  end
  local low = walkable(tx, ty + 1) or (g[ty + 1] and g[ty + 1][tx] == 'V')
  local top = low and 5 or 11
  mbox(x0, y0, 0, x0 + 7, y0 + 7, 1, C_MORTAR)
  local course, z = 0, FZ
  while z <= top - 1 do
    local zt = math.min(z + 2, top - 1)
    local segs = (course % 2 == 0) and { { 0, 3 }, { 4, 7 } } or { { 0, 1 }, { 2, 5 }, { 6, 7 } }
    for si, s in ipairs(segs) do
      local h = hsh(tx * 3 + si, ty * 5 + course, 7)
      local c = WALLC[floor(h * 4) + 1]
      if course == 0 and h > 0.55 then c = (h > 0.8) and C_MOSS or C_MOSSD
      elseif course == 1 and h > 0.9 then c = C_MOSSD end
      mbox(x0 + s[1], y0, z, x0 + s[2], y0 + 7, zt, c)
      if s[1] > 0 then mbox(x0 + s[1], y0, z, x0 + s[1], y0, zt, C_MORTAR) end
    end
    mbox(x0, y0, zt, x0 + 7, y0, zt, C_MORTAR)  -- mortar line on the visible face
    z = zt + 1; course = course + 1
  end
  mbox(x0, y0, top, x0 + 7, y0 + 7, top, hsh(tx, ty, 5) > 0.6 and C_STONE2 or C_STONEHI)
  if top > FZ then mbox(x0, y0, top, x0 + 7, y0, top, C_STONEHI) end
end

local function draw_pillar(tx, ty)
  local cx, cy = OX + tx * TS + 2, OY + ty * TS + 2
  mbox(cx - 1, cy - 1, FZ, cx + 4, cy + 4, FZ + 1, C_STONEHI)       -- plinth
  mbox(cx, cy, FZ + 2, cx + 3, cy + 3, 13, C_STONE2)                 -- shaft
  for z = FZ + 3, 12, 3 do mbox(cx, cy, z, cx + 3, cy + 3, z, C_STONE) end -- carved bands
  mbox(cx, cy, FZ + 2, cx, cy, 13, C_STONEHI); mbox(cx + 3, cy + 3, FZ + 2, cx + 3, cy + 3, 13, C_STONE)
  mbox(cx - 1, cy - 1, 14, cx + 4, cy + 4, 15, C_STONEHI)           -- capital
  mbox(cx, cy, 16, cx + 3, cy + 3, 16, C_STONE2)
  mset(cx + 1, cy - 1, 13, C_MOSS); mset(cx + 2, cy, 5, C_MOSSL)
end

local function draw_altar(tx, ty)
  local x0, y0 = OX + tx * TS, OY + ty * TS
  mbox(x0, y0, FZ, x0 + 7, y0 + 7, FZ + 2, C_STONE2)
  mbox(x0 + 1, y0 + 1, FZ + 3, x0 + 6, y0 + 6, FZ + 4, C_STONEHI)
  mbox(x0, y0, FZ + 3, x0 + 7, y0, FZ + 3, C_GOLD)
  mbox(x0 + 2, y0 + 2, FZ + 5, x0 + 5, y0 + 5, FZ + 5, C_GOLDD)
end

gate_open = 0            -- 0 sealed .. 1 fully lowered
local function draw_gate()
  local rem = floor(11 * (1 - gate_open) + 0.999)
  local x0, y0 = OX + 20 * TS, OY + 20 * TS
  mbox(x0, y0, FZ, x0 + 15, y0 + 7, 13, 0)
  if rem <= 0 then return end
  local top = FZ + rem - 1
  mbox(x0, y0 + 2, FZ, x0 + 15, y0 + 5, top, C_STEELD)
  for bx = 1, 14, 3 do mbox(x0 + bx, y0 + 1, FZ, x0 + bx, y0 + 1, top, C_STEEL) end
  mbox(x0, y0 + 1, FZ + 2, x0 + 15, y0 + 1, FZ + 2, C_GOLDD)
  mbox(x0, y0 + 1, math.max(FZ, top - 2), x0 + 15, y0 + 1, top, C_GOLDD)
  if rem >= 7 then
    mbox(x0 + 6, y0 + 1, FZ + 3, x0 + 9, y0, FZ + 7, C_GOLD)      -- gold lock plate
    mbox(x0 + 7, y0 - 1, FZ + 4, x0 + 8, y0 - 1, FZ + 6, C_GOLDL)
    mset(x0 + 7, y0 - 1, FZ + 5, C_BLACK)
  end
end

local function draw_sconce(tx, ty)
  local x, y = OX + tx * TS + 4, OY + ty * TS
  mbox(x - 1, y - 1, 5, x, y - 1, 6, C_STEELD)            -- bracket plate
  mbox(x - 1, y - 2, 6, x, y - 2, 8, C_STEEL)             -- cup
  mset(x, y - 2, 8, C_STEELB)
end

local function render_world()
  mclear()
  for ty = 0, GH - 1 do for tx = 0, GW - 1 do
    local c = g[ty][tx]
    if c == '#' then draw_wall(tx, ty)
    elseif c == 'S' then draw_spike_plate(tx, ty)
    elseif c == 'V' then draw_floor(tx, ty)
    else draw_floor(tx, ty) end
  end end
  for ty = 0, GH - 1 do for tx = 0, GW - 1 do
    local c = g[ty][tx]
    if c == 'P' then draw_floor(tx, ty); draw_pillar(tx, ty)
    elseif c == 'A' then draw_floor(tx, ty); draw_altar(tx, ty) end
  end end
  for i = 1, #torches do draw_sconce(torches[i].tx, torches[i].ty) end
  draw_gate()
end

-- =========================================================================
-- GAME STATE
-- =========================================================================
scene = "title"                 -- "title" | "play" | "dead" | "win"
tk = 0                          -- update ticks (30 per second)
hero = {}
enemies, items, chests, pots, fx, pops = {}, {}, {}, {}, {}, {}
cam = { x = 128, y = 128, z = 22, zoom = 1.1, shake = 0 }
msg = { text = "", t = 0 }
banner = { text = "", t = 0 }
cur_area = 0
play_t, scene_t = 0, 0
flash_t = 0
win_reason = ""
kills = 0
golem = nil
relic_x, relic_y, relic_z = 0, 0, 0

local EDEF = {
  skel  = { hp = 6,  r = 2.6, spd = 0.55, det = 52, name = "SKELETON" },
  bat   = { hp = 2,  r = 3.0, spd = 1.05, det = 46, name = "BAT" },
  slime = { hp = 3,  r = 3.2, spd = 0.9,  det = 40, name = "SLIME" },
  golem = { hp = 36, r = 7.0, spd = 0.4,  det = 70, name = "CRYPT GOLEM" },
}

local function say(text, t) msg.text = text; msg.t = t or 90 end
local function popup(x, y, z, txt, c) pops[#pops + 1] = { x = x, y = y, z = z, txt = txt, c = c, life = 26 } end

-- debris / spark physics particles
local function burst(x, y, z, n, cols, spd, up)
  for _ = 1, n do
    local a = rnd(2 * PI)
    local s = rr(0.2, 1) * (spd or 1.2)
    fx[#fx + 1] = { x = x, y = y, z = z, vx = cos(a) * s, vy = sin(a) * s, vz = rr(0.3, 1) * (up or 1.2), c = pick(cols), life = floor(rr(14, 30)) }
  end
end

local function spawn_item(kind, x, y, vx, vy, vz)
  items[#items + 1] = { kind = kind, x = x, y = y, z = FZ + 4, vx = vx or 0, vy = vy or 0, vz = vz or 1.5, age = 0 }
end
local function drop_coins(x, y, n)
  for _ = 1, n do local a = rnd(2 * PI) spawn_item("coin", x, y, cos(a) * rr(0.4, 1.4), sin(a) * rr(0.4, 1.4), rr(1.2, 2.4)) end
end

local function make_enemy(kind, tx, ty)
  local d = EDEF[kind]
  local x, y = tcenter(tx, ty)
  return { kind = kind, x = x, y = y, z = FZ, hx = x, hy = y, hp = d.hp, maxhp = d.hp, r = d.r, st = "idle", cd = 30 + floor(rnd(30)),
           tm = 0, hurt = 0, stun = 0, kx = 0, ky = 0, k = 6, ph = rnd(6.28), anim = 0, dead = false, phase2 = false }
end

local function new_game()
  layout()
  render_world()
  enemies, items, chests, pots, fx, pops = {}, {}, {}, {}, {}, {}
  golem = nil
  for i = 1, #spawns do
    local s = spawns[i]
    local e = make_enemy(s.kind, s.tx, s.ty)
    enemies[#enemies + 1] = e
    if s.kind == "golem" then golem = e end
  end
  for i = 1, #chest_defs do
    local d = chest_defs[i]
    local x, y = tcenter(d.tx, d.ty)
    chests[#chests + 1] = { x = x, y = y, tx = d.tx, ty = d.ty, loot = d.loot, open = false, pop = 0 }
    tilebl[d.ty * GW + d.tx] = true
  end
  for i = 1, #pot_defs do
    local d = pot_defs[i]
    local x, y = tcenter(d.tx, d.ty)
    pots[#pots + 1] = { x = x, y = y, tx = d.tx, ty = d.ty, hurt = 0 }
    tilebl[d.ty * GW + d.tx] = true
  end
  local hx, hy = tcenter(4, 4)
  hero = { x = hx, y = hy, z = FZ, k = 2, hp = 10, maxhp = 10, gold = 0, key = false,
           swing = 0, swing_cd = 0, hit_done = false, roll = 0, roll_cd = 0, rdx = 0, rdy = 0, inv = 0, hurt = 0, kx = 0, ky = 0,
           moving = false, dead = false }
  gate_open = 0
  cur_area = 0
  kills, play_t, flash_t = 0, 0, 0
  msg.t, banner.t = 0, 0
  relic_x, relic_y = OX + 20 * TS, OY + 28 * TS + 4
  relic_z = FZ + 11
end

-- =========================================================================
-- COMBAT HELPERS
-- =========================================================================
local function hurt_hero(n, sx, sy)
  local h = hero
  if h.inv > 0 or h.roll > 0 or h.dead or scene ~= "play" then return false end
  h.hp = h.hp - n
  h.inv = 36; h.hurt = 8; flash_t = 6; cam.shake = 5
  local d = dist(h.x, h.y, sx, sy)
  if d > 0.1 then h.kx = (h.x - sx) / d * 3.2; h.ky = (h.y - sy) / d * 3.2 end
  popup(h.x, h.y, FZ + 16, "-" .. n, C_PINK)
  burst(h.x, h.y, FZ + 8, 8, { C_RED, C_REDD, C_PINK }, 1.6)
  snd("saw", 520, 120, 0.22, 0.3)
  snd("noise", 700, 200, 0.1, 0.2)
  if h.hp <= 0 then
    h.hp = 0; h.dead = true; scene = "dead"; scene_t = 0
    burst(h.x, h.y, FZ + 8, 26, { C_BONE, C_RED, C_REDD, C_STEEL }, 2.0, 2.0)
    tone("saw", 400, 60, 0.9, 0.35, 0); tone("triangle", 220, 110, 1.2, 0.3, 1)
  end
  return true
end

local function enemy_gold(e)
  if e.kind == "skel" then drop_coins(e.x, e.y, 2 + floor(rnd(3))); if rnd() < 0.22 then spawn_item("potion", e.x, e.y) end
  elseif e.kind == "bat" then if rnd() < 0.6 then drop_coins(e.x, e.y, 1 + floor(rnd(2))) end
  elseif e.kind == "slime" then drop_coins(e.x, e.y, 1 + floor(rnd(3))); if rnd() < 0.15 then spawn_item("potion", e.x, e.y) end end
end

local function win_game(reason)
  if scene == "win" then return end
  scene = "win"; scene_t = 0; win_reason = reason
  hero.inv = 9999
  for _ = 1, 4 do tone("triangle", 523, 523, 0.12, 0.35, 1) end
  tone("triangle", 523, 659, 0.2, 0.4, 0); tone("triangle", 659, 784, 0.3, 0.4, 1); tone("triangle", 784, 1047, 0.6, 0.45, 2)
  burst(relic_x, relic_y, FZ + 12, 60, { C_GOLD, C_GOLDL, C_WHITE, C_PINK, 219 }, 2.4, 3)
end

local function kill_enemy(e)
  e.dead = true
  kills = kills + 1
  local cols = e.kind == "skel" and { C_BONE, C_BONED, C_STEELD } or (e.kind == "slime" and { C_SLIME, C_SLIMEL, C_SLIMED } or (e.kind == "golem" and { 236, 237, 238, C_RUNE } or { C_BAT, C_BATD, C_PINK }))
  burst(e.x, e.y, FZ + 5, e.kind == "golem" and 70 or 16, cols, e.kind == "golem" and 2.6 or 1.5, e.kind == "golem" and 3 or 1.6)
  if e.kind == "golem" then
    drop_coins(e.x, e.y, 30)
    cam.shake = 14
    tone("noise", 300, 30, 1.2, 0.4, 0); tone("saw", 150, 40, 1.0, 0.3, 1)
    golem_dead_t = 40
    say("THE CRYPT GOLEM CRUMBLES!", 120)
  else
    enemy_gold(e)
    snd("noise", 600, 90, 0.2, 0.28)
    snd("triangle", 400, 140, 0.18, 0.25)
  end
end
golem_dead_t = 0

local function hurt_enemy(e, dmg, kx, ky)
  if e.dead then return end
  e.hp = e.hp - dmg
  e.hurt = 6
  if e.kind ~= "golem" then
    e.stun = 8; e.kx = kx * 3.4; e.ky = ky * 3.4
    if e.st == "idle" then e.st = "chase" end
  else
    e.kx = kx * 0.5; e.ky = ky * 0.5
    if e.st == "idle" then e.st = "chase" end
  end
  popup(e.x, e.y, FZ + (e.kind == "golem" and 26 or 14), tostring(dmg), C_WHITE)
  burst(e.x - kx * 3, e.y - ky * 3, FZ + 8, 7, { C_WHITE, C_FLAMEL, C_STEELB }, 1.6)
  snd("square", 320, 110, 0.07, 0.3)
  if e.hp <= 0 then kill_enemy(e) end
end

local function open_chest(c)
  if c.open then return end
  c.open = true; c.pop = 12
  snd("saw", 220, 520, 0.2, 0.25); snd("triangle", 660, 990, 0.25, 0.25)
  burst(c.x, c.y, FZ + 8, 12, { C_GOLD, C_GOLDL, C_WHITE }, 1.4, 2)
  if c.loot == "key" then
    spawn_item("key", c.x - 6, c.y, -0.3, 0, 2.6)
    say("YOU FOUND THE GOLDEN KEY!", 120)
  elseif c.loot == "potion" then
    spawn_item("potion", c.x - 5, c.y - 2, -0.4, -0.2, 2.2); drop_coins(c.x - 4, c.y, 3)
  else
    drop_coins(c.x - 4, c.y, 5 + floor(rnd(4)))
    if rnd() < 0.25 then spawn_item("potion", c.x - 5, c.y + 2, -0.4, 0.3, 2.2) end
  end
end

local function break_pot(p)
  p.dead = true
  tilebl[p.ty * GW + p.tx] = nil
  burst(p.x, p.y, FZ + 3, 14, { C_CLAY, C_CLAYD, C_WOODD }, 1.5, 1.6)
  snd("noise", 900, 300, 0.12, 0.25)
  if rnd() < 0.55 then drop_coins(p.x, p.y, 1 + floor(rnd(3))) end
  if rnd() < 0.12 then spawn_item("potion", p.x, p.y) end
end

local function sword_hit()
  local h = hero
  local fx_, fy_ = DX[h.k], DY[h.k]
  local fl = sqrt(fx_ * fx_ + fy_ * fy_)
  fx_, fy_ = fx_ / fl, fy_ / fl
  local reach = 16
  for i = 1, #enemies do
    local e = enemies[i]
    if not e.dead then
      local dx, dy = e.x - h.x, e.y - h.y
      local d = sqrt(dx * dx + dy * dy)
      if d < reach + e.r and (d < 6 + e.r or (dx * fx_ + dy * fy_) / d > 0.2) then
        hurt_enemy(e, 2, dx / math.max(d, 0.1), dy / math.max(d, 0.1))
      end
    end
  end
  for i = 1, #chests do
    local c = chests[i]
    local dx, dy = c.x - h.x, c.y - h.y
    local d = sqrt(dx * dx + dy * dy)
    if not c.open and d < 17 and (dx * fx_ + dy * fy_) / math.max(d, 0.1) > 0.1 then open_chest(c) end
  end
  for i = 1, #pots do
    local p = pots[i]
    if not p.dead then
      local dx, dy = p.x - h.x, p.y - h.y
      local d = sqrt(dx * dx + dy * dy)
      if d < 15 and (dx * fx_ + dy * fy_) / math.max(d, 0.1) > 0.1 then break_pot(p) end
    end
  end
end

-- =========================================================================
-- ENEMY AI
-- =========================================================================
local OFFS = { 0, 0.7, -0.7, 1.4, -1.4 }
local function steer(e, dx, dy, spd)
  local d = sqrt(dx * dx + dy * dy)
  if d < 0.001 then return end
  local ux, uy = dx / d, dy / d
  for i = 1, 5 do
    local o = OFFS[i]
    local c, s = cos(o), sin(o)
    local vx, vy = (ux * c - uy * s) * spd, (ux * s + uy * c) * spd
    if not blocked_box(e.x + vx, e.y + vy, e.r) then e.x = e.x + vx; e.y = e.y + vy; return end
  end
end
local function slide(e, vx, vy)
  if vx ~= 0 and not blocked_box(e.x + vx, e.y, e.r) then e.x = e.x + vx end
  if vy ~= 0 and not blocked_box(e.x, e.y + vy, e.r) then e.y = e.y + vy end
end

local function enemy_update(e)
  local h = hero
  if e.hurt > 0 then e.hurt = e.hurt - 1 end
  if e.cd > 0 then e.cd = e.cd - 1 end
  e.anim = e.anim + 1
  -- knockback always applies
  if abs(e.kx) > 0.05 or abs(e.ky) > 0.05 then slide(e, e.kx, e.ky); e.kx = e.kx * 0.7; e.ky = e.ky * 0.7 end
  if e.stun > 0 then e.stun = e.stun - 1; return end
  local dx, dy = h.x - e.x, h.y - e.y
  local d = sqrt(dx * dx + dy * dy)
  local def = EDEF[e.kind]
  local k = e.kind

  if e.st == "idle" then
    if k == "bat" then e.z = FZ + 6 + sin(e.anim * 0.12 + e.ph) * 1.5 end
    if d < def.det and not h.dead and los(e.x, e.y, h.x, h.y) then
      e.st = "chase"
      if k == "golem" then say("THE CRYPT GOLEM AWAKENS!", 110); cam.shake = 8; tone("noise", 120, 40, 0.8, 0.4, 0); tone("saw", 90, 50, 0.9, 0.3, 1) end
      if k == "skel" then snd("square", 220, 140, 0.12, 0.2) end
    end
    return
  end
  if h.dead then return end
  if d > 130 and k ~= "golem" then e.st = "idle"; return end
  if d > 1 then e.k = dirk(dx, dy) end

  if k == "skel" then
    if e.st == "chase" then
      steer(e, dx, dy, def.spd)
      if d < 11 and e.cd <= 0 then e.st = "windup"; e.tm = 12 end
    elseif e.st == "windup" then
      e.tm = e.tm - 1
      if e.tm <= 0 then
        snd("saw", 500, 200, 0.1, 0.2)
        if d < 15 then hurt_hero(1, e.x, e.y) end
        e.st = "chase"; e.cd = 38
      end
    end
  elseif k == "bat" then
    e.z = FZ + 5 + sin(e.anim * 0.3 + e.ph) * 2
    if e.st == "chase" then
      steer(e, dx + sin(e.anim * 0.2 + e.ph) * 14, dy + cos(e.anim * 0.23 + e.ph) * 14, def.spd)
      if d < 6.5 then
        if hurt_hero(1, e.x, e.y) then e.st = "retreat"; e.tm = 24 end
      end
    elseif e.st == "retreat" then
      steer(e, -dx + sin(e.anim * 0.3) * 20, -dy + cos(e.anim * 0.3) * 20, def.spd * 1.1)
      e.tm = e.tm - 1
      if e.tm <= 0 then e.st = "chase" end
    end
  elseif k == "slime" then
    if e.st == "chase" then
      if e.cd <= 0 then e.st = "hop"; e.tm = 14; e.hdx, e.hdy = dx / math.max(d, 0.1), dy / math.max(d, 0.1) ; snd("square", 180, 320, 0.06, 0.15) end
    elseif e.st == "hop" then
      e.tm = e.tm - 1
      local pr = 1 - e.tm / 14
      e.z = FZ + sin(pr * PI) * 5
      slide(e, e.hdx * def.spd * 1.5, e.hdy * def.spd * 1.5)
      if d < 7 then hurt_hero(1, e.x, e.y) end
      if e.tm <= 0 then e.st = "chase"; e.z = FZ; e.cd = 22 + floor(rnd(14)) end
    end
  elseif k == "golem" then
    local rage = e.hp < e.maxhp * 0.5
    if rage and not e.phase2 then
      e.phase2 = true
      say("THE GOLEM ROARS IN RAGE!", 100)
      cam.shake = 10
      tone("noise", 200, 60, 0.7, 0.4, 0)
      spawn_item("potion", e.x - 22, e.y, -0.5, 0, 2.4); spawn_item("potion", e.x + 22, e.y, 0.5, 0, 2.4)
    end
    if e.st == "chase" then
      steer(e, dx, dy, rage and 0.62 or def.spd)
      if d < 24 and e.cd <= 0 then e.st = "windup"; e.tm = 22 end
      if rage and d > 34 and d < 80 and e.cd <= 0 and rnd() < 0.05 then e.st = "charge_wind"; e.tm = 18; e.cdx, e.cdy = dx / d, dy / d end
    elseif e.st == "windup" then
      e.tm = e.tm - 1
      if e.tm <= 0 then
        e.st = "chase"; e.cd = rage and 38 or 56
        cam.shake = 9
        snd("noise", 200, 30, 0.35, 0.4)
        burst(e.x + cos(e.k * PI / 4) * 12, e.y + sin(e.k * PI / 4) * 12, FZ + 2, 30, { 236, 237, 238, C_STONEHI }, 2.2, 1.6)
        for a = 0, 11 do
          local ang = a * PI / 6
          particle(e.x + cos(ang) * 22, e.y + sin(ang) * 22, FZ + 1, C_RUNE, 0.4)
        end
        if dist(h.x, h.y, e.x, e.y) < 26 then hurt_hero(2, e.x, e.y) end
      end
    elseif e.st == "charge_wind" then
      e.tm = e.tm - 1
      if e.tm <= 0 then e.st = "charge"; e.tm = 14 end
    elseif e.st == "charge" then
      e.tm = e.tm - 1
      local vx, vy = e.cdx * 2.3, e.cdy * 2.3
      local ox, oy = e.x, e.y
      slide(e, vx, vy)
      particle(e.x - e.cdx * 6, e.y - e.cdy * 6, FZ + 2, C_STONEHI, 0.3)
      if dist(h.x, h.y, e.x, e.y) < 14 then hurt_hero(2, e.x, e.y) end
      if (abs(e.x - ox) + abs(e.y - oy)) < 1.0 or e.tm <= 0 then
        e.st = "chase"; e.cd = 24
        if e.tm > 0 then e.stun = 36; cam.shake = 10; snd("noise", 260, 50, 0.3, 0.35); burst(e.x, e.y, FZ + 8, 20, { 236, 238, C_STONEHI }, 1.8, 1.5) end
      end
    end
  end
end

local function enemies_update()
  for i = 1, #enemies do enemy_update(enemies[i]) end
  -- gentle separation so packs don't stack on one voxel
  for i = 1, #enemies do
    local a = enemies[i]
    if not a.dead and a.st ~= "idle" then
      for j = i + 1, #enemies do
        local b = enemies[j]
        if not b.dead and b.st ~= "idle" and a.kind ~= "golem" and b.kind ~= "golem" then
          local dx, dy = b.x - a.x, b.y - a.y
          local d = sqrt(dx * dx + dy * dy)
          if d < 6 and d > 0.01 then
            local p = (6 - d) * 0.25
            slide(a, -dx / d * p, -dy / d * p); slide(b, dx / d * p, dy / d * p)
          end
        end
      end
    end
  end
  for i = #enemies, 1, -1 do if enemies[i].dead then table.remove(enemies, i) end end
end

-- =========================================================================
-- HERO
-- =========================================================================
local function hero_update()
  local h = hero
  if h.inv > 0 then h.inv = h.inv - 1 end
  if h.hurt > 0 then h.hurt = h.hurt - 1 end
  if h.swing_cd > 0 then h.swing_cd = h.swing_cd - 1 end
  if h.roll_cd > 0 then h.roll_cd = h.roll_cd - 1 end

  local ix = (btn(1) and 1 or 0) - (btn(0) and 1 or 0)
  local iy = (btn(2) and 1 or 0) - (btn(3) and 1 or 0)
  local il = sqrt(ix * ix + iy * iy)
  if il > 0 then ix, iy = ix / il, iy / il end
  h.moving = il > 0

  -- knockback
  if abs(h.kx) > 0.05 or abs(h.ky) > 0.05 then
    if not blocked_box(h.x + h.kx, h.y, 2.5) then h.x = h.x + h.kx end
    if not blocked_box(h.x, h.y + h.ky, 2.5) then h.y = h.y + h.ky end
    h.kx = h.kx * 0.65; h.ky = h.ky * 0.65
  end

  if h.roll > 0 then
    h.roll = h.roll - 1
    local vx, vy = h.rdx * 2.5, h.rdy * 2.5
    if not blocked_box(h.x + vx, h.y, 2.5) then h.x = h.x + vx end
    if not blocked_box(h.x, h.y + vy, 2.5) then h.y = h.y + vy end
    for _ = 1, 2 do particle(h.x - h.rdx * rr(1, 4) + rr(-2, 2), h.y - h.rdy * rr(1, 4) + rr(-2, 2), FZ + rr(0, 3), pick({ C_BONED, C_STONEHI, C_STONE2 }), 0.35) end
    return
  end

  if btnp(5) and h.roll_cd <= 0 then
    local rx, ry = ix, iy
    if il == 0 then rx, ry = DX[h.k], DY[h.k]; local l = sqrt(rx * rx + ry * ry); rx, ry = rx / l, ry / l end
    h.rdx, h.rdy = rx, ry
    h.k = dirk(rx, ry)
    h.roll = 9; h.roll_cd = 22; h.inv = math.max(h.inv, 12); h.swing = 0
    snd("noise", 300, 900, 0.18, 0.2)
    for _ = 1, 6 do particle(h.x + rr(-3, 3), h.y + rr(-3, 3), FZ + rr(0, 4), C_BONED, 0.4) end
    return
  end

  if btnp(4) and h.swing == 0 and h.swing_cd <= 0 then
    h.swing = 9; h.swing_cd = 13; h.hit_done = false
    snd("noise", 1400, 320, 0.13, 0.22)
    tone("saw", 700, 260, 0.11, 0.18, 2)
  end

  local spd = 1.15
  if h.swing > 0 then
    h.swing = h.swing - 1
    spd = 0.35
    if not h.hit_done and h.swing <= 7 then h.hit_done = true; sword_hit() end
    -- slash sparks
    local a = h.k * PI / 4 + (4.5 - h.swing) * 0.3
    particle(h.x + cos(a) * 14, h.y + sin(a) * 14, FZ + 8, C_WHITE, 0.2)
    particle(h.x + cos(a) * 11, h.y + sin(a) * 11, FZ + 8, C_STEELB, 0.2)
  end
  if il > 0 then
    if h.swing == 0 then h.k = dirk(ix, iy) end
    local vx, vy = ix * spd, iy * spd
    if not blocked_box(h.x + vx, h.y, 2.5) then h.x = h.x + vx end
    if not blocked_box(h.x, h.y + vy, 2.5) then h.y = h.y + vy end
  end
end

-- spike plates cycle: 0 retracted, 1 warning, 2 extended
local function spike_state(tx, ty)
  local ph = (tk + tx * 24 + ty * 5) % 90
  if ph < 50 then return 0 elseif ph < 65 then return 1 end
  return 2
end

-- =========================================================================
-- ITEMS, EFFECTS, TRAPS, DOORS
-- =========================================================================
local function items_update()
  local h = hero
  for i = #items, 1, -1 do
    local it = items[i]
    it.age = it.age + 1
    if it.z > FZ or it.vz > 0 then
      it.vz = it.vz - 0.3
      it.z = it.z + it.vz
      if it.z <= FZ then it.z = FZ; if abs(it.vz) > 0.9 then it.vz = -it.vz * 0.45 else it.vz = 0 end end
    end
    if abs(it.vx) > 0.02 or abs(it.vy) > 0.02 then
      local nx, ny = it.x + it.vx, it.y + it.vy
      if wall_at(nx, it.y) then it.vx = -it.vx * 0.3 else it.x = nx end
      if wall_at(it.x, ny) then it.vy = -it.vy * 0.3 else it.y = ny end
      if it.z <= FZ then it.vx = it.vx * 0.85; it.vy = it.vy * 0.85 end
    end
    local d = dist(it.x, it.y, h.x, h.y)
    if it.age > 14 and d < 20 and it.kind ~= "key" and (it.kind ~= "potion" or h.hp < h.maxhp) then
      it.x = it.x + (h.x - it.x) * 0.2; it.y = it.y + (h.y - it.y) * 0.2
    end
    if it.age > 8 and d < 7 and not h.dead then
      if it.kind == "coin" then
        h.gold = h.gold + 1
        snd("square", 988, 1480, 0.07, 0.15)
        table.remove(items, i)
      elseif it.kind == "potion" then
        if h.hp < h.maxhp then
          h.hp = math.min(h.maxhp, h.hp + 4)
          popup(h.x, h.y, FZ + 18, "+HEALTH", 234)
          snd("triangle", 440, 880, 0.25, 0.3); snd("triangle", 660, 1320, 0.3, 0.2)
          burst(h.x, h.y, FZ + 6, 10, { C_PINK, C_RED, 234 }, 1.0, 1.6)
          table.remove(items, i)
        end
      elseif it.kind == "key" then
        h.key = true
        say("GOLDEN KEY  -  THE VAULT AWAITS", 140)
        popup(h.x, h.y, FZ + 18, "KEY!", C_GOLDL)
        tone("triangle", 660, 990, 0.2, 0.35, 0); tone("triangle", 990, 1320, 0.3, 0.35, 1)
        burst(h.x, h.y, FZ + 10, 14, { C_GOLD, C_GOLDL, C_WHITE }, 1.4, 2)
        table.remove(items, i)
      end
    end
  end
end

local function fx_update()
  for i = #fx, 1, -1 do
    local p = fx[i]
    p.life = p.life - 1
    p.vz = p.vz - 0.12
    p.x = p.x + p.vx; p.y = p.y + p.vy; p.z = p.z + p.vz
    if p.z <= FZ then p.z = FZ; p.vz = -p.vz * 0.4; p.vx = p.vx * 0.7; p.vy = p.vy * 0.7 end
    if p.life <= 0 then table.remove(fx, i) end
  end
  for i = #pops, 1, -1 do
    local p = pops[i]
    p.life = p.life - 1; p.z = p.z + 0.5
    if p.life <= 0 then table.remove(pops, i) end
  end
  if cam.shake > 0 then cam.shake = cam.shake - 1 end
  if flash_t > 0 then flash_t = flash_t - 1 end
  if msg.t > 0 then msg.t = msg.t - 1 end
  if banner.t > 0 then banner.t = banner.t - 1 end
end

local function traps_update()
  local h = hero
  local tx, ty = vtile(h.x, h.y)
  if g[ty] and g[ty][tx] == 'S' and spike_state(tx, ty) == 2 then
    local cx, cy = tcenter(tx, ty)
    hurt_hero(2, cx, cy)
  end
end

local function gate_update()
  local h = hero
  local gx, gy = OX + 20 * TS + 8, OY + 20 * TS + 4
  h.seal_cd = (h.seal_cd or 0) - 1
  if gate_open == 0 and not h.opening then
    if dist(h.x, h.y, gx, gy) < 20 then
      if h.key then
        h.opening = true
        say("THE VAULT GATE GRINDS OPEN...", 120)
        tone("noise", 120, 60, 1.0, 0.35, 0); tone("saw", 80, 50, 1.0, 0.2, 1)
      elseif (h.seal_cd or 0) <= 0 then
        h.seal_cd = 110
        say("THE VAULT IS SEALED  -  FIND THE GOLDEN KEY", 100)
        snd("square", 160, 120, 0.15, 0.2)
      end
    end
  end
  if h.opening and gate_open < 1 then
    gate_open = math.min(1, gate_open + 1 / 40)
    cam.shake = math.max(cam.shake, 2)
    draw_gate()
    if tk % 3 == 0 then burst(gx, gy, FZ + 3, 2, { C_STONE2, C_STONEHI }, 0.8, 0.8) end
    if gate_open >= 1 then
      g[20][20] = '.'; g[20][21] = '.'
      h.opening = false
    end
  end
end

local function room_update()
  local tx, ty = vtile(hero.x, hero.y)
  local a = area_at(tx, ty)
  if a ~= 0 and a ~= cur_area then
    cur_area = a
    areas[a].seen = true
    banner.text = areas[a].name; banner.t = 80
  end
end

local function relic_update()
  if scene ~= "play" then return end
  if dist(hero.x, hero.y, relic_x, relic_y) < 15 and hero.y < relic_y + 2 then win_game("relic") end
end

-- =========================================================================
-- LIFECYCLE
-- =========================================================================
function _init()
  new_game()
  scene = "title"
  tk = 0
  cam.x, cam.y, cam.zoom = 128, 130, 1.1
end

local function reset_run()
  new_game()
  scene = "play"
  banner.text = areas[1].name; banner.t = 80
  cur_area = 1; areas[1].seen = true
  say("Z/SPACE: SWORD   X: ROLL   ARROWS: MOVE", 150)
end

function _update()
  tk = tk + 1
  scene_t = scene_t + 1
  fx_update()
  if scene == "title" then
    cam.x = 128 + sin(tk * 0.012) * 40
    cam.y = 128 + cos(tk * 0.009) * 30
    if btnp(4) or btnp(5) then
      reset_run()
      cam.zoom = 1.1
      tone("triangle", 330, 660, 0.2, 0.3, 0); tone("triangle", 660, 990, 0.3, 0.3, 1)
    end
  elseif scene == "play" then
    play_t = play_t + 1
    hero_update()
    enemies_update()
    items_update()
    traps_update()
    gate_update()
    room_update()
    relic_update()
    if golem_dead_t > 0 then
      golem_dead_t = golem_dead_t - 1
      if golem_dead_t == 0 then win_game("golem") end
    end
    for i = #pots, 1, -1 do if pots[i].dead then table.remove(pots, i) end end
    for i = 1, #chests do if chests[i].pop > 0 then chests[i].pop = chests[i].pop - 1 end end
    -- camera follow
    cam.x = cam.x + (hero.x - cam.x) * 0.22
    cam.y = cam.y + (hero.y - cam.y) * 0.22
    cam.zoom = cam.zoom + (ZOOM - cam.zoom) * 0.06
    -- torch sparks
    if tk % 6 == 0 then
      local tt = torches[1 + floor(rnd(#torches))]
      if tt and dist(OX + tt.tx * TS, OY + tt.ty * TS, hero.x, hero.y) < 140 then
        particle(OX + tt.tx * TS + 4 + rr(-1, 1), OY + tt.ty * TS - 2, 10 + rr(0, 5), C_FLAME, 0.5)
      end
    end
  elseif scene == "dead" then
    cam.x = cam.x + (hero.x - cam.x) * 0.05
    cam.y = cam.y + (hero.y - cam.y) * 0.05
    items_update()
    if scene_t > 45 and btnp(4) then reset_run(); cam.x, cam.y = hero.x, hero.y end
  elseif scene == "win" then
    cam.x = cam.x + (relic_x - cam.x) * 0.03
    cam.y = cam.y + (relic_y - 8 - cam.y) * 0.03
    cam.zoom = cam.zoom + (1.4 - cam.zoom) * 0.02
    if scene_t % 3 == 0 then
      burst(relic_x + rr(-30, 30), relic_y + rr(-8, 8), FZ + 22, 3, { C_GOLD, C_GOLDL, C_WHITE, C_PINK, 219 }, 0.6, -0.2)
    end
    if scene_t > 60 and btnp(4) then _init() end
  end
end

-- =========================================================================
-- DRAWING
-- =========================================================================
local function flash_on() for c = 200, 255 do pswap(c, C_WHITE) end end
local function flash_off() pswap() end

local function shadow(x, y, rx, ry)
  box(floor(x - rx), floor(y - ry), 1, floor(x + rx), floor(y + ry), 1, C_SHADOW)
end

local function in_view(x, y)
  return abs(x - cam.x) < 200 / cam.zoom + 40 and abs(y - cam.y) < 200 / cam.zoom + 40
end

local function draw_torches()
  local tt = t()
  for i = 1, #torches do
    local tc = torches[i]
    local x, y = OX + tc.tx * TS + 4, OY + tc.ty * TS - 2
    if in_view(x, y) then
      local fl = noise3(tt * 7 + i * 3.1, i * 1.7, 0)
      local ht = 9 + fl * 1.2
      sphere(x, y, ht, 1.6, C_FLAME)
      sphere(x, y, ht + 1, 1.1, C_FLAMEL)
      vset(x, y, ht + 3, C_FLAMER)
      if fl > 0.2 then vset(x + 1, y, ht + 2, C_FLAMER) end
      -- warm light on the wall around the sconce
      vset(x - 2, y + 1, 8, C_FLAME); vset(x + 2, y + 1, 8, C_FLAME)
    end
  end
end

local function draw_spikes()
  for ty = 2, 8 do for tx = 22, 24 do
    local cx, cy = tcenter(tx, ty)
    if in_view(cx, cy) then
      local s = spike_state(tx, ty)
      if s > 0 then
        local top = s == 2 and FZ + 4 or FZ + 1
        for _, p in ipairs({ { -3, -3 }, { 2, -3 }, { -3, 2 }, { 2, 2 } }) do
          local sx, sy = floor(cx + p[1]), floor(cy + p[2])
          box(sx, sy, FZ, sx + 1, sy + 1, top - 1, C_STEEL)
          vset(sx, sy, top, C_STEELB); vset(sx + 1, sy, top, C_STEELB)
          if s == 2 then vset(sx, sy, top + 1, C_WHITE) end
        end
      end
    end
  end end
end

local function draw_chests()
  for i = 1, #chests do
    local c = chests[i]
    if in_view(c.x, c.y) then
      local z = FZ
      if c.pop > 0 then z = FZ + sin(c.pop / 12 * PI) * 1.5 end
      shadow(c.x, c.y, 5, 4)
      model(c.open and "chestopen" or "chest", c.x, c.y, z, -PI / 2)
      if c.loot == "key" and not c.open then
        -- a faint golden glimmer so players know this one is special
        local g2 = noise3(t() * 5, 4, 1)
        if g2 > 0.1 then vset(c.x + rr(-3, 3), c.y + rr(-3, 3), FZ + 9, C_GOLDL) end
      end
    end
  end
end

local function draw_pots()
  for i = 1, #pots do
    local p = pots[i]
    if in_view(p.x, p.y) then shadow(p.x, p.y, 3, 3); model("pot", p.x, p.y, FZ) end
  end
end

local function draw_items()
  local tt = t()
  for i = 1, #items do
    local it = items[i]
    if in_view(it.x, it.y) then
      local bob = (it.z <= FZ + 0.1) and (1.2 + sin(tt * 5 + i) * 0.8) or 0
      local z = it.z + bob
      if it.kind == "coin" then
        local f = floor(tt * 6 + i) % 4
        local x, y = floor(it.x), floor(it.y)
        if f == 0 or f == 2 then box(x - 1, y, z, x + 1, y, z + 2, C_GOLDL); vset(x, y, z + 1, C_GOLD)
        elseif f == 1 then box(x, y - 1, z, x, y + 1, z + 2, C_GOLD); vset(x, y, z + 1, C_GOLDD)
        else box(x - 1, y, z, x + 1, y, z + 2, C_GOLDL); vset(x, y, z + 1, C_GOLD) end
        vset(x, y, z + 3, C_GOLDL)
      elseif it.kind == "potion" then
        shadow(it.x, it.y, 2, 2)
        model("potion", it.x, it.y, z)
        if noise3(tt * 6, i, 2) > 0.2 then vset(it.x + 2, it.y, z + 9, C_WHITE) end
      elseif it.kind == "key" then
        shadow(it.x, it.y, 3, 2)
        model("key", it.x, it.y, z + 2, floor(tt * 3) * PI / 2)
        sphere(it.x, it.y, z + 7, 0.8, C_GOLDL)
      end
    end
  end
end

local function draw_spark_ring(e, rad, c)
  for a = 0, 15 do
    local ang = a * PI / 8
    vset(e.x + cos(ang) * rad, e.y + sin(ang) * rad, FZ, c)
  end
end

local function draw_enemies()
  for i = 1, #enemies do
    local e = enemies[i]
    if in_view(e.x, e.y) and not e.dead then
      local fl = e.hurt > 0
      local rot = e.k * PI / 4
      if e.kind == "skel" then
        shadow(e.x, e.y, 4, 3)
        local fr = (e.st == "chase" or e.st == "windup") and (floor(t() * 6) % 2) or 0
        if fl then flash_on() end
        if e.st == "windup" and floor(t() * 20) % 2 == 0 then pswap(C_STEELD, C_FLAMEL); pswap(233, C_FLAMEL) end
        model("skel", e.x, e.y, FZ, rot, false, fr)
        if fl or e.st == "windup" then flash_off() end
      elseif e.kind == "bat" then
        shadow(e.x, e.y, 3, 3)
        if fl then flash_on() end
        model("bat", e.x, e.y, e.z, rot, false, e.st == "idle" and (floor(t() * 3) % 2) or (floor(t() * 14) % 2))
        if fl then flash_off() end
      elseif e.kind == "slime" then
        shadow(e.x, e.y, 5, 5)
        if fl then flash_on() end
        local fr = (e.st == "hop" and 0) or (floor(t() * 3 + e.ph) % 2)
        model("slime", e.x, e.y, e.z, rot, false, fr)
        if fl then flash_off() end
      elseif e.kind == "golem" then
        shadow(e.x, e.y, 8, 6)
        local fr = 0
        if e.st == "chase" or e.st == "charge" then fr = 1 + (floor(t() * 4) % 2)
        elseif e.st == "windup" or e.st == "charge_wind" then fr = 3 end
        if fl then flash_on() end
        if e.st == "windup" and floor(t() * 16) % 2 == 0 then pswap(C_RUNE, C_PINK) end
        model("golem", e.x, e.y, FZ, e.k * PI / 4, false, fr)
        if fl or e.st == "windup" then flash_off() end
        if e.st == "windup" then
          local pr = 1 - e.tm / 22
          draw_spark_ring(e, 4 + 22 * pr, C_PINK); draw_spark_ring(e, 22, C_RUNE)
        elseif e.st == "charge_wind" then
          for s = 4, 60, 4 do vset(e.x + e.cdx * s, e.y + e.cdy * s, FZ, C_PINK) end
        end
      end
    end
  end
end

local function draw_hero()
  local h = hero
  if h.dead then
    shadow(h.x, h.y, 6, 4)
    model("hero", h.x, h.y, FZ, h.k * PI / 4 + PI / 2)
    return
  end
  if h.inv > 0 and h.roll == 0 and tk % 4 < 2 and scene == "play" then return end
  shadow(h.x, h.y, 4, 3)
  local rot = h.k * PI / 4
  local fl = h.hurt > 0
  if fl then flash_on() end
  if h.roll > 0 then
    local pr = 1 - h.roll / 9
    model("hero", h.x, h.y, FZ - 1, rot + pr * 2 * PI, false, 0)
    line3d(h.x, h.y, FZ + 6, h.x - h.rdx * 10, h.y - h.rdy * 10, FZ + 6, C_BONED)
    line3d(h.x, h.y + 2, FZ + 9, h.x - h.rdx * 8, h.y + 2 - h.rdy * 8, FZ + 9, C_STONEHI)
  else
    local fr = h.moving and (1 + floor(t() * 8) % 2) or 0
    model("hero", h.x, h.y, FZ, rot, false, fr)
  end
  if fl then flash_off() end
  -- sword swing arc
  if h.swing > 0 then
    local a0 = h.k * PI / 4
    local prog = (9 - h.swing) / 9
    local R, z = 14, FZ + 8
    local cur = a0 - 1.1 + prog * 2.2
    local steps = 8
    for s = 0, steps do
      local a = cur - s * 0.16
      if a >= a0 - 1.1 then
        local a2 = a - 0.16
        local c = s < 2 and C_WHITE or (s < 5 and C_STEELB or C_STEEL)
        line3d(h.x + cos(a) * R, h.y + sin(a) * R, z, h.x + cos(a2) * R, h.y + sin(a2) * R, z, c)
        line3d(h.x + cos(a) * (R - 3), h.y + sin(a) * (R - 3), z, h.x + cos(a2) * (R - 3), h.y + sin(a2) * (R - 3), z, c)
      end
    end
    line3d(h.x + cos(cur) * 4, h.y + sin(cur) * 4, z, h.x + cos(cur) * (R + 2), h.y + sin(cur) * (R + 2), z, C_WHITE)
  end
end

local function draw_relic()
  local tt = t()
  local z = relic_z + sin(tt * 2.5) * 1.5
  shadow(relic_x, relic_y, 3, 3)
  local glow = 0.5 + 0.5 * sin(tt * 4)
  sphere(relic_x, relic_y, z + 2, 3.2, C_GOLD)
  sphere(relic_x, relic_y, z + 3, 2.2, C_GOLDL)
  box(relic_x - 1, relic_y - 1, z - 3, relic_x + 1, relic_y + 1, z - 1, C_GOLDD)
  box(relic_x - 2, relic_y, z + 6, relic_x + 2, relic_y, z + 6, C_GOLDL)
  vset(relic_x, relic_y, z + 7, C_WHITE)
  if glow > 0.5 then for a = 0, 5 do local ang = a * PI / 3 + tt * 2 vset(relic_x + cos(ang) * 6, relic_y + sin(ang) * 6, z + 2, C_FLAMEL) end end
  if golem and not golem.dead then box(relic_x - 6, relic_y - 6, FZ + 5, relic_x + 6, relic_y + 6, FZ + 5, 0) end
end

local function draw_fx()
  for i = 1, #fx do
    local p = fx[i]
    if in_view(p.x, p.y) then vset(p.x, p.y, p.z, p.c) end
  end
end

-- ---- HUD ---------------------------------------------------------------
local HEART = { ".XX.XX.", "XXXXXXX", "XXXXXXX", ".XXXXX.", "..XXX..", "...X..." }
local HRUNS = {}
for r = 1, #HEART do
  local row, c = HEART[r], 1
  while c <= 7 do
    if row:sub(c, c) == 'X' then
      local s = c
      while c <= 7 and row:sub(c, c) == 'X' do c = c + 1 end
      HRUNS[#HRUNS + 1] = { s - 1, r - 1, c - s }
    else c = c + 1 end
  end
end

local function heart(x, y, s, fillv)
  for i = 1, #HRUNS do
    local r = HRUNS[i]
    rectfill(x + r[1] * s, y + r[2] * s, x + (r[1] + r[3]) * s - 1, y + (r[2] + 1) * s - 1, C_PANELB)
  end
  if fillv > 0 then
    local lim = fillv == 2 and 7 or 4
    for i = 1, #HRUNS do
      local r = HRUNS[i]
      local w = math.min(r[3], lim - r[1])
      if w > 0 then rectfill(x + r[1] * s, y + r[2] * s, x + (r[1] + w) * s - 1, y + (r[2] + 1) * s - 1, C_RED) end
    end
    rectfill(x + s, y + s, x + s * 2 - 1, y + s * 2 - 1, C_PINK)
  end
end

local function ctext(s, y, c, scale)
  scale = math.min(scale or 1, 4)        -- the HUD font supports scales 1..4
  print(s, floor((768 - textw(s) * scale) / 2), y, c, true, scale)
end

local function draw_hud()
  local h = hero
  -- panel
  rectfill(8, 8, 188, 62, C_PANEL); rect(8, 8, 188, 62, C_PANELB)
  local n = h.maxhp / 2
  for i = 1, n do
    local v = clamp(h.hp - (i - 1) * 2, 0, 2)
    heart(14 + (i - 1) * 25, 14, 3, v)
  end
  -- gold
  circfill(20, 49, 6, C_GOLDD); circfill(20, 49, 5, C_GOLD); circfill(19, 48, 2, C_GOLDL)
  print("x " .. h.gold, 32, 45, C_GOLDL, true, 1)
  -- key
  local kc = h.key and C_GOLDL or C_PANELB
  circfill(106, 49, 4, kc); circfill(106, 49, 2, C_PANEL)
  rectfill(110, 48, 124, 50, kc); rectfill(120, 50, 122, 54, kc); rectfill(114, 50, 116, 53, kc)
  print(h.key and "KEY" or "NO KEY", 130, 45, h.key and C_GOLDL or 216, true, 1)

  -- room title (top centre)
  if cur_area > 0 then
    local nm = areas[cur_area].name
    local w = textw(nm)
    rectfill(384 - w / 2 - 10, 8, 384 + w / 2 + 10, 24, C_PANEL); rect(384 - w / 2 - 10, 8, 384 + w / 2 + 10, 24, C_PANELB)
    print(nm, 384 - w / 2, 12, C_STONEHI, true, 1)
  end
  if banner.t > 0 and banner.t > 8 then
    local w = textw(banner.text) * 2
    rectfill(384 - w / 2 - 14, 78, 384 + w / 2 + 14, 112, C_PANEL); rect(384 - w / 2 - 14, 78, 384 + w / 2 + 14, 112, C_GOLDD)
    ctext(banner.text, 88, C_GOLDL, 2)
  end

  -- minimap (seen rooms only)
  local mx, my, mc = 768 - 98, 8, 3
  rectfill(mx - 4, my, mx + 90 + 2, my + 90 + 2, C_PANEL); rect(mx - 4, my, mx + 92, my + 92, C_PANELB)
  for i = 1, #areas do
    local a = areas[i]
    if a.seen then
      local col = (i == cur_area) and C_STONEHI or C_PANELB
      rectfill(mx + a.x0 * mc, my + 90 - (a.y1 + 1) * mc, mx + (a.x1 + 1) * mc - 1, my + 90 - a.y0 * mc - 1, col)
    end
  end
  if gate_open < 1 then
    rectfill(mx + 20 * mc, my + 90 - 21 * mc, mx + 22 * mc - 1, my + 90 - 20 * mc - 1, h.key and C_GOLDL or C_REDD)
  end
  if floor(t() * 3) % 2 == 0 then
    local hx, hy = vtile(h.x, h.y)
    rectfill(mx + hx * mc, my + 90 - (hy + 1) * mc, mx + hx * mc + 3, my + 90 - hy * mc + 1, C_RED)
  end

  -- boss bar
  if golem and not golem.dead and golem.st ~= "idle" then
    local w = 300
    local x0 = 384 - w / 2
    rectfill(x0 - 4, 380, x0 + w + 4, 404, C_PANEL); rect(x0 - 4, 380, x0 + w + 4, 404, C_PANELB)
    rectfill(x0, 394, x0 + w, 400, C_REDD)
    rectfill(x0, 394, x0 + floor(w * clamp(golem.hp / golem.maxhp, 0, 1)), 400, golem.phase2 and C_PINK or C_RED)
    ctext("CRYPT GOLEM", 383, C_RUNE, 1)
  end

  -- message line
  if msg.t > 0 then
    local w = textw(msg.text)
    rectfill(384 - w / 2 - 10, 352, 384 + w / 2 + 10, 372, C_PANEL); rect(384 - w / 2 - 10, 352, 384 + w / 2 + 10, 372, C_PANELB)
    print(msg.text, 384 - w / 2, 358, C_FLAMEL, true, 1)
  end

  -- damage pops
  for i = 1, #pops do
    local p = pops[i]
    local sx, sy = project(p.x, p.y, p.z)
    print(p.txt, sx - textw(p.txt) / 2, sy, p.c, true, 2)
  end

  -- hurt flash
  if flash_t > 0 then
    rectfill(0, 0, 767, 5, C_REDD); rectfill(0, 426, 767, 431, C_REDD); rectfill(0, 0, 5, 431, C_REDD); rectfill(762, 0, 767, 431, C_REDD)
  end
end

local function draw_title()
  rectfill(0, 56, 767, 186, C_PANEL); rect(0, 56, 767, 186, C_GOLDD); rect(0, 60, 767, 182, C_PANELB)
  ctext("CRYPT OF THE VOXEL", 74, C_GOLDL, 4)
  ctext("AN ACTION DUNGEON CRAWL", 124, C_STONEHI, 2)
  ctext("FIND THE GOLDEN KEY   OPEN THE VAULT   CLAIM THE ANCIENT RELIC", 156, C_FLAMEL, 1)
  if floor(t() * 2) % 2 == 0 then ctext("PRESS Z OR SPACE TO ENTER", 330, C_WHITE, 2) end
  rectfill(184, 372, 584, 408, C_PANEL); rect(184, 372, 584, 408, C_PANELB)
  ctext("ARROWS MOVE     Z / SPACE  SWORD     X / E  ROLL", 380, C_STONEHI, 1)
  ctext("ROLLING MAKES YOU INVULNERABLE FOR A MOMENT", 394, C_FLAMEL, 1)
end

local function draw_dead()
  rectfill(0, 150, 767, 270, C_PANEL); rect(0, 150, 767, 270, C_REDD); rect(0, 154, 767, 266, C_PANELB)
  ctext("YOU DIED", 176, C_RED, 4)
  ctext("GOLD COLLECTED: " .. hero.gold .. "     FOES SLAIN: " .. kills, 232, C_STONEHI, 1)
  if scene_t > 45 and floor(t() * 2) % 2 == 0 then ctext("PRESS Z OR SPACE TO TRY AGAIN", 252, C_WHITE, 1) end
end

local function draw_win()
  local secs = floor(play_t / 30)
  rectfill(0, 96, 767, 236, C_PANEL); rect(0, 96, 767, 236, C_GOLDD); rect(0, 100, 767, 232, C_PANELB)
  ctext("VICTORY", 112, C_GOLDL, 4)
  ctext(win_reason == "golem" and "THE CRYPT GOLEM LIES IN RUINS" or "YOU CLAIMED THE ANCIENT RELIC", 168, C_WHITE, 2)
  ctext("GOLD " .. hero.gold .. "     FOES SLAIN " .. kills .. "     TIME " .. floor(secs / 60) .. ":" .. string.format("%02d", secs % 60), 202, C_FLAMEL, 1)
  if scene_t > 60 and floor(t() * 2) % 2 == 0 then ctext("PRESS Z OR SPACE TO RETURN TO THE TITLE", 330, C_WHITE, 1) end
end

function _draw()
  cls()
  -- warm, flickering torchlight over a cold crypt
  local fl = noise3(t() * 6, 0.5, 0)
  sun(0.3, 0.4, 0.8, 0.9 + fl * 0.07)
  sky(C_BLACK, C_SHADOW)
  fog(C_FOG, 0.55)
  local sx, sy = 0, 0
  if cam.shake > 0 then sx, sy = rr(-1, 1) * cam.shake * 0.4, rr(-1, 1) * cam.shake * 0.4 end
  if scene == "title" then
    camera(cam.x, cam.y, 22, 1.1, 0)
  else
    camera(cam.x + sx, cam.y + sy, 22, cam.zoom, 0)
  end

  draw_torches()
  draw_spikes()
  draw_pots()
  draw_chests()
  draw_items()
  draw_enemies()
  draw_hero()
  draw_relic()
  draw_fx()

  if scene == "title" then draw_title()
  else
    draw_hud()
    if scene == "dead" then draw_dead() elseif scene == "win" then draw_win() end
  end
end
