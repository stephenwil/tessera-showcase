__lua__
-- Solaris Temple
-- Sun-drenched ancient desert sandstone & turquoise oasis optical temple.
-- Remixed from Prism Relay for Tessera High-Res (HQ lighting, 5 custom voxel models, tracker music).

local GRID_N = 7
local CELL = 16
local OX = 72
local OY = 72
local FLOOR_Z = 6
local BEAM_Z = 15

-- Cardinal directions: 0=East(+x), 1=North(+y), 2=West(-x), 3=South(-y)
local DX = { [0] = 1, [1] = 0, [2] = -1, [3] = 0 }
local DY = { [0] = 0, [1] = 1, [2] = 0, [3] = -1 }

-- Mirror reflections:
-- rot=0 ('/' SW-NE diagonal): E<->N, W<->S
-- rot=1 ('\' NW-SE diagonal): E<->S, W<->N
local REFLECT_SLASH = { [0] = 1, [1] = 0, [2] = 3, [3] = 2 }
local REFLECT_BACK  = { [0] = 3, [3] = 0, [2] = 1, [1] = 2 }

-- 5 Handcrafted Optical Temple Chambers
local CHAMBERS = {
  {
    roman = "I",
    name = "DAWN ATRIUM",
    start_cur = { 3, 6 },
    emitters = {
      { x = 1, y = 4, dir = 0, kind = "solar" },
    },
    mirrors = {
      { x = 3, y = 4, rot = 0 },
      { x = 3, y = 6, rot = 1 },
      { x = 4, y = 6, rot = 0 },
    },
    splitters = {},
    filters = {},
    pylons = {
      { x = 4, y = 2, req = "solar" },
    },
    walls = {
      { 2, 2 }, { 6, 5 },
    },
    pools = {
      { 4, 3 }, { 5, 3 }, { 4, 4 }, { 5, 4 },
    },
  },
  {
    roman = "II",
    name = "TWIN OASIS",
    start_cur = { 4, 6 },
    emitters = {
      { x = 1, y = 4, dir = 0, kind = "solar" },
    },
    mirrors = {
      { x = 4, y = 6, rot = 1 },
      { x = 4, y = 2, rot = 0 },
      { x = 6, y = 2, rot = 1 },
    },
    splitters = {
      { x = 4, y = 4 },
    },
    filters = {},
    pylons = {
      { x = 6, y = 6, req = "solar" },
      { x = 6, y = 4, req = "solar" },
    },
    walls = {
      { 3, 3 }, { 3, 5 },
    },
    pools = {
      { 2, 2 }, { 2, 6 }, { 5, 3 }, { 5, 5 },
    },
  },
  {
    roman = "III",
    name = "LUNAR SANCTUARY",
    start_cur = { 3, 6 },
    emitters = {
      { x = 1, y = 4, dir = 0, kind = "solar" },
    },
    mirrors = {
      { x = 3, y = 6, rot = 1 },
      { x = 6, y = 6, rot = 0 },
      { x = 3, y = 2, rot = 0 },
    },
    splitters = {
      { x = 3, y = 4 },
    },
    filters = {
      { x = 3, y = 3, axis = "v" },
    },
    pylons = {
      { x = 6, y = 5, req = "solar" },
      { x = 6, y = 2, req = "lunar" },
    },
    walls = {
      { 5, 5 }, { 2, 2 },
    },
    pools = {
      { 4, 3 }, { 4, 4 }, { 5, 4 }, { 4, 5 },
    },
  },
  {
    roman = "IV",
    name = "FOUR WINDS",
    start_cur = { 2, 3 },
    emitters = {
      { x = 4, y = 1, dir = 1, kind = "solar" },
    },
    mirrors = {
      { x = 2, y = 3, rot = 0 },
      { x = 2, y = 6, rot = 1 },
      { x = 6, y = 5, rot = 0 },
      { x = 6, y = 2, rot = 1 },
    },
    splitters = {
      { x = 4, y = 3 },
      { x = 6, y = 3 },
    },
    filters = {
      { x = 5, y = 3, axis = "h" },
    },
    pylons = {
      { x = 4, y = 6, req = "solar" },
      { x = 4, y = 5, req = "lunar" },
      { x = 5, y = 2, req = "lunar" },
    },
    walls = {
      { 3, 2 }, { 5, 4 },
    },
    pools = {
      { 1, 4 }, { 1, 5 }, { 3, 4 }, { 3, 5 },
    },
  },
  {
    roman = "V",
    name = "HEART OF SOLARIS",
    start_cur = { 4, 7 },
    emitters = {
      { x = 1, y = 5, dir = 0, kind = "solar" },
      { x = 7, y = 2, dir = 2, kind = "lunar" },
    },
    mirrors = {
      { x = 4, y = 7, rot = 1 },
      { x = 7, y = 7, rot = 0 },
      { x = 4, y = 3, rot = 1 },
      { x = 2, y = 3, rot = 0 },
      { x = 5, y = 4, rot = 1 },
      { x = 5, y = 1, rot = 1 },
    },
    splitters = {
      { x = 4, y = 5 },
      { x = 5, y = 2 },
    },
    filters = {},
    pylons = {
      { x = 7, y = 5, req = "solar" },
      { x = 2, y = 4, req = "solar" },
      { x = 7, y = 4, req = "lunar" },
      { x = 2, y = 1, req = "lunar" },
    },
    walls = {
      { 3, 4 }, { 6, 3 },
    },
    pools = {
      { 1, 2 }, { 1, 3 }, { 3, 6 }, { 6, 6 },
    },
  },
}

-- Runtime state
local chamber_idx = 1
local mirrors = {}
local pylons = {}
local splitters = {}
local emitters = {}
local filters = {}
local walls_map = {}
local pools_map = {}
local beam_segments = {}
local hit_points = {}
local undo_stack = {}

local cur_x, cur_y = 3, 6
local disp_x, disp_y = 3, 6
local moves = 0
local solved = false
local solved_timer = 0
local flash_timer = 0
local hold_timers = { [0] = 0, [1] = 0, [2] = 0, [3] = 0 }

local function cell_key(gx, gy)
  return gy * 16 + gx
end

local function cell_center(gx, gy)
  return OX + (gx - 1) * CELL + 8, OY + (gy - 1) * CELL + 8
end

local function find_mirror(gx, gy)
  for i = 1, #mirrors do
    local m = mirrors[i]
    if m.x == gx and m.y == gy then return m, i end
  end
  return nil, nil
end

local function find_splitter(gx, gy)
  for i = 1, #splitters do
    local s = splitters[i]
    if s.x == gx and s.y == gy then return s end
  end
  return nil
end

local function find_filter(gx, gy)
  for i = 1, #filters do
    local f = filters[i]
    if f.x == gx and f.y == gy then return f end
  end
  return nil
end

local function find_pylon(gx, gy)
  for i = 1, #pylons do
    local p = pylons[i]
    if p.x == gx and p.y == gy then return p end
  end
  return nil
end

local function find_emitter(gx, gy)
  for i = 1, #emitters do
    local e = emitters[i]
    if e.x == gx and e.y == gy then return e end
  end
  return nil
end

-- Optical ray tracer across the 7x7 chamber grid
local function trace_beams(play_audio)
  local prev_lit = {}
  for i = 1, #pylons do
    prev_lit[i] = pylons[i].lit
    pylons[i].lit = false
  end

  beam_segments = {}
  hit_points = {}
  local visited = {}
  local queue = {}

  for i = 1, #emitters do
    local e = emitters[i]
    queue[#queue + 1] = { x = e.x, y = e.y, dir = e.dir, kind = e.kind }
  end

  local head = 1
  local seg_limit = 64

  while head <= #queue and #beam_segments < seg_limit do
    local ray = queue[head]
    head = head + 1

    local rkey = ray.x .. "," .. ray.y .. "," .. ray.dir .. "," .. ray.kind
    if not visited[rkey] then
      visited[rkey] = true
      local cx, cy = ray.x, ray.y
      local dir = ray.dir
      local kind = ray.kind
      local sx, sy = cell_center(cx, cy)

      for step = 1, GRID_N + 1 do
        local nx = cx + DX[dir]
        local ny = cy + DY[dir]

        if nx < 1 or nx > GRID_N or ny < 1 or ny > GRID_N then
          local ex = sx + DX[dir] * (step * CELL - 4)
          local ey = sy + DY[dir] * (step * CELL - 4)
          beam_segments[#beam_segments + 1] = {
            x0 = sx, y0 = sy, x1 = ex, y1 = ey, kind = kind,
          }
          break
        end

        local tx, ty = cell_center(nx, ny)
        local key = cell_key(nx, ny)

        if walls_map[key] or find_emitter(nx, ny) then
          beam_segments[#beam_segments + 1] = {
            x0 = sx, y0 = sy,
            x1 = tx - DX[dir] * 6, y1 = ty - DY[dir] * 6,
            kind = kind,
          }
          hit_points[#hit_points + 1] = {
            x = tx - DX[dir] * 6, y = ty - DY[dir] * 6, kind = kind,
          }
          break
        end

        local flt = find_filter(nx, ny)
        if flt and kind ~= "lunar" then
          beam_segments[#beam_segments + 1] = {
            x0 = sx, y0 = sy, x1 = tx, y1 = ty, kind = kind,
          }
          hit_points[#hit_points + 1] = { x = tx, y = ty, kind = "lunar" }
          queue[#queue + 1] = { x = nx, y = ny, dir = dir, kind = "lunar" }
          break
        end

        local mir = find_mirror(nx, ny)
        if mir then
          beam_segments[#beam_segments + 1] = {
            x0 = sx, y0 = sy, x1 = tx, y1 = ty, kind = kind,
          }
          hit_points[#hit_points + 1] = { x = tx, y = ty, kind = kind }
          local ndir = (mir.rot == 0) and REFLECT_SLASH[dir] or REFLECT_BACK[dir]
          queue[#queue + 1] = { x = nx, y = ny, dir = ndir, kind = kind }
          break
        end

        local spl = find_splitter(nx, ny)
        if spl then
          beam_segments[#beam_segments + 1] = {
            x0 = sx, y0 = sy, x1 = tx, y1 = ty, kind = kind,
          }
          hit_points[#hit_points + 1] = { x = tx, y = ty, kind = kind }
          if dir == 0 or dir == 2 then
            queue[#queue + 1] = { x = nx, y = ny, dir = 1, kind = kind }
            queue[#queue + 1] = { x = nx, y = ny, dir = 3, kind = kind }
          else
            queue[#queue + 1] = { x = nx, y = ny, dir = 0, kind = kind }
            queue[#queue + 1] = { x = nx, y = ny, dir = 2, kind = kind }
          end
          break
        end

        local pyl = find_pylon(nx, ny)
        if pyl then
          beam_segments[#beam_segments + 1] = {
            x0 = sx, y0 = sy, x1 = tx, y1 = ty, kind = kind,
          }
          hit_points[#hit_points + 1] = { x = tx, y = ty, kind = kind }
          if pyl.req == "any" or pyl.req == kind then
            pyl.lit = true
          end
          break
        end

        cx, cy = nx, ny
      end
    end
  end

  local lit_count = 0
  local newly_lit = false
  for i = 1, #pylons do
    if pylons[i].lit then
      lit_count = lit_count + 1
      if not prev_lit[i] then
        newly_lit = true
      end
    end
  end

  local now_solved = (lit_count == #pylons and #pylons > 0)
  if play_audio then
    if now_solved and not solved then
      sfx(3)
      flash_timer = 1.0
      solved_timer = 0
    elseif newly_lit then
      sfx(2)
      flash_timer = 0.5
    end
  end
  solved = now_solved
end

-- Build the sun-drenched ancient sandstone & turquoise oasis temple map
local function build_chamber_map(ch)
  mclear()

  -- 1. Surrounding golden desert sand dunes across the full 256x256 world
  for y = 0, 248, 8 do
    for x = 0, 248, 8 do
      local dx = math.abs(x + 4 - 128)
      local dy = math.abs(y + 4 - 128)
      local d = math.max(dx, dy)
      if d >= 72 then
        local n = noise3(x * 0.025, y * 0.025, 0.4)
        local h = flr(mid(1, 3 + n * 4 + (d - 72) * 0.06, 8))
        local sand_c = (h >= 5) and 8 or ((h >= 3) and 7 or 6)
        mbox(x, y, 0, x + 7, y + 7, h, sand_c)
        if n > 0.35 then
          mbox(x + 1, y + 1, h, x + 6, y + 6, h, 9)
        end
      end
    end
  end

  -- 2. Outer temple sandstone foundation & grand stepped terrace
  mbox(50, 50, 0, 206, 206, 3, 5)
  mbox(54, 54, 4, 202, 202, 5, 7)
  mbox(54, 54, 5, 202, 56, 5, 8)
  mbox(54, 200, 5, 202, 202, 5, 8)
  mbox(54, 54, 5, 56, 202, 5, 8)
  mbox(200, 54, 5, 202, 202, 5, 8)

  -- Grand front approach stairs (South edge)
  mbox(108, 40, 0, 148, 53, 1, 6)
  mbox(112, 43, 2, 144, 53, 2, 7)
  mbox(116, 46, 3, 140, 53, 3, 8)
  mbox(120, 49, 4, 136, 53, 4, 9)
  mbox(106, 40, 0, 110, 53, 5, 6)
  mbox(146, 40, 0, 150, 53, 5, 6)
  mbox(107, 41, 6, 109, 43, 8, 17)
  mbox(147, 41, 6, 149, 43, 8, 17)

  -- 3. Encircling Turquoise Oasis Reflecting Moat (z=3..5)
  mbox(60, 60, 3, 196, 196, 3, 10)
  mbox(60, 60, 4, 196, 196, 4, 11)
  mbox(61, 61, 5, 195, 195, 5, 12)
  -- Ornamental stone bridges across the moat on all 4 sides
  mbox(120, 56, 4, 136, 72, 6, 8)
  mbox(122, 56, 6, 134, 72, 6, 9)
  mbox(120, 184, 4, 136, 200, 6, 8)
  mbox(122, 184, 6, 134, 200, 6, 9)
  mbox(56, 120, 4, 72, 136, 6, 8)
  mbox(184, 120, 4, 200, 136, 6, 8)

  -- 4. Central 7x7 Raised Sandstone Courtyard (x=70..186, y=70..186, z=0..6)
  mbox(69, 69, 0, 187, 187, 5, 5)
  mbox(70, 70, 5, 186, 186, 6, 7)
  mbox(70, 70, 6, 186, 71, 6, 24)
  mbox(70, 185, 6, 186, 186, 6, 24)
  mbox(70, 70, 6, 71, 186, 6, 24)
  mbox(185, 70, 6, 186, 186, 6, 24)

  -- Carve 7x7 checkerboard travertine & sandstone floor tiles
  for gy = 1, GRID_N do
    for gx = 1, GRID_N do
      local x0 = OX + (gx - 1) * CELL
      local y0 = OY + (gy - 1) * CELL
      local key = cell_key(gx, gy)
      if not pools_map[key] then
        local checker = ((gx + gy) % 2 == 0)
        local tile_c = checker and 8 or 7
        local rim_c  = checker and 6 or 5
        mbox(x0, y0, 6, x0 + 15, y0 + 15, 6, rim_c)
        mbox(x0 + 1, y0 + 1, 6, x0 + 14, y0 + 14, 6, tile_c)
        if checker then
          mbox(x0 + 3, y0 + 3, 6, x0 + 12, y0 + 12, 6, 9)
        end
      end
    end
  end

  -- Seamless sunken turquoise oasis pools (merge adjacent water cells without stone seams!)
  for gy = 1, GRID_N do
    for gx = 1, GRID_N do
      if pools_map[cell_key(gx, gy)] then
        local x0 = OX + (gx - 1) * CELL
        local y0 = OY + (gy - 1) * CELL
        local pad_w = pools_map[cell_key(gx - 1, gy)] and 0 or 1
        local pad_e = pools_map[cell_key(gx + 1, gy)] and 0 or 1
        local pad_s = pools_map[cell_key(gx, gy - 1)] and 0 or 1
        local pad_n = pools_map[cell_key(gx, gy + 1)] and 0 or 1
        mbox(x0, y0, 6, x0 + 15, y0 + 15, 6, 9)
        mbox(x0 + pad_w, y0 + pad_s, 4, x0 + 15 - pad_e, y0 + 15 - pad_n, 6, 0)
        mbox(x0 + pad_w, y0 + pad_s, 3, x0 + 15 - pad_e, y0 + 15 - pad_n, 3, 10)
        mbox(x0 + pad_w, y0 + pad_s, 4, x0 + 15 - pad_e, y0 + 15 - pad_n, 4, 11)
        mbox(x0 + pad_w, y0 + pad_s, 5, x0 + 15 - pad_e, y0 + 15 - pad_n, 5, 12)
      end
    end
  end

  -- 5. Gilded bronze & lapis turntable sockets beneath rotatable mirrors
  for i = 1, #mirrors do
    local m = mirrors[i]
    local wx, wy = cell_center(m.x, m.y)
    mbox(wx - 6, wy - 6, 6, wx + 6, wy + 6, 6, 17)
    mbox(wx - 5, wy - 5, 6, wx + 5, wy + 5, 6, 10)
  end

  -- 6. Carved Sandstone Blocker Pillars inside courtyard
  for i = 1, #ch.walls do
    local wx, wy = cell_center(ch.walls[i][1], ch.walls[i][2])
    mbox(wx - 6, wy - 6, 7, wx + 6, wy + 6, 8, 6)
    mbox(wx - 5, wy - 5, 9, wx + 5, wy + 5, 9, 8)
    mbox(wx - 4, wy - 4, 10, wx + 4, wy + 4, 19, 7)
    mbox(wx - 3, wy - 3, 10, wx + 3, wy + 3, 19, 8)
    mbox(wx - 5, wy - 5, 20, wx + 5, wy + 5, 21, 24)
    mbox(wx - 6, wy - 6, 22, wx + 6, wy + 6, 23, 9)
    mbox(wx - 4, wy - 4, 24, wx + 4, wy + 4, 24, 17)
  end

  -- 7. Turquoise Crystal Lunar Filter Arches
  for i = 1, #filters do
    local f = filters[i]
    local wx, wy = cell_center(f.x, f.y)
    if f.axis == "v" then
      mbox(wx - 7, wy - 2, 7, wx - 5, wy + 2, 19, 8)
      mbox(wx + 5, wy - 2, 7, wx + 7, wy + 2, 19, 8)
      mbox(wx - 7, wy - 2, 20, wx + 7, wy + 2, 21, 11)
      mbox(wx - 6, wy - 1, 22, wx + 6, wy + 1, 22, 13)
    else
      mbox(wx - 2, wy - 7, 7, wx + 2, wy - 5, 19, 8)
      mbox(wx - 2, wy + 5, 7, wx + 2, wy + 7, 19, 8)
      mbox(wx - 2, wy - 7, 20, wx + 2, wy + 7, 21, 11)
      mbox(wx - 1, wy - 6, 22, wx + 1, wy + 6, 22, 13)
    end
  end

  -- 8. Grand Temple Perimeter Colonnade
  local back_cols = {
    { 58, 198, 28 }, { 96, 198, 24 }, { 160, 198, 24 }, { 198, 198, 28 },
    { 58, 160, 22 }, { 198, 160, 22 },
  }
  for i = 1, #back_cols do
    local cx, cy, ch_h = back_cols[i][1], back_cols[i][2], back_cols[i][3]
    mbox(cx - 5, cy - 5, 5, cx + 5, cy + 5, 7, 6)
    mbox(cx - 4, cy - 4, 8, cx + 4, cy + 4, ch_h - 4, 8)
    mbox(cx - 5, cy - 5, ch_h - 3, cx + 5, cy + 5, ch_h - 2, 24)
    mbox(cx - 6, cy - 6, ch_h - 1, cx + 6, cy + 6, ch_h, 9)
    mbox(cx - 3, cy - 3, ch_h + 1, cx + 3, cy + 3, ch_h + 2, 17)
  end
  mbox(56, 195, 25, 100, 201, 27, 8)
  mbox(156, 195, 25, 200, 201, 27, 8)
  mbox(56, 196, 27, 100, 200, 27, 17)
  mbox(156, 196, 27, 200, 200, 27, 17)

  -- Front corner gilded solar braziers (animated fire added in _draw)
  local front_braziers = { { 58, 58 }, { 198, 58 } }
  for i = 1, #front_braziers do
    local bx, by = front_braziers[i][1], front_braziers[i][2]
    mbox(bx - 5, by - 5, 5, bx + 5, by + 5, 8, 6)
    mbox(bx - 4, by - 4, 9, bx + 4, by + 4, 11, 16)
    mbox(bx - 3, by - 3, 12, bx + 3, by + 3, 12, 15)
  end

  -- 9. Lush Oasis Palm Planters & Custom Voxel Palm Trees
  local palms = {
    { 46, 188, 0 },
    { 210, 188, 1 },
    { 44, 84, 2 },
    { 212, 84, 3 },
    { 128, 212, 1 },
  }
  for i = 1, #palms do
    local px, py, rot = palms[i][1], palms[i][2], palms[i][3]
    mbox(px - 6, py - 6, 3, px + 6, py + 6, 5, 7)
    mbox(px - 5, py - 5, 5, px + 5, py + 5, 5, 21)
    mbox(px - 3, py - 3, 5, px + 3, py + 3, 5, 11)
    mmodel("palm", px, py, 6, rot)
  end
end

local function load_chamber(idx)
  chamber_idx = ((idx - 1) % #CHAMBERS) + 1
  local ch = CHAMBERS[chamber_idx]

  mirrors = {}
  for i = 1, #ch.mirrors do
    local m = ch.mirrors[i]
    mirrors[i] = { x = m.x, y = m.y, rot = m.rot }
  end

  pylons = {}
  for i = 1, #ch.pylons do
    local p = ch.pylons[i]
    pylons[i] = { x = p.x, y = p.y, req = p.req, lit = false }
  end

  splitters = {}
  for i = 1, #ch.splitters do
    local s = ch.splitters[i]
    splitters[i] = { x = s.x, y = s.y }
  end

  emitters = {}
  for i = 1, #ch.emitters do
    local e = ch.emitters[i]
    emitters[i] = { x = e.x, y = e.y, dir = e.dir, kind = e.kind }
  end

  filters = {}
  for i = 1, #ch.filters do
    local f = ch.filters[i]
    filters[i] = { x = f.x, y = f.y, axis = f.axis }
  end

  walls_map = {}
  for i = 1, #ch.walls do
    walls_map[cell_key(ch.walls[i][1], ch.walls[i][2])] = true
  end

  pools_map = {}
  for i = 1, #ch.pools do
    pools_map[cell_key(ch.pools[i][1], ch.pools[i][2])] = true
  end

  cur_x, cur_y = ch.start_cur[1], ch.start_cur[2]
  disp_x, disp_y = cur_x, cur_y
  moves = 0
  undo_stack = {}
  solved = false
  solved_timer = 0
  flash_timer = 0

  build_chamber_map(ch)
  trace_beams(false)
end

function _init()
  quality("hq")
  sky(1, 3)
  fog(3, 0.0007)
  sun(-0.60, -0.45, 0.92, 1.15)
  camera(128, 128, 13, 1.35, 0.52)

  load_chamber(1)

  music_vol(0.50)
  music(0, 400)
end

local function step_cursor(dx, dy)
  local nx = mid(1, cur_x + dx, GRID_N)
  local ny = mid(1, cur_y + dy, GRID_N)
  if nx ~= cur_x or ny ~= cur_y then
    cur_x, cur_y = nx, ny
    sfx(0)
  end
end

function _update()
  if btnp(6) then
    mute()
  end

  if flash_timer > 0 then
    flash_timer = math.max(0, flash_timer - 1 / 30)
  end

  if solved then
    solved_timer = solved_timer + 1 / 30
  end

  -- Responsive smooth visual cursor
  disp_x = disp_x + (cur_x - disp_x) * 0.55
  disp_y = disp_y + (cur_y - disp_y) * 0.55

  -- Crisp tactile tile-by-tile cursor movement (edge-triggered, zero overshoot on 7x7 grid)
  if btnp(0) then step_cursor(-1, 0) end
  if btnp(1) then step_cursor(1, 0) end
  if btnp(2) then step_cursor(0, 1) end
  if btnp(3) then step_cursor(0, -1) end

  -- Action button (A / Z / Space): Rotate mirror, or advance when chamber is solved
  if btnp(4) then
    if solved then
      sfx(2)
      load_chamber(chamber_idx + 1)
      return
    end
    local mir, idx = find_mirror(cur_x, cur_y)
    if mir then
      undo_stack[#undo_stack + 1] = { idx = idx, prev_rot = mir.rot, cx = cur_x, cy = cur_y }
      mir.rot = 1 - mir.rot
      moves = moves + 1
      sfx(1)
      local wx, wy = cell_center(mir.x, mir.y)
      for p = 1, 10 do
        particle(wx + rnd(10) - 5, wy + rnd(10) - 5, BEAM_Z + rnd(6) - 2, 19, 0.55)
      end
      trace_beams(true)
    else
      sfx(5)
    end
  end

  -- Secondary button (B / X / E): Undo last move (or reset chamber)
  if btnp(5) then
    if #undo_stack > 0 then
      local last = undo_stack[#undo_stack]
      undo_stack[#undo_stack] = nil
      mirrors[last.idx].rot = last.prev_rot
      cur_x, cur_y = last.cx, last.cy
      moves = math.max(0, moves - 1)
      sfx(4)
      trace_beams(false)
    else
      sfx(4)
      load_chamber(chamber_idx)
    end
  end

  -- Ambient golden/turquoise spark particles at reflections & charged pylons
  if flr(t() * 30) % 2 == 0 then
    for i = 1, #hit_points do
      local hp = hit_points[i]
      local c = (hp.kind == "lunar") and 14 or 19
      particle(hp.x + rnd(4) - 2, hp.y + rnd(4) - 2, BEAM_Z + rnd(3) - 1, c, 0.35)
    end
    for i = 1, #pylons do
      if pylons[i].lit then
        local wx, wy = cell_center(pylons[i].x, pylons[i].y)
        local c = (pylons[i].req == "lunar") and 14 or 19
        particle(wx + rnd(8) - 4, wy + rnd(8) - 4, 22 + rnd(6), c, 0.65)
      end
    end
  end
end

-- Draw a thick, luminous 3D volumetric optical beam with traveling white-hot pulses
local function draw_beam_segment(seg, phase)
  local outer_c = (seg.kind == "lunar") and 13 or 18
  local core_c  = (seg.kind == "lunar") and 14 or 19
  local glow_c  = (seg.kind == "lunar") and 12 or 17

  local x0, y0 = flr(seg.x0), flr(seg.y0)
  local x1, y1 = flr(seg.x1), flr(seg.y1)
  local dx = (x1 > x0) and 1 or ((x1 < x0) and -1 or 0)
  local dy = (y1 > y0) and 1 or ((y1 < y0) and -1 or 0)
  local len = math.max(math.abs(x1 - x0), math.abs(y1 - y0))

  local px, py = -dy, dx

  for s = 0, len do
    local x = x0 + dx * s
    local y = y0 + dy * s
    local pulse = ((s - phase) % 9 == 0) or ((s - phase) % 9 == 1)

    -- Pure-white blazing inner core + golden/cyan luminous shell
    vset(x, y, BEAM_Z, pulse and 29 or core_c)
    vset(x, y, BEAM_Z + 1, pulse and core_c or outer_c)
    vset(x, y, BEAM_Z - 1, outer_c)
    vset(x + px, y + py, BEAM_Z, pulse and core_c or outer_c)
    vset(x - px, y - py, BEAM_Z, pulse and core_c or outer_c)

    -- Shimmering beam reflection over oasis pools
    if s % 2 == 0 and mget(x, y, 5) == 12 then
      vset(x, y, 6, pulse and 29 or glow_c)
    end
  end
end

local function draw_cursor(gx, gy)
  local wx = flr(OX + (gx - 1) * CELL + 8)
  local wy = flr(OY + (gy - 1) * CELL + 8)
  local bob = flr(math.sin(t() * 7) * 1.1 + 0.5)
  local on_mirror = (find_mirror(cur_x, cur_y) ~= nil)
  local main_c = on_mirror and 31 or 13
  local hi_c   = on_mirror and 29 or 14

  -- Bold 2-voxel-thick corner chevrons framing the selected courtyard tile
  local r = 7
  local corners = {
    { -r, -r,  1,  1 },
    {  r, -r, -1,  1 },
    { -r,  r,  1, -1 },
    {  r,  r, -1, -1 },
  }
  for i = 1, 4 do
    local cx = wx + corners[i][1]
    local cy = wy + corners[i][2]
    local sx = corners[i][3]
    local sy = corners[i][4]
    box(cx, cy, 7, cx + sx * 4, cy, 8, main_c)
    box(cx, cy, 7, cx, cy + sy * 4, 8, main_c)
    box(cx, cy, 8, cx + sx * 1, cy + sy * 1, 9, hi_c)
  end

  -- Floating glowing downward chevron marker above the tile so cursor is instantly readable!
  local hz = (on_mirror and 24 or 16) + bob
  vset(wx, wy, hz, hi_c)
  box(wx - 1, wy, hz + 1, wx + 1, wy, hz + 1, main_c)
  box(wx, wy - 1, hz + 1, wx, wy + 1, hz + 1, main_c)
  box(wx - 2, wy, hz + 2, wx + 2, wy, hz + 2, 18)
  box(wx, wy - 2, hz + 2, wx, wy + 2, hz + 2, 18)
  vset(wx, wy, hz + 3, hi_c)
end

function _draw()
  cls()

  -- Hero-framed isometric temple view
  local sway = math.sin(t() * 0.35) * 0.012
  camera(128, 128, 13, 1.35 + flash_timer * 0.018, 0.52 + sway)

  -- 1. Animated water shimmer glints on oasis moat & pools + flickering front braziers
  local tick = flr(t() * 8)
  for i = 0, 14 do
    local sx = 64 + ((i * 29 + tick * 3) % 128)
    local sy = 62 + ((i * 47 + tick * 2) % 130)
    if mget(sx, sy, 5) == 12 then
      vset(sx, sy, 5, 13)
      if (i + tick) % 3 == 0 then
        vset(sx + 1, sy, 5, 14)
      end
    end
  end
  local flame_h = 14 + (flr(t() * 10) % 2)
  for _, b in ipairs({ { 58, 58 }, { 198, 58 } }) do
    box(b[1] - 2, b[2] - 2, 13, b[1] + 2, b[2] + 2, 13, 31)
    box(b[1] - 1, b[2] - 1, 14, b[1] + 1, b[2] + 1, flame_h, 18)
    vset(b[1], b[2], flame_h + 1, 19)
  end

  -- 2. Draw Solar & Lunar Emitters
  for i = 1, #emitters do
    local e = emitters[i]
    local wx, wy = cell_center(e.x, e.y)
    if e.kind == "lunar" then
      pswap(18, 13)
      pswap(19, 14)
      pswap(17, 12)
      model("emitter", wx, wy, 7, e.dir)
      pswap()
    else
      model("emitter", wx, wy, 7, e.dir)
    end
  end

  -- 3. Draw Rotating Brass-and-Crystal Mirrors
  for i = 1, #mirrors do
    local m = mirrors[i]
    local wx, wy = cell_center(m.x, m.y)
    model("mirror", wx, wy, 7, m.rot)
  end

  -- 4. Draw Faceted Crystal Prism Splitters
  for i = 1, #splitters do
    local s = splitters[i]
    local wx, wy = cell_center(s.x, s.y)
    model("splitter", wx, wy, 7, 0)
  end

  -- 5. Draw Lunar Filter Crystal Veils
  for i = 1, #filters do
    local f = filters[i]
    local wx, wy = cell_center(f.x, f.y)
    local shimmer = (flr(t() * 10) % 2 == 0)
    if f.axis == "v" then
      for z = 8, 19 do
        for dx = -4, 4 do
          if (dx + z) % 2 == 0 then
            vset(wx + dx, wy, z, shimmer and 13 or 12)
          elseif math.abs(dx) <= 1 and math.abs(z - BEAM_Z) <= 1 then
            vset(wx + dx, wy, z, 14)
          end
        end
      end
    else
      for z = 8, 19 do
        for dy = -4, 4 do
          if (dy + z) % 2 == 0 then
            vset(wx, wy + dy, z, shimmer and 13 or 12)
          elseif math.abs(dy) <= 1 and math.abs(z - BEAM_Z) <= 1 then
            vset(wx, wy + dy, z, 14)
          end
        end
      end
    end
  end

  -- 6. Draw Ancient Turquoise Lotus Pylons (Frame 0=dormant, Frame 1=blooming charged!)
  for i = 1, #pylons do
    local p = pylons[i]
    local wx, wy = cell_center(p.x, p.y)
    local ring_c = (p.req == "lunar") and (p.lit and 14 or 12) or (p.lit and 19 or 18)
    box(wx - 6, wy - 6, 7, wx + 6, wy + 6, 7, ring_c, true)
    if p.req == "solar" and p.lit then
      pswap(12, 17)
      pswap(13, 18)
      pswap(30, 19)
      model("pylon", wx, wy, 7, 0, 0, 1)
      pswap()
    else
      model("pylon", wx, wy, 7, 0, 0, p.lit and 1 or 0)
    end
    -- Vertical ascending light spire when charged!
    if p.lit then
      local spire_c = (p.req == "lunar") and 13 or 18
      local core_c  = (p.req == "lunar") and 14 or 29
      local top_z = 36 + flr(math.sin(t() * 8) * 2)
      for z = 23, top_z do
        vset(wx, wy, z, (z % 2 == 0) and core_c or spire_c)
        if z < 30 then
          vset(wx + 1, wy, z, spire_c)
          vset(wx - 1, wy, z, spire_c)
          vset(wx, wy + 1, z, spire_c)
          vset(wx, wy - 1, z, spire_c)
        end
      end
    end
  end

  -- 7. Draw Active Volumetric Solar & Lunar Beams
  local beam_phase = flr(t() * 24)
  for i = 1, #beam_segments do
    draw_beam_segment(beam_segments[i], beam_phase)
  end

  -- Radiant flares at reflection & impact points
  for i = 1, #hit_points do
    local hp = hit_points[i]
    local c = (hp.kind == "lunar") and 14 or 29
    sphere(hp.x, hp.y, BEAM_Z, 2, c)
  end

  -- 8. Draw 3D Selection Cursor
  draw_cursor(disp_x, disp_y)

  -- ============================================================
  -- CLEAN MINIMAL 2D HUD OVERLAY (768 x 432)
  -- ============================================================
  local ch = CHAMBERS[chamber_idx]
  local lit_n = 0
  for i = 1, #pylons do
    if pylons[i].lit then lit_n = lit_n + 1 end
  end

  -- Top sanctuary bar
  rectfill(0, 0, 767, 30, 32)
  rectfill(0, 30, 767, 31, 17)

  print("SOLARIS TEMPLE", 14, 9, 18, true, 2)
  local ch_label = "CHAMBER " .. ch.roman .. ": " .. ch.name
  print(ch_label, 250, 12, 9, true, 1)

  local pylon_txt = "PYLONS " .. lit_n .. "/" .. #pylons
  print(pylon_txt, 548, 12, solved and 30 or 13, true, 1)
  print("MOVES " .. moves, 668, 12, 18, true, 1)

  -- Chamber solved celebration banner (compact, above bottom bar)
  if solved then
    rectfill(164, 360, 604, 396, 32)
    rect(164, 360, 604, 396, 18)
    if chamber_idx == #CHAMBERS then
      print("ALL 5 CHAMBERS ILLUMINATED!", 230, 369, 18, true, 1)
      print("PRESS Z / SPACE TO REPLAY TEMPLE", 242, 382, 14, true, 1)
    else
      print("CHAMBER " .. ch.roman .. " ILLUMINATED IN " .. moves .. " MOVES!", 228, 369, 30, true, 1)
      print("PRESS Z / SPACE FOR CHAMBER " .. CHAMBERS[chamber_idx + 1].roman, 248, 382, 18, true, 1)
    end
  end

  -- Sleek bottom control strip
  rectfill(0, 404, 767, 431, 32)
  rectfill(0, 403, 767, 403, 12)
  local on_mir = (find_mirror(cur_x, cur_y) ~= nil)
  local hint_c = on_mir and 18 or 9
  print("[ARROWS/WASD] CURSOR", 18, 414, 9, true, 1)
  print("[Z/SPACE] " .. (solved and "NEXT CHAMBER" or "ROTATE MIRROR"), 204, 414, hint_c, true, 1)
  print("[X] UNDO / RESET", 456, 414, 13, true, 1)
  print("[M] SOUND", 644, 414, 8, true, 1)
end

