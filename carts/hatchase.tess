-- file: pal.tess (generated: colour names for indices 201+)
C = { sea_floor_a = 201, sea_floor_b = 202, wet_a = 203, wet_b = 204, sand_a = 205, sand_b = 206, sand_c = 207, dune_a = 208, dune_b = 209, rock_a = 210, rock_b = 211, rock_c = 212, rock_grass = 213, starfish = 214, navy = 215, pool_a = 216, pool_b = 217, white = 218, red = 219, blue = 220, lamp = 221, cap = 222, roof = 223, wood = 224, grass_a = 225, grass_b = 226, sea_deep = 227, sea_mid = 228, sea_shallow = 229, foam = 230, sea_deep_t = 231, sea_mid_t = 232, sea_shallow_t = 233, foam_t = 234, spray = 235, sparkle = 236, gold = 237, sky_day_top = 238, sky_day_bottom = 239, sky_aft_top = 240, sky_aft_bottom = 241, sky_sun_top = 242, sky_sun_bottom = 243, ink = 244, paper = 245, dim = 246 }
C_HEX = { [201] = 0xc9b98a, [202] = 0xbfae80, [203] = 0xd8c08a, [204] = 0xcfb67f, [205] = 0xf0dfb0, [206] = 0xe6d09a, [207] = 0xecd9a6, [208] = 0xefdcab, [209] = 0xe8d29c, [210] = 0x7c8085, [211] = 0x8a8d91, [212] = 0x9ea2a6, [213] = 0x6f9a4e, [214] = 0xf07a2a, [215] = 0x2b3352, [216] = 0x3fb6c6, [217] = 0x7fe0dc, [218] = 0xffffff, [219] = 0xd8343c, [220] = 0x3c6fd0, [221] = 0xffe680, [222] = 0xb8262f, [223] = 0x7a4a2c, [224] = 0x8b5e3c, [225] = 0x7da34a, [226] = 0x9bbd5a, [227] = 0x1d8fb0, [228] = 0x2bb5c4, [229] = 0x63d5cf, [230] = 0xffffff, [231] = 0x3f91a6, [232] = 0x4bb1b7, [233] = 0x7accc1, [234] = 0xfff0ea, [235] = 0xdff7f6, [236] = 0xfff4c2, [237] = 0xf2b01e, [238] = 0x5ec2f2, [239] = 0xc4ecfb, [240] = 0x6fb6e6, [241] = 0xf6e2b4, [242] = 0xf3876a, [243] = 0xffe3b8, [244] = 0x1b2430, [245] = 0xfff6e0, [246] = 0x5a6b7d }
-- file: world.lua
-- The Puppy Coast beach as a 128 x 128 voxel room: sea to the north, sand, rock pools, striped beach huts,
-- a lighthouse on the headland, and dunes. A port of puppy-coast-voxel src/world.js.
--
-- Coordinates: Tessera x = old x, Tessera y = 127 - old z (so the sea, old z < shoreZ, is north: high y),
-- Tessera z = old height. A column of terrain height h fills map voxels z = 0 .. h-1, so a creature stands at
-- z = h. hash() is always called with the old (x, z) so the beach is the same one the original builds.

W, D = 128, 128
-- Keep the original cart's logical coordinates; the machine and model assets are 2× this size.
local api_mbox, api_box = mbox, box
local function mbox(x0, y0, z0, x1, y1, z1, c)
  api_mbox(x0 * 2, y0 * 2, z0 * 2, x1 * 2 + 1, y1 * 2 + 1, z1 * 2 + 1, c)
end
local function box(x0, y0, z0, x1, y1, z1, c, hollow)
  api_box(x0 * 2, y0 * 2, z0 * 2, x1 * 2 + 1, y1 * 2 + 1, z1 * 2 + 1, c, hollow)
end
local floor, sin, abs, max, min, sqrt = math.floor, math.sin, math.abs, math.max, math.min, math.sqrt
local M32 = 0xffffffff

local function round(v) return floor(v + 0.5) end -- JS Math.round
local function int32(a) -- JS `a | 0` for the values world.js passes (truncate, wrap to 32 bits)
  if math.type(a) == "float" then a = a >= 0 and floor(a) or -floor(-a) end
  a = a & M32
  if a >= 0x80000000 then a = a - 0x100000000 end
  return a
end

--- models.js hash(a, b, c) in [0, 1), bit-exact: Math.imul is the low 32 bits of the 64-bit product.
function hash(a, b, c)
  a, b, c = int32(a), int32(b), int32(c)
  local n = ((a * 374761393) ~ (b * 668265263) ~ (c * 1274126177)) & M32
  n = ((n ~ (n >> 13)) * 1274126177) & M32
  return ((n ~ (n >> 16)) & M32) / 4294967296
end

--- Old z of the waterline at column x (sea is old z below this).
local function shoreZ(x) return 30 + 2.2 * sin(x * 0.08) + 1.4 * sin(x * 0.21 + 1) end
--- The waterline's y in Tessera: the sea is at y > shore_y(x).
function shore_y(x) return 127 - shoreZ(x) end

local heights = {} -- terrain height per column, indexed x + 128 * y (Tessera rows)
local function cell(x, z) return x + 128 * (127 - z) end -- old (x, z) → heights index

--- Old-coordinate height lookup (world.js H): 99 outside the room.
local function H(x, z)
  x, z = floor(x), floor(z)
  if x < 0 or z < 0 or x >= W or z >= D then return 99 end
  return heights[cell(x, z)]
end

--- Terrain height at a Tessera column (99 outside the room).
function ground(x, y)
  x, y = floor(x), floor(y)
  if x < 0 or y < 0 or x >= W or y >= D then return 99 end
  return heights[x + 128 * y]
end

--- Highest terrain under a creature's footprint (world.js groundAt).
function ground_at(x, y, r)
  r = r or 1.5
  local h = 0
  for _, dx in ipairs({ -r, 0, r }) do
    for _, dy in ipairs({ -r, 0, r }) do h = max(h, ground(x + dx, y + dy)) end
  end
  return h
end

--- True if a wave is currently washing over (x, y) (world.js isWet).
function is_wet(x, y, reach)
  local z, zs = 127 - y, shoreZ(x)
  return z >= zs - 3 and z < zs + reach and ground(x, y) < 3
end

-- Huts: x, y (south edge, the door side), w (x extent), d (y extent): a hut covers x..x+w-1, y..y+d-1.
HUTS = {}
for i, z in ipairs({ 44, 60, 76, 92 }) do
  HUTS[i] = { x = 113, y = 127 - (z + 10 - 1), w = 9, d = 10, colour = (i - 1) % 2 == 1 and C.blue or C.red, z_old = z }
end
LIGHTHOUSE = { x = 12, y = 127 - 14 }
local L_OLD = { x = 12, z = 14 }
local POOLS = { { x = 30, z = 54, r = 7 }, { x = 46, z = 63, r = 5 } }

--- Builds the beach into the map layer and the height table.
function build_world()
  mclear()
  local segs = {} -- { x, old z, z0, z1 (exclusive), colour }
  local function seg(x, z, z0, z1, c) segs[#segs + 1] = { x, z, z0, z1, c } end
  local baseTop, baseCol = {}, {}

  for z = 0, D - 1 do
    for x = 0, W - 1 do
      local zs = shoreZ(x)
      local n = hash(x, z, 1)
      local h, c
      if z < zs then
        h = 0 -- sea floor (water drawn on top)
        c = n > 0.5 and C.sea_floor_a or C.sea_floor_b
      elseif z < zs + 12 then
        h = 1 -- wet sand
        c = n > 0.5 and C.wet_a or C.wet_b
      elseif z < 104 then
        h = 2
        c = n > 0.66 and C.sand_c or n > 0.33 and C.sand_b or C.sand_a
      else
        -- Dunes
        local d = 2 + round(1.6 + 1.5 * sin(x * 0.13) + 1.2 * sin(x * 0.31 + z * 0.2) + (z - 104) * 0.08)
        h = max(2, min(6, d))
        c = n > 0.5 and C.dune_a or C.dune_b
        if hash(x, z, 9) < 0.18 then
          seg(x, z, h, h + 2 + floor(hash(x, z, 4) * 3), hash(x, z, 7) > 0.5 and C.grass_a or C.grass_b)
        end
      end
      -- Rocky headland in the north-west corner.
      local k = x + z * 0.9 + 4 * sin(x * 0.4) + 3 * sin(z * 0.5)
      if k < 44 then
        h = max(h, min(14, round((44 - k) * 0.42 + n * 2)))
        c = n > 0.66 and C.rock_b or n > 0.33 and C.rock_c or C.rock_a
        if h > 9 and hash(x, z, 5) < 0.3 then c = C.rock_grass end -- grassy top
      end
      local i = cell(x, z)
      heights[i], baseTop[i], baseCol[i] = h, h, c
    end
  end

  -- Rock pools: grey rims, shallow water, starfish and mussels.
  for _, p in ipairs(POOLS) do
    for z = p.z - p.r - 2, p.z + p.r + 2 do
      for x = p.x - p.r - 2, p.x + p.r + 2 do
        local d = sqrt((x - p.x) ^ 2 + (z - p.z) ^ 2) + hash(x, z, 2) * 1.5
        if d <= p.r + 1.5 then
          local i = cell(x, z)
          if d > p.r - 0.5 then -- rim
            heights[i] = 3 + round(hash(x, z, 3))
            local c = hash(x, z, 6) > 0.5 and C.rock_b or C.rock_c
            if hash(x, z, 8) < 0.06 then c = C.starfish
            elseif hash(x, z, 8) < 0.14 then c = C.navy end -- mussels
            baseTop[i], baseCol[i] = heights[i], c
          else
            heights[i] = 1
            baseTop[i] = 2 -- the water surface (1.6 in world.js) rounds up to two voxels
            baseCol[i] = hash(x, z, 6) > 0.85 and C.pool_b or C.pool_a
            if hash(x, z, 11) < 0.05 then seg(x, z, 1, 2, C.starfish) end
          end
        end
      end
    end
  end

  -- Lighthouse on the headland: red and white bands, lamp and cap.
  local base = H(L_OLD.x, L_OLD.z)
  LIGHTHOUSE.base = base
  for z = L_OLD.z - 5, L_OLD.z + 5 do
    for x = L_OLD.x - 5, L_OLD.x + 5 do
      local d = sqrt((x - L_OLD.x) ^ 2 + (z - L_OLD.z) ^ 2)
      if d <= 4.2 then
        local top = base + 24
        for y = base, top - 1, 4 do seg(x, z, y, y + 4, ((y - base) // 4) % 2 == 1 and C.white or C.red) end
        if d < 3.2 then
          seg(x, z, top, top + 3, d < 2 and C.lamp or C.navy)
          seg(x, z, top + 3, top + 5 - round(d * 0.7), C.cap)
        end
        heights[cell(x, z)] = 99
      end
    end
  end

  -- Striped beach huts with peaked roofs; doors face the camera (south).
  for _, hut in ipairs(HUTS) do
    local hz = hut.z_old
    for z = hz, hz + hut.d - 1 do
      for x = hut.x, hut.x + hut.w - 1 do
        local g = H(x, z)
        local cx = hut.x + hut.w / 2 - 0.5
        local stripe = (x - hut.x) % 2 == 1 and C.white or hut.colour
        local roof = 11 + max(1, 3.5 - abs(x - cx) * 0.7)
        local door = z == hz + hut.d - 1 and abs(x - cx) < 1.6
        if door then
          seg(x, z, g, g + 7, C.navy)
          seg(x, z, g + 7, g + 11, stripe)
        else
          seg(x, z, g, g + 11, stripe)
        end
        seg(x, z, g + 11, round(g + roof), C.roof)
        heights[cell(x, z)] = 99
      end
    end
  end

  -- Wooden fence posts along the dunes.
  for x = 16, 103, 7 do
    local z = 103
    local g = H(x, z)
    seg(x, z, g, g + 5, C.wood)
    heights[cell(x, z)] = g + 5
  end

  -- Ground columns, then everything standing on them.
  for z = 0, D - 1 do
    local y = 127 - z
    for x = 0, W - 1 do
      local i = cell(x, z)
      if baseTop[i] > 0 then mbox(x, y, 0, x, y, baseTop[i] - 1, baseCol[i]) end
    end
  end
  for _, s in ipairs(segs) do
    if s[4] > s[3] then
      local y = 127 - s[2]
      mbox(s[1], y, s[3], s[1], y, s[4] - 1, s[5])
    end
  end
end

-- ------------------------------------------------------------------ sea

local WATER_D = 52 -- old rows 0..51 can hold water

--- Draws the sea into the draw layer (world.js updateWater). `reach` is how far (in voxels) the current wave
--- runs up the sand; `tint` (truthy) uses the sunset-tinted sea colours.
--- This is the hottest code in the cart (about 880 boxes a frame), so it is written for speed: the static shoreline
--- is cached, the height lookup is inlined, and per-column terms are hoisted. Every float expression keeps the
--- original evaluation order, so the boxes drawn are exactly those of the straightforward version.
local SHORE = {} -- shoreZ per column (static)
for x = 0, W - 1 do SHORE[x] = shoreZ(x) end
function draw_sea(t, reach, tint)
  local deep, mid, shallow, foam = C.sea_deep, C.sea_mid, C.sea_shallow, C.foam
  if tint then deep, mid, shallow, foam = C.sea_deep_t, C.sea_mid_t, C.sea_shallow_t, C.foam_t end
  local t3, t11, t18 = t * 3, t * 1.1, t * 1.8
  for x = 0, W - 1 do
    local zs = SHORE[x]
    local surfOn = sin(t3 + x * 0.5) > -0.2
    local swell = 1.25 + 0.2 * sin(t11 - x * 0.11)
    local wave = t18 + x * 0.25
    local zFoam, zDeep, zMid = zs - 2.5, zs - 14, zs - 6
    local zReach = zs + reach
    local zWash = zReach - 1.6
    local x2 = x * 2
    -- Rows run north (old z 0, y 127) to south; equal neighbours are merged into one box.
    local ry, rz0, rz1, rc = nil, 0, 0, 0
    local last = min(WATER_D - 1, floor(zReach))
    for z = 0, last + 1 do
      local z0, z1, c = nil, nil, nil
      if z <= last then
        local h = heights[x + 128 * (127 - z)] -- H(x, z): always inside the room here
        if h < 3 then -- water only ever covers terrain lower than 3
          if z < zs then
            local level = swell + 0.35 * sin(wave + z * 0.4)
            if level > h then
              c = (z > zFoam and surfOn) and foam or z < zDeep and deep or z < zMid and mid or shallow
              z0, z1 = h, max(h, round(level) - 1)
            end
          elseif z < zReach then
            local level = h + 0.35
            if level > h then
              c = z > zWash and foam or shallow
              z0, z1 = h, max(h, round(level) - 1)
            end
          end
        end
      end
      local y = 127 - z
      if ry and z0 == rz0 and z1 == rz1 and c == rc then
        -- extend the run southwards (y decreases)
      else
        if ry then api_box(x2, (y + 1) * 2, rz0 * 2, x2 + 1, ry * 2 + 1, rz1 * 2 + 1, rc) end
        if z0 then ry, rz0, rz1, rc = y, z0, z1, c else ry = nil end
      end
    end
  end
end
-- file: game.lua
-- Hat Chase game: the dogs, the runaway red hat, three rounds, crabs, gulls, buckets, shells, sniffing and sounds
-- (a behaviour port of puppy-coast-voxel src/main.js and src/audio.js). There is no fail state.
-- Speeds are the original voxels per second; each 30 Hz tick moves speed / 30 (DT = 1/30).
-- Coordinates: x east, y north (y = 127 - the original z), z up (the original y).

local floor, sin, cos, abs, max, min, atan, sqrt, pi = math.floor, math.sin, math.cos, math.abs, math.max, math.min, math.atan, math.sqrt, math.pi
DT = 1 / 30
-- The original game logic stays in 128-space; drawing, models and camera use the 256-space machine.
local api_mget, api_mset = mget, mset
local api_model, api_mmodel, api_particle, api_camera = model, mmodel, particle, camera
local function mget(x, y, z) return api_mget(x * 2, y * 2, z * 2) end
local function mset(x, y, z, c) for dz = 0, 1 do for dy = 0, 1 do for dx = 0, 1 do api_mset(x * 2 + dx, y * 2 + dy, z * 2 + dz, c) end end end end
local function model(id, x, y, z, rot, flip, frame) return api_model(id, x * 2, y * 2, z * 2, rot, flip, frame) end
local function mmodel(id, x, y, z, rot, flip) return api_mmodel(id, x * 2, y * 2, z * 2, rot, flip) end
local function particle(x, y, z, c, life) return api_particle(x * 2, y * 2, z * 2, c, life) end
local function camera(x, y, z, zoom, yaw) return api_camera(x * 2, y * 2, z * 2, zoom, yaw) end

DOGS = {
  betsy = { id = "betsy", name = "Betsy", speed = 30, special = "zoom", power = "{A}: Zoom! (a speedy dash)",
    blurb = "Fun, fast and always in front!" },
  sunday = { id = "sunday", name = "Sunday", speed = 19, special = "carry", dainty = true, small = true,
    power = "{A}: \"Carry me!\" (Betsy gives her a lift)", blurb = "A wee princess. Walking is too good for her." },
  chester = { id = "chester", name = "Chester", speed = 25, special = "leap", scared = true,
    power = "{A}: a big excited leap",
    blurb = "1 year old! Excited and a bit scared, all at once." },
}
ORDER = { "betsy", "sunday", "chester" } -- same order as the "Meet the dogs" card
-- Model frames (see __meta__ model.<id>.frames): run0..run3, idle, then the dog's special pose.
local IDLE, SPECIAL = 4, 5

-- The rounds follow The Runaway Red Hat (README): titles and lines exactly as the book has them.
ROUNDS = {
  { title = "Off to the beach we go!", sub = "Whoosh! Off flew the red hat. Catch it!", mood = "day",
    catches = 3, rest = { 3.5, 6 }, crabs = 2, buckets = 0, reach = 8, shells = 12 },
  { title = "Where did it go?", sub = "Look low. Look high. Press {B} to sniff!", mood = "afternoon",
    catches = 2, rest = { 6, 9 }, crabs = 3, buckets = 7, reach = 9, shells = 12 },
  { title = "One leap. One gust.", sub = "The sun is setting and the wind is wild!", mood = "sunset",
    catches = 3, rest = { 2.2, 4 }, crabs = 4, buckets = 0, reach = 12, shells = 12 },
}
-- Moods: midday, afternoon, sunset. sun is main.js's light direction with y = −z; tint warms the palette.
MOODS = {
  day = { top = C.sky_day_top, bottom = C.sky_day_bottom, sun = { -40, -50, 90 }, strength = 1 },
  afternoon = { top = C.sky_aft_top, bottom = C.sky_aft_bottom, sun = { -70, -30, 70 }, strength = 0.95 },
  sunset = { top = C.sky_sun_top, bottom = C.sky_sun_bottom, sun = { -100, -45, 55 }, strength = 1, tint = true },
}

game = { state = "title", sel = 1, reach = 1.5, wave_t = 0, round_reach = 8, a_lock = false, tick = 0, drawn = -1,
  round = 1, catches = 0, shells = 0, round_shells = 0, time = 0, state_t = 0, catch_cool = 0, mood = "day",
  paw_prints = 0, gusts = 0 }
dog = { id = "betsy", x = 64, y = 35, z = 2, vx = 0, vy = 0, vz = 0, facing = pi / 2, frame = IDLE, special_t = 0,
  cool = 0, stun = 0, kx = 0, ky = 0, carried = false, moving = false, on_ground = true, wet_msg = 0, anim = 0,
  carrier_frame = IDLE, sniff_cool = 0 }
hat = { x = 64, y = 127 - 66, z = 2, vx = 0, vy = 0, vz = 0, state = "rest", rest = 9999, spin = 0, rot = 0 }
popups, crabs, buckets, shells = {}, {}, {}, {}
HEIGHT = {} -- model heights (filled in _init)

--- A short message floating up from a point in the world (drawn by ui.lua through project()).
function popup(text, x, y, z, big)
  local fresh = 0
  for _, p in ipairs(popups) do if p.age < 0.4 then fresh = fresh + 1 end end
  popups[#popups + 1] = { text = text, x = x, y = y, z = z + fresh * 6, age = 0, life = big and 1.8 or 1.4, big = big }
end

local function rand(a, b) return a + rnd(b - a) end
local function dist(ax, ay, bx, by) return sqrt((ax - bx) ^ 2 + (ay - by) ^ 2) end
local function pick(list) return list[floor(rnd(#list)) + 1] end
local function clamp(v, a, b) return max(a, min(b, v)) end

-- ----------------------------------------------------------------- sound (audio.js, through tone())
-- Channels: 0 the dog, 1 the hat, 2 shells and chimes, 3 the sea. Delayed notes wait in a small queue.

local queue = {}
local function note(delay, wave, f0, f1, dur, vol, ch)
  if delay <= 0 then tone(wave, f0, f1, dur, vol, ch)
  else queue[#queue + 1] = { at = t() + delay, wave, f0, f1, dur, vol, ch } end
end
local function play_queue()
  for i = #queue, 1, -1 do
    local q = queue[i]
    if t() >= q.at - 1e-6 then tone(q[1], q[2], q[3], q[4], q[5], q[6]) table.remove(queue, i) end
  end
end
SFX = {
  bark = function(p)
    p = p or 1
    note(0, "square", 520 * p, 300 * p, 0.09, 0.12, 0)
    note(0.12, "square", 560 * p, 320 * p, 0.08, 0.1, 0)
  end,
  yip = function() note(0, "square", 900, 1300, 0.08, 0.1, 0) end,
  whoosh = function() note(0, "noise", 300, 2400, 0.8, 0.35, 1) end,
  wave = function() note(0, "noise", 400, 150, 1.6, 0.12, 3) end,
  shell = function(n) n = n or 0 note(0, "triangle", 880 + n * 40, 1760 + n * 40, 0.12, 0.15, 2) end,
  nearly = function() note(0, "triangle", 660, 330, 0.25, 0.15, 1) end,
  gotit = function()
    for i, f in ipairs({ 523, 659, 784, 1047 }) do note((i - 1) * 0.11, "triangle", f, f, 0.18, 0.15, i % 2 == 1 and 1 or 2) end
  end,
  jump = function() note(0, "square", 300, 700, 0.15, 0.08, 0) end,
  zoom = function() note(0, "saw", 200, 900, 0.25, 0.06, 0) end,
}
local function bark_for(id) SFX.bark(DOGS[id].small and 1.4 or 1) end

-- ----------------------------------------------------------------- moods

--- Sky, sun and palette for a round's mood. Sunset warms the beach colours 15% towards ff9a70 (like its light).
function set_mood(name)
  game.mood = name
  palt()
  if MOODS[name].tint then
    for i, hex in pairs(C_HEX) do
      if i <= 226 and i ~= C.navy then
        local r, g, b = (hex >> 16) & 255, (hex >> 8) & 255, hex & 255
        pal(i, r + (0xff - r) * 0.15, g + (0x9a - g) * 0.15, b + (0x70 - b) * 0.15)
      end
    end
  end
end

-- ----------------------------------------------------------------- places on the beach

--- main.js validSpot: on open dry sand, away from the sea, the dunes, the rocks and the huts.
function valid_spot(x, y, min_shore)
  min_shore = min_shore or 4
  return x > 10 and x < 106 and y < shore_y(x) - min_shore and y > 27 and ground_at(x, y, 3) <= 3
end
--- main.js randomSpot: a valid spot, optionally at least min_dist from `away` ({x, y}).
function random_spot(min_shore, away, min_dist)
  for _ = 1, 200 do
    local x, y = rand(12, 104), 127 - rand(30, 100)
    if valid_spot(x, y, min_shore) and (not away or dist(x, y, away.x, away.y) >= (min_dist or 0)) then return x, y end
  end
  return 64, 127 - 80
end

-- Buckets and shells stand still, so they go on the map layer once; removing one clears the model colours
-- (indices 1–200: the terrain only uses 201+) from a small box around it.
-- The prop's model is stamped at the fractional position (2x machine voxels), so it can overhang the floored
-- logical box by one machine voxel: erase one logical voxel further out, and test every machine voxel (the
-- logical mget/mset wrappers only see the even ones).
local function erase_prop(x, y, z, r, h)
  x, y, r = floor(x), floor(y), r + 1
  for zz = 2 * (z - 1), 2 * (z + h) + 1 do
    for yy = 2 * (y - r), 2 * (y + r) + 1 do
      for xx = 2 * (x - r), 2 * (x + r) + 1 do
        local c = api_mget(xx, yy, zz)
        if c > 0 and c <= 200 then api_mset(xx, yy, zz, 0) end
      end
    end
  end
end
--- Stamps a bucket or shell into the map (a shell's pivot is 1 voxel up, so it sits on the sand).
local function stamp(p) mmodel(p.id, p.x, p.y, p.z + (p.id == "bucket" and 0 or 1), p.rot) end
--- Takes one shell off the map; any neighbour caught in the erase box is stamped again.
local function remove_shell(i)
  local s = table.remove(shells, i)
  erase_prop(s.x, s.y, s.z, 3, 3)
  for _, list in ipairs({ shells, buckets }) do
    for _, p in ipairs(list) do if abs(p.x - s.x) < 10 and abs(p.y - s.y) < 10 then stamp(p) end end
  end
end
function clear_props()
  for _, b in ipairs(buckets) do erase_prop(b.x, b.y, b.z, 4, 5) end
  for _, s in ipairs(shells) do erase_prop(s.x, s.y, s.z, 3, 3) end
  crabs, buckets, shells = {}, {}, {}
end

-- ----------------------------------------------------------------- the dog

--- Puts the chosen dog at the start of a round: (64, old z 92) facing north.
function reset_dog(id)
  dog.id = id
  dog.x, dog.y = 64, 127 - 92
  dog.z = ground_at(dog.x, dog.y)
  dog.vx, dog.vy, dog.vz = 0, 0, 0
  dog.facing, dog.draw_q = pi / 2, 1
  dog.stun, dog.cool, dog.special_t, dog.wet_msg, dog.sniff_cool = 0, 0, 0, 0, 0
  dog.carried, dog.moving, dog.on_ground = false, false, true
  dog.frame, dog.anim = IDLE, 0
end

--- Steering from the d-pad (normalised) or, failing that, the analogue stick (a small push walks).
local function steer()
  local mx, my = 0, 0
  if btn(0) then mx = mx - 1 end
  if btn(1) then mx = mx + 1 end
  if btn(2) then my = my + 1 end -- up = north = +y
  if btn(3) then my = my - 1 end
  local len = sqrt(mx * mx + my * my)
  if len > 0 then return mx / len, my / len end
  local ax, ay = axis(0), axis(1)
  local m = min(1, sqrt(ax * ax + ay * ay))
  if m > 0 then
    local a = max(0.45, m) / m
    return ax * a, ay * a
  end
  return 0, 0
end

--- Moves to (nx, ny) unless it leaves the beach, goes too far out to sea or climbs more than 2 voxels.
--- A dog standing low (a rock-pool floor, height 1) may climb 3, so the 4-high rims can never trap her: a
--- deliberate deviation from main.js so this no-fail game has no soft-lock.
local function try_move(nx, ny)
  if nx < 4 or nx > W - 4 or ny > shore_y(nx) + 2 or ny < 127 - (D - 4) then return false end
  local climb = dog.z < 1.5 and 3.01 or 2.01
  if ground_at(nx, ny) > dog.z + climb then return false end
  dog.x, dog.y = nx, ny
  return true
end

function update_dog()
  local def = DOGS[dog.id]
  local mx, my = 0, 0
  if dog.stun <= 0 then mx, my = steer() end
  dog.moving = mx ~= 0 or my ~= 0

  local speed = def.speed
  if def.special == "zoom" and dog.special_t > 0 then speed = speed * 1.9 end
  if dog.carried then speed = 34 end
  local wet = is_wet(dog.x, dog.y, game.reach)
  if wet and not dog.carried then
    if def.dainty then
      -- Sunday: "Not my paws!" She hops straight back out of the water.
      if dog.wet_msg <= 0 then
        popup("Not my paws!", dog.x, dog.y, dog.z + 12)
        SFX.yip()
        dog.wet_msg = 1.5
      end
      my, mx = -1, mx * 0.3
      speed = def.speed * 1.4
    else
      speed = speed * 0.65
      if dog.moving and rnd() < 0.3 then particle(dog.x + rand(-2, 2), dog.y + rand(-2, 2), dog.z + rand(1, 3), C.spray, 0.5) end
    end
  end
  if dog.stun > 0 then dog.moving = false end

  local x0, y0 = dog.x, dog.y
  if mx ~= 0 or my ~= 0 then
    try_move(dog.x + mx * speed * DT, dog.y)
    try_move(dog.x, dog.y + my * speed * DT)
    local d = atan(my, mx) - dog.facing
    d = atan(sin(d), cos(d))
    dog.facing = dog.facing + d * min(1, DT * 14)
  end
  -- Knock-back from crabs.
  if dog.stun > 0 then
    try_move(dog.x + dog.kx * DT, dog.y)
    try_move(dog.x, dog.y + dog.ky * DT)
  end
  dog.vx, dog.vy = dog.x - x0, dog.y - y0

  -- Vertical: gravity and ground.
  local g = ground_at(dog.x, dog.y)
  dog.vz = dog.vz - 70 * DT
  dog.z = dog.z + dog.vz * DT
  if dog.z <= g then dog.z, dog.vz = g, 0 end
  dog.on_ground = dog.z <= g + 0.01

  -- Timers.
  dog.stun, dog.cool, dog.special_t, dog.wet_msg = dog.stun - DT, dog.cool - DT, dog.special_t - DT, dog.wet_msg - DT
  dog.sniff_cool = dog.sniff_cool - DT
  if dog.carried and dog.special_t <= 0 then dog.carried = false end

  -- Special ability (A). After A starts the game (or skips a banner) it must be let go once first.
  if game.a_lock and not btn(4) then game.a_lock = false end
  if btn(4) and not game.a_lock and dog.cool <= 0 and dog.stun <= 0 then
    if def.special == "zoom" then
      dog.special_t, dog.cool = 1.2, 3
      SFX.zoom()
      popup("Zoom!", dog.x, dog.y, dog.z + 12)
    elseif def.special == "leap" and dog.on_ground then
      dog.vz, dog.cool = 34, 0.7
      SFX.jump()
      popup("Wheee!", dog.x, dog.y, dog.z + 12)
    elseif def.special == "carry" then
      dog.carried, dog.special_t, dog.cool = true, 2.6, 5
      SFX.bark(1.4)
      popup("Carry me!", dog.x, dog.y, dog.z + 12, true)
    end
  end
  -- Zoom dust behind her: pale puffs on the sand, well clear of her body.
  if def.special == "zoom" and dog.special_t > 0 and dog.moving then
    local bx, by = dog.x - cos(dog.facing) * 9, dog.y - sin(dog.facing) * 9
    particle(bx + rand(-1.5, 1.5), by + rand(-1.5, 1.5), ground_at(bx, by, 0), C.sparkle, 0.4)
  end

  -- Sniff (B): a trail of paw prints towards the hat.
  if btn(5) and dog.sniff_cool <= 0 then sniff() end

  -- Footstep puffs.
  if dog.moving and dog.on_ground and not wet and rnd() < 0.15 then
    particle(dog.x + rand(-1, 1), dog.y + rand(-1, 1), dog.z, C.sand_b, 0.35)
  end

  -- Animation frame (animateDog: leg phase = t * 16 * speed / 25, four run frames per cycle).
  local running = dog.moving and dog.on_ground
  if running or dog.carried then dog.anim = dog.anim + DT * 16 * (dog.carried and 1.3 or speed / 25) end
  local run = floor(dog.anim / (pi / 2) + 0.5) % 4
  if dog.carried then
    dog.frame = SPECIAL -- Sunday sits up on Betsy's back
    dog.carrier_frame = dog.moving and run or IDLE
  elseif not dog.on_ground then
    dog.frame = def.special == "leap" and SPECIAL or IDLE
  elseif running then
    dog.frame = (def.special == "zoom" and dog.special_t > 0 and run == 0) and SPECIAL or run
  else
    dog.frame = IDLE
  end
end

--- Paw prints every 4 voxels from 6 out to 60 (or the hat), left and right of the line, on the sand.
function sniff()
  dog.sniff_cool = 3
  popup("Sniff sniff...", dog.x, dog.y, dog.z + 12)
  local dx, dy = hat.x - dog.x, hat.y - dog.y
  local L = sqrt(dx * dx + dy * dy)
  local n = 0
  if L > 0 then
    local s = 6
    while s < min(L, 60) do
      local side = (floor(s / 4) % 2 == 1) and 1 or -1
      local px, py = dog.x + dx / L * s - dy / L * side * 0.8, dog.y + dy / L * s + dx / L * side * 0.8
      particle(px, py, ground_at(px, py, 0), C.wood, 2.5 + s * 0.01)
      n = n + 1
      s = s + 4
    end
  end
  game.paw_prints = n
end

--- Catching the hat, picking up shells and spotting the red buckets (the end of main.js dogUpdate).
function update_finds()
  local def, R = DOGS[dog.id], ROUNDS[game.round]
  game.catch_cool = game.catch_cool - DT
  if hat.state ~= "caught" and game.catch_cool <= 0 then
    local near = dist(dog.x, dog.y, hat.x, hat.y) < 6
    local top = dog.z + HEIGHT[dog.id] + (dog.carried and 7 or 0)
    if near and hat.z < top + 2 and hat.z > dog.z - 4 then
      game.catches = game.catches + 1
      game.catch_cool = 1.2
      if game.catches < R.catches then
        popup("Nearly, " .. def.name .. "!", hat.x, hat.y, hat.z + 8, true)
        SFX.nearly()
        hat.z = hat.z + 2
        gust(32, 50)
      else
        hat.state = "caught"
        popup("Got it!", dog.x, dog.y, dog.z + 14, true)
        SFX.gotit()
        SFX.bark(def.small and 1.4 or 1)
        game.state, game.state_t = "round_end", 0
        local cols = { C.red, C.gold, C.blue, C.white }
        for i = 1, 40 do
          local a, r = rnd(2 * pi), rand(1, 9)
          particle(dog.x + cos(a) * r, dog.y + sin(a) * r, dog.z + rand(6, 18), cols[(i - 1) % 4 + 1], rand(0.6, 1.2))
        end
      end
    end
  end

  for i = #shells, 1, -1 do
    local s = shells[i]
    if dist(dog.x, dog.y, s.x, s.y) < 4.5 then
      remove_shell(i)
      game.shells = game.shells + 1
      game.round_shells = game.round_shells + 1
      SFX.shell(game.round_shells)
      for _ = 1, 8 do particle(s.x + rand(-2, 2), s.y + rand(-2, 2), dog.z + rand(2, 7), C.sparkle, rand(0.3, 0.6)) end
    end
  end

  -- Red decoys: "Is that the hat? No, that is a bucket!"
  for _, b in ipairs(buckets) do
    if not b.seen and dist(dog.x, dog.y, b.x, b.y) < 6 then
      b.seen = true
      popup("No, that is a bucket!", b.x, b.y, b.z + 8)
      SFX.nearly()
    end
  end
end

--- The dogs are drawn at exact quarter turns: resampling a thin, dark 14 x 7 dog at a diagonal fattens it into an
--- unreadable blob (legs and head merge). The quarter follows dog.facing with a little hysteresis so running
--- diagonally doesn't flicker between two views. (Deviation from main.js's smooth heading, for readability.)
function dog_quarter()
  local q = dog.draw_q or 1
  local d = dog.facing - q * pi / 2
  d = atan(sin(d), cos(d))
  if abs(d) > pi / 4 + 0.15 then q = floor(dog.facing / (pi / 2) + 0.5) % 4 end
  dog.draw_q = q % 4
  return dog.draw_q * pi / 2
end

function draw_dog()
  local rot = dog_quarter()
  local x = dog.x
  if dog.stun > 0 and sin(t() * 40) > 0 then x = x + 1 end -- startled: a shiver
  if dog.carried then
    model("betsy", x, dog.y, dog.z, rot, false, dog.carrier_frame)
    model(dog.id, x, dog.y, dog.z + 7.5, rot, false, dog.frame)
  else
    model(dog.id, x, dog.y, dog.z, rot, false, dog.frame)
  end
end

-- ----------------------------------------------------------------- the hat

local WORDS = { "Whoosh!", "The hat ran faster!", "Hold on to your hat!", "Whooooo!" }

--- The wind takes the hat: it flies 1.3–1.9 s to a spot min_d..max_d away, preferably away from the dog.
function gust(min_d, max_d)
  min_d, max_d = min_d or 25, max_d or 45
  local tx, ty
  for _ = 1, 60 do
    local a, r = rnd(2 * pi), rand(min_d, max_d)
    local x, y = hat.x + cos(a) * r, hat.y + sin(a) * r
    if valid_spot(x, y) and dist(x, y, dog.x, dog.y) > min_d * 0.8 then tx, ty = x, y break end
  end
  if not tx then tx, ty = random_spot(4, dog, min_d) end
  local T = rand(1.3, 1.9)
  local tz = ground_at(tx, ty, 1)
  hat.vx, hat.vy = (tx - hat.x) / T, (ty - hat.y) / T
  hat.vz = (tz - hat.z) / T + 0.5 * 38 * T
  hat.state = "fly"
  game.gusts = game.gusts + 1
  SFX.whoosh()
  popup(pick(WORDS), hat.x, hat.y, hat.z + 6)
end

function update_hat()
  local R = ROUNDS[game.round]
  if hat.state == "rest" then
    hat.rest = hat.rest - DT
    hat.wobble = hat.rest < 1 and sin(t() * 30) * 0.25 or 0 -- it wobbles just before the wind takes it again
    if hat.rest <= 0 then gust() end
  elseif hat.state == "fly" then
    hat.vz = hat.vz - 38 * DT
    hat.x, hat.y, hat.z = hat.x + hat.vx * DT, hat.y + hat.vy * DT, hat.z + hat.vz * DT
    hat.x = clamp(hat.x, 6, W - 8)
    hat.y = clamp(hat.y, 127 - (D - 10), 127 - 20)
    hat.spin = hat.spin + DT * 9
    for _ = 1, 2 do
      particle(hat.x + rand(-4, 4), hat.y + rand(-4, 4), hat.z + rand(-1, 4), C.white, 0.6)
    end
    local g = ground_at(hat.x, hat.y, 1)
    if hat.vz < 0 and hat.z <= g then
      hat.z = g
      hat.state = "rest"
      hat.rest = rand(R.rest[1], R.rest[2])
      hat.rot, hat.wobble = rnd(6), 0
      for _ = 1, 10 do particle(hat.x + rand(-3, 3), hat.y + rand(-3, 3), g + rand(0, 2), C.sand_a, 0.5) end
    end
  elseif hat.state == "caught" then
    -- Proudly carried in the dog's mouth.
    local q = (dog.draw_q or 1) * pi / 2 -- in her mouth, whichever way she is drawn
    local fx, fy = cos(q), sin(q)
    hat.x, hat.y = dog.x + fx * 6, dog.y + fy * 6
    hat.z = dog.z + HEIGHT[dog.id] - 5 + (dog.carried and 6 or 0)
  end
end

function draw_hat()
  local rot = hat.rot
  if hat.state == "fly" then rot = hat.spin
  elseif hat.state == "caught" then rot = (dog.draw_q or 1) * pi / 2
  else rot = rot + (hat.wobble or 0) end
  model("hat", hat.x, hat.y, hat.z, rot)
end

-- ----------------------------------------------------------------- crabs and gulls

function update_crabs()
  local def = DOGS[dog.id]
  for _, c in ipairs(crabs) do
    c.turn, c.cool = c.turn - DT, c.cool - DT
    if c.turn <= 0 then c.dir, c.turn = -c.dir, rand(1, 3) end
    local nx = c.x + c.dir * 9 * DT
    if valid_spot(nx, c.y, 1) then c.x = nx else c.dir = -c.dir end
    c.z = ground_at(c.x, c.y, 1)

    -- Crabs startle the dog (Chester from further away).
    local scare = def.scared and 9 or 5
    local d = dist(dog.x, dog.y, c.x, c.y)
    if d < scare and c.cool <= 0 and dog.stun <= 0 and not dog.carried then
      c.cool = 2
      dog.stun = 0.7
      local k = 28 / (d > 0 and d or 1)
      dog.kx, dog.ky = (dog.x - c.x) * k, (dog.y - c.y) * k
      dog.vz = 14
      popup(pick(def.scared and { "Eek! A crab!", "No, that is a crab!" } or { "Yip!", "No, that is a crab!" }), dog.x, dog.y, dog.z + 12)
      SFX.yip()
    end
  end
end

function draw_crabs()
  local step = floor(t() * 10) % 2
  for _, c in ipairs(crabs) do model("crab", c.x, c.y, c.z, pi / 2, false, step) end -- they scuttle sideways
end

gulls = {}
for i = 0, 2 do gulls[i + 1] = { a = i * 2.1, r = 40 + i * 9, h = 30 + i * 3, sp = 0.25 + i * 0.05 } end

function update_gulls()
  for _, g in ipairs(gulls) do g.a = g.a + DT * g.sp end
end

function draw_gulls()
  local tt = t()
  for _, g in ipairs(gulls) do
    local x, y = 64 + cos(g.a) * g.r, 127 - (50 + sin(g.a) * g.r * 0.6)
    model("gull", x, y, g.h + sin(tt + g.a) * 2, -g.a - pi / 2, false, sin(tt * 8 + g.a) > 0 and 0 or 1)
  end
end

-- ----------------------------------------------------------------- camera

-- The original's orthographic frustum is 100 voxels wide: half-width 96 / zoom = 50.
CAM_ZOOM = 96 / 50
CAM_Z = 2 -- target height: the sand
local PITCH = math.rad(35)
local HALF_W = 96 / CAM_ZOOM
local HALF_H = HALF_W * 216 / 384
-- Clamp the target so the view stays inside the room: x within half a view of the walls; y so that the south
-- edge (y 0, z 0) sits at the bottom of the screen and the north edge (y 128, sea top z 2) at the top.
CAM_X0, CAM_X1 = HALF_W, W - HALF_W
CAM_Y0 = (HALF_H - CAM_Z * cos(PITCH)) / sin(PITCH)
CAM_Y1 = D - (HALF_H - (2 - CAM_Z) * cos(PITCH)) / sin(PITCH)
cam = { x = 64, y = 65, z = CAM_Z, zoom = 3 }

--- Eases the camera towards the dog (main.js: a little north of it, CAM_OFFSET's 35° view), clamped to the room.
function follow_camera(snap)
  local k = snap and 1 or min(1, DT * 4)
  cam.x = cam.x + (clamp(dog.x, CAM_X0, CAM_X1) - cam.x) * k
  cam.y = cam.y + (clamp(dog.y + 4, CAM_Y0, CAM_Y1) - cam.y) * k
  cam.z, cam.zoom = CAM_Z, CAM_ZOOM
end

-- ----------------------------------------------------------------- waves

--- main.js wavesUpdate: an 8 s cycle; the wave runs up to round_reach voxels onto the sand and drains away.
function update_waves()
  local prev = (game.wave_t % 8) / 8
  game.wave_t = game.wave_t + DT
  local ph = (game.wave_t % 8) / 8
  if prev > ph and game.state ~= "title" then SFX.wave() end
  local r
  if ph < 0.3 then r = sin((ph / 0.3) * pi / 2) * game.round_reach
  elseif ph < 0.75 then r = game.round_reach * (1 - (ph - 0.3) / 0.45)
  else r = 0 end
  game.reach = 1.5 + r
end

local function update_popups()
  for i = #popups, 1, -1 do
    local p = popups[i]
    p.age = p.age + DT
    if p.age > p.life then table.remove(popups, i) end
  end
end

-- ----------------------------------------------------------------- rounds

function start_round(i)
  local R = ROUNDS[i]
  game.round, game.catches, game.round_shells, game.catch_cool = i, 0, 0, 0
  game.round_reach = R.reach
  set_mood(R.mood)
  clear_props()
  reset_dog(dog.id)

  for _ = 1, R.buckets do
    local x, y = random_spot(5)
    local b = { id = "bucket", x = x, y = y, z = ground_at(x, y, 1), rot = floor(rnd(4)) * pi / 2, seen = false }
    stamp(b)
    buckets[#buckets + 1] = b
  end
  -- In round 2 the hat starts hidden in among the buckets.
  if R.buckets > 0 then hat.x, hat.y = buckets[1].x + 5, buckets[1].y - 2
  else hat.x, hat.y = random_spot(4, dog, 30) end
  hat.z = ground_at(hat.x, hat.y, 1)
  hat.state, hat.rest, hat.rot, hat.wobble = "rest", rand(R.rest[1], R.rest[2]) + 2.5, 0, 0

  for _ = 1, R.crabs do
    local x, y = random_spot(2)
    crabs[#crabs + 1] = { x = x, y = y, z = ground_at(x, y, 1), dir = rnd() < 0.5 and -1 or 1, turn = rand(1, 3), cool = 0 }
  end
  for k = 0, R.shells - 1 do
    local x, y = random_spot(1)
    local s = { id = "shell" .. (k % 3), x = x, y = y, z = ground_at(x, y, 1), rot = floor(rnd(4)) * pi / 2 }
    stamp(s)
    shells[#shells + 1] = s
  end

  popups = {}
  game.state, game.state_t = "intro", 0
  follow_camera(true)
end

function start_game()
  dog.id = ORDER[game.sel]
  game.shells, game.time = 0, 0
  game.a_lock = true
  bark_for(dog.id)
  start_round(1)
end

function show_title()
  game.state = "title"
  popups = {}
  clear_props()
  set_mood("day")
  game.round_reach = 8
  hat.state, hat.rest, hat.rot = "rest", 9999, 0
  hat.x, hat.y = 64, 127 - 66
  hat.z = ground_at(hat.x, hat.y, 1)
end

--- main.js showEnd: three stars up to 2:30, two up to 4:00, otherwise one.
function end_stars()
  local secs = floor(game.time + 0.5)
  return secs <= 150 and 3 or secs <= 240 and 2 or 1
end
TOTAL_SHELLS = 0
for _, r in ipairs(ROUNDS) do TOTAL_SHELLS = TOTAL_SHELLS + r.shells end

-- ----------------------------------------------------------------- lifecycle

function _init()
  build_world()
  for _, id in ipairs({ "betsy", "sunday", "chester" }) do
    local _, _, h = msize(id)
    HEIGHT[id] = h
  end
  show_title()
end

function _update()
  game.tick = game.tick + 1
  play_queue()
  update_waves()
  update_popups()
  update_gulls()
  if btnp(6) then -- M: sound on/off
    game.muted = mute()
    local text = game.muted and "Sound off" or "Sound on"
    if game.state == "title" then popup(text, 64, 127 - 70, 14) else popup(text, dog.x, dog.y, dog.z + 14) end
  end
  local s = game.state
  if s == "title" then
    update_title()
  elseif s == "intro" then
    game.state_t = game.state_t + DT
    if game.a_lock and not btn(4) then game.a_lock = false end
    if game.state_t > 2.6 or (game.state_t > 0.6 and btn(4) and not game.a_lock) then
      game.state = "play"
      game.a_lock = btn(4) -- the A that skipped the banner is not a special
    end
  elseif s == "play" then
    game.time = game.time + DT
    update_dog()
    update_finds()
    if game.state == "play" then update_crabs() end
    update_hat()
    follow_camera()
  elseif s == "round_end" then
    game.state_t = game.state_t + DT
    update_dog()
    update_finds()
    update_hat()
    follow_camera()
    if game.state_t > 2.8 then
      if game.round < #ROUNDS then start_round(game.round + 1) else game.state, game.state_t = "end", 0 end
    end
  elseif s == "end" then
    game.state_t = game.state_t + DT
    dog.facing = dog.facing + DT
    dog.z = ground_at(dog.x, dog.y) + abs(sin(t() * 5)) * 2
    dog.frame, dog.carried = IDLE, false
    update_hat()
    update_end()
  end
  -- Shells twinkle now and then so small eyes can find them.
  if #shells > 0 and rnd() < 0.25 and s ~= "title" then
    local sh = shells[floor(rnd(#shells)) + 1]
    particle(sh.x, sh.y, sh.z + 2 + floor(rnd(2)), C.sparkle, 0.25)
  end
end

--- Voxels change only on a tick, so the draw layer (which persists without cls()) is rebuilt once per tick;
--- the overlay is cleared by the console every frame, so the HUD is issued every time.
function _draw()
  local m = MOODS[game.mood]
  if game.drawn ~= game.tick then
    game.drawn = game.tick
    cls()
    sky(m.top, m.bottom)
    sun(m.sun[1], m.sun[2], m.sun[3], m.strength)
    draw_sea(t(), game.reach, m.tint)
    draw_gulls()
    draw_hat()
    if game.state == "title" then draw_title_world()
    else
      draw_dog()
      draw_crabs()
    end
  end
  if game.state == "title" then
    draw_title()
  else
    camera(cam.x, cam.y, cam.z, cam.zoom)
    draw_popups()
    if game.state == "end" then draw_end()
    else
      draw_hud()
      if game.state == "intro" then draw_banner(ROUNDS[game.round]) end
    end
  end
end
-- file: ui.lua
-- Hat Chase UI uses the 384×216 logical layout, scaled 2× onto the 768×432 5×7 outlined overlay.
-- Icons: spr2d 0 star, 1 shell (a pink whelk), 4 hat.

local sin, pi, floor, max, min = math.sin, math.pi, math.floor, math.max, math.min
local SW, SH = 384, 216
local raw_print, raw_rect, raw_rectfill = print, rect, rectfill
local raw_circfill, raw_spr2d = circfill, spr2d
-- Control hints name the keys on a keyboard (A button = Z, B button = X) and the buttons on a gamepad or touch
-- screen. stat(4) is the input used last: 0 keyboard, 1 gamepad, 2 touch.
function keys(s)
  local kb = stat(4) == 0
  return (s:gsub("{A}", kb and "Z" or "A"):gsub("{B}", kb and "X" or "B"))
end
local function print(s, x, y, c, outline, scale) raw_print(s, x * 2, y * 2, c, outline, scale) end
local function rect(x0, y0, x1, y1, c) raw_rect(x0 * 2, y0 * 2, x1 * 2, y1 * 2, c) end
local function rectfill(x0, y0, x1, y1, c) raw_rectfill(x0 * 2, y0 * 2, x1 * 2, y1 * 2, c) end
local function circfill(x, y, r, c) raw_circfill(x * 2, y * 2, r * 2, c) end
local function spr2d(n, x, y, scale) raw_spr2d(n, x * 2, y * 2, (scale or 1) * 2) end

-- Logical text width: the overlay font advances 6 px per glyph at 768x432, i.e. 3 logical px.
local function textw(s) return 3 * #s end

-- The overlay font draws its own dark outline, so no hand-made drop shadow is needed.
local function shadow(s, x, y, c)
  print(s, x, y, c)
end
local function centre(s, y, c)
  shadow(s, floor((SW - textw(s)) / 2), y, c)
end
--- Bold: the text twice, one overlay pixel (half a logical pixel) apart.
local function bold_centre(s, y, c)
  local x = floor((SW - textw(s)) / 2)
  print(s, x, y, c)
  print(s, x + 0.5, y, c)
end

--- Splits s into lines of at most `chars` characters, breaking at spaces.
function wrap(s, chars)
  local lines, line = {}, ""
  for word in s:gmatch("%S+") do
    if line == "" then line = word
    elseif #line + 1 + #word <= chars then line = line .. " " .. word
    else lines[#lines + 1] = line line = word end
  end
  if line ~= "" then lines[#lines + 1] = line end
  return lines
end

-- ----------------------------------------------------------------- title

function update_title()
  local before = game.sel
  if btnp(0) then game.sel = (game.sel + 1) % 3 + 1 end -- (sel - 1 + 2) % 3 + 1
  if btnp(1) then game.sel = game.sel % 3 + 1 end
  if game.sel ~= before then SFX.bark(DOGS[ORDER[game.sel]].small and 1.4 or 1) end
  if btnp(4) then start_game() end
end

function draw_title_world()
  local tt = t()
  for i, id in ipairs(ORDER) do
    local x, y = 49 + (i - 1) * 15, 127 - 76
    local sel = i == game.sel
    local hop = sel and math.abs(sin(tt * 5)) * 2.5 or 0
    local rot = -pi / 2 + 1.0 + (sel and sin(tt * 2) * 0.35 or 0) -- three-quarter view towards the camera
    model(id, x, y, ground_at(x, y) + hop, rot, false, 4)
  end
end

function draw_title()
  camera(64, 127 - 62, 2, 3)
  local def = DOGS[ORDER[game.sel]]
  rectfill(0, 6, SW - 1, 24, C.navy)
  bold_centre("HAT CHASE", 9, C.gold)
  centre("Adventures on Puppy Coast", 17, C.paper)
  rectfill(0, 166, SW - 1, 209, C.paper)
  rect(0, 166, SW - 1, 209, C.dim)
  bold_centre("< " .. def.name .. " >", 170, C.red)
  centre(def.blurb, 180, C.ink)
  centre(keys(def.power), 189, C.blue)
  centre(keys("Left/right: pick a dog     {A}: play!"), 199, C.dim)
  draw_popups()
end

-- ----------------------------------------------------------------- in play

function draw_popups()
  for _, p in ipairs(popups) do
    local sx, sy = project(p.x, p.y, p.z)
    sx, sy = sx / 2, sy / 2 -- keep the existing logical layout; print() scales the coordinates below.
    local s = p.text
    local w = textw(s)
    local x = min(SW - w - 2, max(1, floor(sx - w / 2)))
    local y = min(SH - 8, max(1, floor(sy - p.age * 16)))
    if p.big then
      print(s, x, y, C.gold) print(s, x + 0.5, y, C.gold)
    else
      shadow(s, x, y, C.white)
    end
  end
end

--- Top bar: the dog, the round, the hat (one mark per catch needed), the shells. Bottom: the controls.
function draw_hud()
  local def, R = DOGS[dog.id], ROUNDS[game.round]
  rectfill(0, 0, SW - 1, 11, C.navy)
  print(def.name, 4, 3, C.gold)
  local rt = "Round " .. game.round .. " of 3"
  print(rt, 4 + textw(def.name) + 10, 3, C.paper)
  -- The hat: filled dots for catches so far, open ones for the rest.
  local hx = 160
  spr2d(4, hx, 2)
  for i = 1, R.catches do
    local cx = hx + 14 + (i - 1) * 9
    if i <= game.catches then circfill(cx, 6, 3, C.red) else circfill(cx, 6, 3, C.dim) circfill(cx, 6, 1, C.navy) end
  end
  local n = tostring(game.shells)
  spr2d(1, SW - 16 - textw(n), 2)
  print(n, SW - 5 - textw(n), 3, C.paper)
  local help = keys("Arrows: run   {A}: " .. ({ zoom = "Zoom!", leap = "Leap!", carry = "Carry me!" })[def.special] .. "   {B}: sniff   M: sound")
  print(help, floor((SW - textw(help)) / 2), SH - 8, C.ink)
end

--- The round's title and line, wrapped to fit, on a paper card.
function draw_banner(R)
  local lines = wrap(keys(R.sub), 60)
  local h = 22 + #lines * 9
  local y0 = 60
  rectfill(56, y0, SW - 57, y0 + h, C.paper)
  rect(56, y0, SW - 57, y0 + h, C.ink)
  rect(58, y0 + 2, SW - 59, y0 + h - 2, C.gold)
  bold_centre(R.title, y0 + 7, C.red)
  for i, l in ipairs(lines) do centre(l, y0 + 9 + i * 9, C.ink) end
end

-- ----------------------------------------------------------------- the end

function update_end()
  if btnp(4) then start_game()
  elseif btnp(5) then show_title() end
end

function draw_end()
  local def = DOGS[dog.id]
  local stars = end_stars()
  local secs = floor(game.time + 0.5)
  local x0, y0, x1, y1 = 92, 34, SW - 93, 170
  rectfill(x0, y0, x1, y1, C.paper)
  rect(x0, y0, x1, y1, C.ink)
  rect(x0 + 2, y0 + 2, x1 - 2, y1 - 2, C.gold)
  bold_centre("Hooray!", y0 + 8, C.red)
  -- Stars for speed: earned ones big and gold, the rest as small grey dots.
  local sx = floor(SW / 2 - 3 * 28 / 2)
  for i = 1, 3 do
    local x = sx + (i - 1) * 28
    if i <= stars then spr2d(0, x + 2, y0 + 22, 3) else circfill(x + 13, y0 + 33, 4, C.dim) end
  end
  centre(def.name .. " caught the red hat!", y0 + 56, C.ink)
  centre("Shells found: " .. game.shells .. " / " .. TOTAL_SHELLS, y0 + 68, C.ink)
  centre(string.format("Time: %d:%02d", secs // 60, secs % 60), y0 + 80, C.ink)
  centre(keys("{A}: play again"), y0 + 100, C.blue)
  centre("B: choose a dog", y0 + 110, C.dim)
end
